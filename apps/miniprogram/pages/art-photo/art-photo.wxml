<page-meta page-style="{{themeStyle}}"></page-meta>
<wxs module="img" src="../../wxs/img.wxs"></wxs>
<view class="{{skinClass}} page page-tabbar art-brand layout-matrix art-photo-page {{segment === 'pet' ? 'art-photo-page-bundle' : ''}}">
  <!-- 分段吸顶：往下滑时仍可切换；外层垫页面底色，内容滑过时不透出来 -->
  <view class="create-segments-bar">
    <view class="create-segments" aria-role="tablist">
      <view wx:for="{{segments}}" wx:key="id" class="create-segment {{segment === item.id ? 'create-segment-on' : ''}}" data-id="{{item.id}}" aria-role="tab" aria-selected="{{segment === item.id}}" bindtap="chooseSegment">{{item.label}}</view>
    </view>
  </view>

  <t-skeleton wx:if="{{loading}}" type="grid" count="4"></t-skeleton>
  <t-notice wx:elif="{{error}}" type="error" message="{{error}}"></t-notice>

  <!-- 人宠写真：主人 + 宠物同框，按组展示，点镜头直达制作页 -->
  <block wx:elif="{{segment === 'duo'}}">
    <view class="art-heading">
      <view class="title">和我同框，拍一组合影</view>
      <text class="muted">你一张、宝宝一张，拍成同框的棚拍写真。{{duoGroups.length}} 组场景，每组两个镜头。</text>
      <text wx:if="{{duoPriceText}}" class="small art-heading-price">{{duoPriceText}}</text>
    </view>
    <view wx:for="{{duoGroups}}" wx:for-item="group" wx:key="id" class="art-collection duo-group">
      <view class="art-section-head">
        <view class="section-title">{{group.title}}</view>
        <text class="small">{{group.description}}</text>
      </view>
      <view class="art-grid">
        <view wx:for="{{group.shots}}" wx:key="templateId" class="art-item duo-shot" data-id="{{item.templateId}}" aria-role="button" aria-label="人宠写真{{group.title}} · {{item.title}}" hover-class="chip-hover" bindtap="openDuoTemplate">
          <view class="art-image-wrap">
            <image wx:if="{{item.sampleUrl}}" class="duo-image img-load" src="{{item.hdUrl || item.sampleUrl}}" mode="aspectFill" webp data-id="{{item.templateId}}" binderror="onDuoImageError" lazy-load bindload="{{img.ready}}" />
            <view wx:else class="duo-image art-image-empty">样片暂不可用</view>
            <text class="duo-badge">主人 + 宠物</text>
          </view>
          <view class="art-name">{{item.title}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 宠物写真：单张点图直达；10 / 20 张一组从空白开始挑，按点选顺序编号 -->
  <block wx:elif="{{segment === 'pet'}}">
    <view class="art-heading">
      <view class="title">{{sceneCount}} 套布景，换我来当主角</view>
      <text class="muted">传一张宝宝的清楚照片，挑一个布景就能出片。衣服、道具和灯光都替你搭好了。</text>
      <!-- 和线下影棚比：不用等、不折腾、花得少（2026-10-10） -->
      <!-- 2026-10-26：三张小卡改成三行勾选式卖点，一眼扫完 -->
      <view class="art-perks">
        <view class="art-perk"><text class="art-perk-mark">✓</text><text class="art-perk-title">不用约档期</text><text class="art-perk-note">现在挑好，一分钟左右出片</text></view>
        <view class="art-perk"><text class="art-perk-mark">✓</text><text class="art-perk-title">不用哄我配合</text><text class="art-perk-note">随手拍的一张就够用</text></view>
        <view class="art-perk"><text class="art-perk-mark">✓</text><text class="art-perk-title">换装不加钱</text><text class="art-perk-note">一套 {{packages.single.price}}，一组更省</text></view>
      </view>
    </view>
    <view class="art-package-head"><text class="art-package-head-title">选一个套餐</text><text class="small">点一下切换</text></view>
    <view class="art-package-options" aria-role="radiogroup">
      <view wx:for="{{['single', 'ten', 'twenty']}}" wx:key="*this" class="art-package {{packageMode === item ? 'art-package-on' : ''}}" data-mode="{{item}}" aria-role="radio" aria-checked="{{packageMode === item}}" bindtap="choosePackage">
        <text wx:if="{{packages[item].recommended}}" class="art-package-badge">最多人选</text>
        <text class="art-package-radio">{{packageMode === item ? '✓' : ''}}</text>
        <text class="art-package-label">{{packages[item].label}}</text>
        <text class="art-package-price">{{packages[item].price || '—'}}</text>
        <text class="small">{{packages[item].unit}}</text>
      </view>
    </view>
    <view wx:if="{{packageMode !== 'single'}}" class="art-pick-bar">
      <text class="small art-pick-tip">{{selectedCount ? '再点一下可以取下' : '点图挑出想拍的 ' + packageTotal + ' 套'}}</text>
      <text wx:if="{{selectedCount}}" class="small art-pick-action" aria-role="button" bindtap="clearSelection">清空</text>
      <text wx:if="{{selectedCount < packageTotal}}" class="small strong art-pick-action" aria-role="button" bindtap="fillSelection">{{selectedCount ? '剩下的帮我挑' : '帮我挑满'}}</text>
    </view>
    <view wx:for="{{collections}}" wx:for-item="group" wx:key="id" class="art-collection">
      <view class="art-section-head">
        <view class="section-title">{{group.title}}</view>
        <text class="small">{{group.subtitle}}</text>
      </view>
      <view class="art-grid">
        <view wx:for="{{group.scenes}}" wx:for-item="scene" wx:key="id" class="art-item {{scene.selected ? 'art-item-selected' : ''}}" data-id="{{scene.id}}" aria-role="{{packageMode === 'single' ? 'button' : 'checkbox'}}" aria-checked="{{scene.selected}}" aria-label="{{scene.title}}写真{{scene.selected ? '，第 ' + scene.order + ' 张' : ''}}" bindtap="chooseScene">
          <view class="art-image-wrap"><image wx:if="{{scene.url}}" class="art-image img-load" src="{{scene.url}}" mode="aspectFit" data-id="{{scene.id}}" binderror="onSceneImageError" lazy-load bindload="{{img.ready}}" /><view wx:else class="art-image art-image-empty">样片暂不可用</view><text wx:if="{{packageMode !== 'single'}}" class="art-selection {{scene.selected ? 'art-selection-on' : ''}}">{{scene.selected ? scene.order : '＋'}}</text></view>
          <view class="art-name">{{scene.title}}</view>
          <text class="small art-description">{{scene.description}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 如果我是人：40 款造型，按标签筛选，点哪张直达哪张 -->
  <block wx:elif="{{segment === 'human'}}">
    <view class="art-heading">
      <view class="title">如果我是人</view>
      <text class="muted">传一张宝宝的正脸照，看看变成人是什么样子。{{humanTemplates.length}} 款造型，挑喜欢的就行。</text>
      <text wx:if="{{humanPriceText}}" class="small art-heading-price">{{humanPriceText}} · 用一张我的正脸照</text>
    </view>
    <scroll-view class="human-tags chip-scroll" scroll-x show-scrollbar="{{false}}"><view class="chip-track">
      <view class="chip {{!humanTag ? 'chip-on' : ''}}" data-tag="" bindtap="chooseHumanTag">全部 {{humanTemplates.length}}</view>
      <view wx:for="{{humanTags}}" wx:key="*this" class="chip {{humanTag === item ? 'chip-on' : ''}}" data-tag="{{item}}" bindtap="chooseHumanTag">{{item}}</view>
    </view></scroll-view>
    <view class="human-grid">
      <view wx:for="{{humanVisible}}" wx:key="templateId" class="human-pick" data-id="{{item.templateId}}" aria-role="button" aria-label="{{item.title}}" hover-class="chip-hover" bindtap="openHumanTemplate">
        <image wx:if="{{item.sampleUrl}}" class="human-card-image img-load" src="{{item.sampleUrl}}" mode="aspectFill" webp data-id="{{item.templateId}}" binderror="onHumanImageError" lazy-load bindload="{{img.ready}}" />
        <view wx:else class="human-card-image art-image-empty">样图暂不可用</view>
        <view class="art-name">{{item.title}}</view>
      </view>
    </view>
  </block>

  <!-- 其他玩法：分类 + 图文 / 短片 / 趣测 -->
  <block wx:else>
    <view class="art-heading"><view class="title">其他玩法</view><text class="muted">身份证、电影海报、成长画册、回忆短片……把攒下的照片做成能留着的东西。</text></view>
    <scroll-view class="human-tags chip-scroll" scroll-x show-scrollbar="{{false}}"><view class="chip-track">
      <view wx:for="{{playChips}}" wx:key="id" class="chip {{playChip === item.id ? 'chip-on' : ''}}" data-id="{{item.id}}" aria-role="tab" aria-selected="{{playChip === item.id}}" hover-class="chip-hover" bindtap="choosePlayChip">{{item.label}}</view>
    </view></scroll-view>
    <view class="play-grid">
      <view wx:for="{{visibleCategories}}" wx:key="id" class="play-card" data-id="{{item.id}}" data-template="{{item.templateId}}" aria-role="button" hover-class="chip-hover" bindtap="openCategory">
        <image wx:if="{{item.cover}}" class="play-card-image play-shape-tall img-load" src="{{item.cover}}" mode="aspectFill" lazy-load bindload="{{img.ready}}" />
        <view class="art-name">{{item.title}}</view>
        <text wx:if="{{item.description}}" class="small play-card-desc">{{item.description}}</text>
        <text class="small">{{item.count}} 款</text>
      </view>
      <view wx:for="{{visiblePlays}}" wx:key="id" class="play-card" data-id="{{item.id}}" data-category="{{item.category}}" aria-role="button" hover-class="chip-hover" bindtap="openPlay">
        <image wx:if="{{item.cover}}" class="play-card-image play-shape-wide img-load" src="{{item.cover}}" mode="aspectFill" lazy-load bindload="{{img.ready}}" />
        <view class="art-name">{{item.name}}</view>
        <text wx:if="{{item.tagline}}" class="small play-card-desc">{{item.tagline}}</text>
        <text class="small">{{item.priceText}}</text>
      </view>
      <view wx:if="{{playChip === 'all'}}" class="play-card play-card-fun" aria-role="button" hover-class="chip-hover" bindtap="openFunTests">
        <image class="play-card-image play-shape-square" src="/assets/fun-tests/personality.jpg" mode="aspectFill" lazy-load />
        <view class="art-name">宠物趣味测试</view>
        <text class="small">免费 · 4 份测试</text>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{segment === 'pet' && !loading && !error}}" class="{{skinClass}} art-bundle-dock">
  <view class="dock-meta"><text class="dock-count">{{dockText}}</text><text wx:if="{{dockSub}}" class="small">{{dockSub}}</text></view>
  <t-button wx:if="{{packageMode !== 'single'}}" type="primary" anim="{{animType}}" bindtap="startBundle">下一步</t-button>
</view>
