.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

/* 横向滑动选择器：选项多时不挤压文字，也不占纵向空间 */
.chooser {
  display: flex;
  width: 100%;
  height: 88rpx;
  border-bottom: 2rpx solid var(--divider-soft);
  white-space: nowrap;
}

.chooser .option {
  width: auto;
  min-height: 88rpx;
  box-sizing: border-box;
  flex-direction: row;
  align-items: center;
  padding: 0 var(--space-4);
  border: 0;
  border-bottom: 4rpx solid transparent;
  border-radius: 0;
  background: transparent;
}

.chooser .option + .option {
  margin-left: 0;
}

.chooser .option .small {
  display: none;
}

.chooser .option-on {
  border-bottom-color: var(--primary);
}

.chooser .option-on .option-name {
  color: var(--primary);
}

.option {
  display: inline-flex;
  width: 260rpx;
  box-sizing: border-box;
  flex-direction: column;
  flex-shrink: 0;
  gap: var(--space-1);
  padding: var(--space-4);
  border: 2rpx solid transparent;
  border-radius: var(--card-radius);
  background: var(--surface);
  transition: border-color var(--transition-duration) var(--transition-easing), transform var(--transition-duration) var(--transition-easing);
}

.option + .option {
  margin-left: var(--space-3);
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.solo-template-image {
  display: block;
  width: 100%;
  height: 1160rpx;
  aspect-ratio: var(--ratio-portrait);
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.scene-grid .scene-option {
  width: 100%;
}

.template-option {
  width: 100%;
  min-width: 0;
  padding: 0;
  border-color: transparent;
  border-radius: var(--radius-image-thumb);
  background: transparent;
  white-space: normal;
}

.template-option + .template-option {
  margin-left: 0;
}

.option-hover {
  transform: scale(.97);
}

.option-on {
  border-color: var(--primary);
  background: var(--card-background);
}

.template-option.option-on {
  border-color: transparent;
  background: transparent;
}

.template-option.option-on .style-thumb {
  box-shadow: 0 0 0 4rpx var(--primary);
}

.option-name {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: 700;
  white-space: normal;
}

/*
 * 宠物艺术写真场景缩略图：每个卡片必须展示真实场景，
 * 让用户比较动作和表情，不用抽象色块代替成品。
 *
 * 比例锁 3:4 与作品网格同档，图片内容由 sceneUrls 提供。
 */
.style-thumb {
  display: block;
  width: 100%;
  height: 588rpx;
  aspect-ratio: var(--ratio-portrait);
  margin-bottom: var(--space-2);
  border-radius: var(--radius-image-thumb);
  background: var(--skeleton-base);
}
.scene-thumb { height: 440rpx; aspect-ratio: var(--ratio-card); }
.template-wide { grid-column: span 2; }
.style-wide { height: 420rpx; aspect-ratio: var(--ratio-hero); }
.solo-wide { height: 420rpx; aspect-ratio: var(--ratio-hero); }
.ai-flow { padding-bottom: calc(var(--page-bottom-safe) + var(--space-8) + env(safe-area-inset-bottom)); }
.selected-effect { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-5); padding: var(--space-3); border-radius: var(--radius-image-thumb); background: var(--surface); }
.selected-effect-image { flex: none; width: 100rpx; height: 132rpx; border-radius: var(--radius-image-thumb); background: var(--skeleton-base); }
.selected-effect-copy { display: grid; gap: var(--space-1); min-width: 0; flex: 1; }
.selected-effect-copy .sub-title { margin: 0; }
.change-effect { flex: none; color: var(--primary); font-size: var(--small-size); font-weight: var(--fw-bold); }
.effect-chooser-section { margin-top: var(--space-4); }
.effect-chooser-section .section-title { display: flex; align-items: baseline; gap: var(--space-2); }
.effect-track { width: 100%; margin-top: var(--space-3); white-space: nowrap; }
.effect-card { display: inline-block; width: 274rpx; margin-right: var(--space-3); vertical-align: top; white-space: normal; }
.effect-image-wrap { position: relative; overflow: hidden; border: 4rpx solid transparent; border-radius: var(--radius-image-thumb); background: var(--surface); }
.effect-card-on .effect-image-wrap { border-color: var(--primary); }
.effect-card-image { display: block; box-sizing: border-box; width: 100%; height: 358rpx; }
.effect-selected { position: absolute; right: var(--space-1); bottom: var(--space-1); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--button-primary); color: var(--button-primary-text); font-size: var(--eyebrow-size); font-weight: var(--fw-bold); }
.effect-card-title { overflow: hidden; padding-top: var(--space-2); color: var(--text-primary); font-size: var(--small-size); font-weight: var(--fw-bold); text-overflow: ellipsis; white-space: nowrap; }
.ai-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; padding: var(--space-3) var(--page-padding) calc(var(--space-3) + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--divider-soft); background: var(--background); }

.style-thumb-blank {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: var(--space-3);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

