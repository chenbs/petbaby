/* ---------- skin:end ---------- */

/* ---------- 皮肤层公共规则（2026-09）----------
 * 结构差异只写在这里和各页的 .skin-<id> 选择器里；颜色仍一律走 token。
 * 纪念场景（skin-quiet）统一关掉倾斜、底纹、装饰与按压位移，保证在四套主题下都安静。
 */
.skin-quiet {
  --skin-texture: none;
  --skin-tilt: 0deg;
  --skin-sticker-tilt: 0deg;
  --skin-press: none;
  --skin-press-shadow: none;
  --skin-clip: none;
  --skin-btn-clip: none;
}

.page {
  background-image: var(--skin-texture, none);
  background-size: var(--skin-texture-size, auto);
}

.title,
.section-title,
.sub-title,
.pet-name,
.human-card-title {
  font-family: var(--skin-title-font, inherit);
}

/* 区块标题前的皮肤标记：橘子汽水圆点 / 手账胶带 / 赛博荧光竖条 / 影院金线 */
.section-title::before {
  display: inline-block;
  width: var(--skin-mark-w, 0);
  height: var(--skin-mark-h, 0);
  margin-right: var(--space-2);
  border-radius: var(--skin-mark-radius, 0);
  background: var(--skin-mark, transparent);
  vertical-align: middle;
  content: "";
}

/* themes.html 3.2：手账是压在字底的一段斜胶带，影院是字后一条发光金线（其余两套沿用字前标记） */
.skin-film .section-title {
  display: table;
  position: relative;
  z-index: 0;
  align-self: flex-start;
  justify-self: start;
}

.skin-film .section-title::before {
  position: absolute;
  right: calc(0rpx - var(--space-3));
  bottom: 0;
  left: calc(0rpx - var(--space-1));
  z-index: -1;
  width: auto;
  height: var(--skin-mark-h, 0);
  margin-right: 0;
  transform: rotate(-1.5deg);
}

.skin-night .section-title::before {
  display: none;
}

.skin-night .section-title::after {
  display: inline-block;
  width: 52rpx;
  height: var(--skin-mark-h, 0);
  margin-left: var(--space-2);
  border-radius: var(--skin-mark-radius, 0);
  background: var(--skin-mark, transparent);
  box-shadow: 0 0 16rpx var(--skin-mark, transparent);
  vertical-align: middle;
  content: "";
}

.skin-quiet .section-title::before,
.skin-quiet .section-title::after {
  display: none;
}

/* 数字气质：赛博用等宽，手账用衬线，其余继承 */
.pet-days,
.dock-count,
.progress-title {
  font-family: var(--skin-num-font, inherit);
}

/* 主要容器的切角（只有赛博街机开） */
.pet-card,
.human-card,
.boss-lead,
.progress-card,
.pet-moment {
  clip-path: var(--skin-clip, none);
}

/* 贴纸式标签的倾斜 */
.art-package-badge,
.human-card-go {
  transform: rotate(var(--skin-sticker-tilt, 0deg));
}

.art-package-badge {
  transform: translateX(-50%) rotate(var(--skin-sticker-tilt, 0deg));
}

/* ---------- 手账相册：拍立得白边 + 轻微倾斜 ---------- */
.skin-film .feed-image,
.skin-film .boss-thumb,
.skin-film .human-card-thumb-image,
.skin-film .art-image,
.skin-film .play-card-image,
.skin-film .human-card-image {
  box-sizing: border-box;
  border: 10rpx solid var(--card-background);
  border-bottom-width: 30rpx;
  box-shadow: var(--shadow-image);
}

.skin-film .feed-col:first-child .feed-item:nth-child(odd) .feed-image,
.skin-film .boss-item:nth-child(odd) .boss-thumb,
.skin-film .human-card-cover-0 {
  transform: rotate(var(--skin-tilt, 0deg));
}

.skin-film .human-card-cover-2 {
  transform: rotate(calc(0deg - var(--skin-tilt, 0deg)));
}

.skin-film .pet-card,
.skin-film .human-card {
  border: var(--card-border);
}

.skin-film .pet-moment {
  border-top: 2rpx dashed var(--border);
  border-radius: 0;
  background: transparent;
}

.skin-film .human-card {
  background: var(--card-background);
}

/* ---------- 赛博街机：线框、左侧荧光竖条、直角 ---------- */
.skin-brand .pet-card,
.skin-brand .human-card,
.skin-brand .boss-lead,
.skin-brand .progress-card {
  border: 2rpx solid var(--border);
  border-left: 6rpx solid var(--primary);
}

.skin-brand .feed-image,
.skin-brand .boss-thumb,
.skin-brand .art-image,
.skin-brand .human-card-image,
.skin-brand .human-card-thumb-image,
.skin-brand .play-card-image {
  border: 2rpx solid var(--border);
}

.skin-brand .feed-title,
.skin-brand .boss-name {
  padding-left: var(--space-2);
  border-left: 4rpx solid var(--primary);
}

.skin-brand .human-card-cover {
  border-color: var(--border);
}

/* ---------- 星夜影院：海报式压图标题、金色细框 ---------- */
.skin-night .human-card {
  border: 2rpx solid var(--border);
  background: var(--card-background);
}

.skin-night .human-card-cover {
  border-color: var(--border);
}

.skin-night .boss-lead {
  border: 2rpx solid var(--border);
}

.skin-night .pet-days {
  color: var(--primary);
}
