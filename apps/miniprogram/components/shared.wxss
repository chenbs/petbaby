/**
 * 组件内共享文本类。
 *
 * 组件默认 styleIsolation 为 isolated，app.wxss 不会下渗到组件内部，
 * 因此需要文本层级类的组件用 `@import "../shared.wxss";` 引入本文件。
 * 这里只做变量到语义类的映射，与 app.wxss 保持同名同义，仍然零硬编码。
 */
.muted {
  color: var(--text-secondary);
  font-size: var(--body-size);
  line-height: 1.7;
}

.small {
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 1.6;
}

.strong {
  color: var(--text-primary);
  font-weight: var(--fw-bold);
}

.center {
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.eyebrow {
  display: block;
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
  font-weight: var(--fw-bold);
  letter-spacing: var(--eyebrow-tracking);
}

.sub-title {
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: var(--fw-bold);
}

.hit-area {
  min-width: 88rpx;
  min-height: 88rpx;
}

/*
 * ---------- 图片加载态（2026-10-26） ----------
 * 未加载完：骨架底色 + 呼吸；加载完（wxs/img.wxs 加 .img-on）短暂淡入。
 * 不用 :not()：WXSS 不保证支持。页面自己给图片定了 background 的，页面样式在后、同优先级会盖掉这里的底色，
 * 加载中只呼吸不换色；没定的，加载后由 .img-on 撤掉底色，aspectFit 留白保持透明。
 * widthFix 的图加载前高度为 0，另加 .img-load-fix 给一个占位高度。
 */
.img-load {
  background-color: var(--skeleton-base);
  animation: img-breathe 1.4s ease-in-out infinite;
}

.img-load-fix {
  min-height: 360rpx;
}

.img-on {
  background-color: transparent;
  animation: img-in .32s ease-out;
}

.img-load-fix.img-on {
  min-height: 0;
}

@keyframes img-breathe {
  0%, 100% { opacity: 1; }
  50% { opacity: .55; }
}

@keyframes img-in {
  from { opacity: .3; }
  to { opacity: 1; }
}
