<page-meta page-style="{{themeStyle}}"></page-meta>

<!--
  方案 C 的第二用法（表单变体）：背景虚化成目标产出图，表单浮在半透明卡片里。
  用户填资料时始终看得见「我要做出来的东西」，方案称这对多步表单完成率有直接影响。

  复用 t-glass-sheet 而非另写一套：背景图 + 半透明面板 + backdrop-filter 不可用时
  退回 0.94 不透明底，这三件事它都已实现且被 ai-run 用在线上。
  gesture-disabled 关掉拖拽档位 —— 表单里有 picker 与输入框，
  面板跟手移动会和这些控件抢手势；关掉后 WXS 侧直接短路，触摸原样透传给控件。
  高度用 default-height 而不是 state="expanded"：组件在 gestureDisabled 时会把档位
  强制回 half（见组件 index.js），只有把 half 本身设高才拿得到满屏表单。
-->
<t-glass-sheet
  wx:if="{{formStage}}"
  background-image="{{plugin.samples.heroUrl}}"
  title="{{plugin ? plugin.name : '准备玩法'}}"
  state="half"
  default-height="{{88}}"
  expanded-height="{{88}}"
  gesture-disabled
  blur="{{blurOk}}"
  anim="{{animType}}"
>
  <view slot="header">
    <text class="glass-eyebrow">CREATE · STEP {{stepIndex + 1}} / {{steps.length}}</text>
    <view class="glass-title">{{plugin ? plugin.name : '准备玩法'}}</view>
    <t-steps steps="{{steps}}" current="{{stepIndex}}" class="block-gap"></t-steps>
  </view>

  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>

  <!-- 步骤一：宠物档案 -->
  <view wx:if="{{stage === 'profile'}}" class="section-block">
    <view class="glass-sub-title">先认识一下它</view>

    <t-card blur="{{blurOk}}" anim="{{animType}}">
      <block wx:if="{{pets.length}}">
        <picker range="{{pets}}" range-key="name" bindchange="choosePet">
          <t-field label="选择已有档案" control="select" value="{{petText}}" placeholder="从已建档的宠物里挑一个"></t-field>
        </picker>
        <view class="divider-row"><text class="small">或者新建一个</text></view>
      </block>

      <view class="stack">
        <t-field label="名字" value="{{name}}" placeholder="它叫什么" maxlength="20" required bindchange="setName"></t-field>
        <picker range="{{speciesLabels}}" bindchange="setSpecies">
          <t-field label="种类" control="select" value="{{speciesText}}"></t-field>
        </picker>
        <picker range="{{genderLabels}}" bindchange="setGender">
          <t-field label="性别" control="select" value="{{genderText}}"></t-field>
        </picker>
        <picker range="{{dateTypeLabels}}" bindchange="setDateType">
          <t-field label="日期类型" control="select" value="{{dateTypeText}}"></t-field>
        </picker>
        <picker mode="date" value="{{birthday}}" bindchange="setBirthday">
          <t-field label="{{dateTypeText}}" control="select" value="{{birthday}}" placeholder="选填" help="用于计算年龄与成长时间线"></t-field>
        </picker>
      </view>
    </t-card>

  </view>

  <!-- 步骤二：选照片 + 玩法参数 -->
  <block wx:elif="{{stage === 'photos'}}">
    <view class="section-block">
      <view class="row">
        <view class="glass-sub-title flush">挑几张它的照片</view>
        <text class="glass-small {{selectedTileIds.length >= plugin.input.photos.max ? 'warn' : ''}}">{{photoHint}}</text>
      </view>

      <t-empty
        wx:if="{{!photoTiles.length}}"
        icon="photo"
        title="还没有照片"
        description="从相册选几张，或者现在拍一张。"
        action-text="选择照片"
        anim="{{animType}}"
        decor="{{decor}}"
        bindaction="choosePhotos"
      ></t-empty>

      <t-photo-grid
        wx:else
        photos="{{photoTiles}}"
        selected-ids="{{selectedTileIds}}"
        max="{{plugin.input.photos.max}}"
        addable
        anim="{{animType}}"
        bindadd="choosePhotos"
        bindtoggle="toggleTile"
      ></t-photo-grid>
    </view>

    <view class="section-block">
      <view class="glass-sub-title">调一下风格</view>
      <t-card blur="{{blurOk}}" anim="{{animType}}">
        <view class="stack">
          <picker wx:if="{{pluginId === 'pet-id-card'}}" range="{{documentLabels}}" bindchange="setDocumentType">
            <t-field label="证件类型" control="select" value="{{documentText}}"></t-field>
          </picker>

          <block wx:if="{{pluginId === 'pet-movie-poster'}}">
            <picker range="{{styleLabels}}" bindchange="setStyle">
              <t-field label="海报风格" control="select" value="{{styleText}}"></t-field>
            </picker>
            <picker range="{{compositionLabels}}" bindchange="setComposition">
              <t-field label="构图" control="select" value="{{compositionText}}"></t-field>
            </picker>
            <t-field label="影评短评" control="textarea" value="{{review}}" placeholder="给它写一句影评，可留空" maxlength="60" show-count bindchange="setReview"></t-field>
          </block>

          <block wx:if="{{pluginId === 'pet-time-album'}}">
            <picker range="{{themeLabels}}" bindchange="setTheme">
              <t-field label="画册主题" control="select" value="{{themeText}}"></t-field>
            </picker>
            <t-field label="封面标题" value="{{coverTitle}}" placeholder="例如「小鱼的第一年」" maxlength="24" show-count bindchange="setCoverTitle"></t-field>
          </block>
        </view>
      </t-card>

    </view>

    <!--
      解锁价与档位（改造项 L3）：**制作前**就要看得见。
      免费玩法整块不出现（pricingText 为空），给一个 ¥0 的价格区块只是噪声。
    -->
    <view wx:if="{{pricingText}}" class="section-block">
      <view class="glass-sub-title">做好之后</view>
      <t-card blur="{{blurOk}}" anim="{{animType}}">
        <view class="glass-title">{{pricingText}}</view>
        <text wx:if="{{pricingHint}}" class="glass-small">{{pricingHint}}</text>
      </t-card>
    </view>
  </block>

  <!-- 主 CTA 常驻底部（方案 C 的结构：细线步骤在顶，卡片浮中，CTA 钉底） -->
  <view slot="actions">
    <t-button
      wx:if="{{stage === 'profile'}}"
      type="primary"
      block
      anim="{{animType}}"
      loading="{{busy}}"
      bindtap="savePet"
    >保存档案，下一步</t-button>
    <t-button
      wx:else
      type="ai"
      block
      anim="{{animType}}"
      loading="{{busy}}"
      bindtap="generate"
    >免费生成预览</t-button>
  </view>
</t-glass-sheet>

<view wx:else class="page page-flat">
  <text class="eyebrow">CREATE</text>
  <view class="title">{{plugin ? plugin.name : '准备玩法'}}</view>

  <t-steps steps="{{steps}}" current="{{stepIndex}}" class="block-gap"></t-steps>

  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>

  <!-- 步骤三：生成中。上传与生成是两段独立进度，分别展示 -->
  <view wx:elif="{{stage === 'generating'}}" class="section">
    <t-card blur="{{blurOk}}" anim="{{animType}}">
      <view class="stage-progress">{{task.progress || 0}}%</view>
      <t-loading anim="{{animType}}" label="正在生成 {{plugin.name}}" progress="{{task.progress || 0}}"></t-loading>
      <text class="muted center block">排队第 {{task.queuePosition || 1}} 位，预计 {{task.estimatedSeconds || 15}} 秒</text>
      <view wx:if="{{uploadProgress > 0 && uploadProgress < 100}}" class="upload-line">
        <t-progress percent="{{uploadProgress}}" label="照片上传" show-value></t-progress>
      </view>
    </t-card>
  </view>

  <!--
    步骤四：完成，作品占主视觉。
    结果卡走 clay 变体（方案 J「只抽取质感层」的指定落点之一）：
    这是静态单卡区域，可以用完整四层阴影，不受列表掉帧约束。
  -->
  <view wx:else class="section">
    <t-card variant="clay" padded="{{false}}" blur="{{false}}" anim="{{animType}}">
      <view class="result-frame">
        <image class="result-image" src="{{work.outputUrl}}" mode="widthFix" />
      </view>
    </t-card>
    <view class="result-copy">
      <view class="section-title flush center">{{work.title}}</view>
      <text class="muted center block">{{work.subtitle}}</text>
    </view>
    <t-button type="primary" block anim="{{animType}}" class="block-gap" bindtap="openWork">查看、下载与分享</t-button>
    <t-button type="ghost" block anim="{{animType}}" class="block-gap" bindtap="backToPhotos">再做一个</t-button>
  </view>
</view>
