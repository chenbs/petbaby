<view class="tabbar tabbar-{{themeId}}" style="{{themeStyle}}">
  <view
    wx:for="{{items}}"
    wx:key="key"
    class="item item-{{item.key}} anim-{{animType}} {{selected === item.tab ? 'active' : ''}}"
    data-index="{{index}}"
    aria-role="{{item.action ? 'button' : 'tab'}}"
    aria-selected="{{selected === item.tab}}"
    aria-label="{{item.action ? '记录：照片、日常或健康' : item.text}}"
    hover-class="item-hover"
    bindtap="switchTab"
  >
    <view class="item-icon-wrap">
      <image class="item-icon" src="/assets/icons/{{themeId}}/{{item.key}}{{item.action ? '' : selected === item.tab ? '-on' : ''}}.png" mode="aspectFit" />
    </view>
    <text wx:if="{{!item.action}}" class="item-text">{{item.text}}</text>
  </view>
</view>
