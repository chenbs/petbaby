.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

/* 横向滑动选择器：选项多时不挤压文字，也不占纵向空间 */
.chooser {
  display: flex;
  width: 100%;
  white-space: nowrap;
}

.option {
  display: inline-flex;
  width: 260rpx;
  box-sizing: border-box;
  flex-direction: column;
  flex-shrink: 0;
  gap: var(--space-1);
  padding: var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--card-radius);
  background: var(--surface);
  transition: border-color var(--transition-duration) var(--transition-easing), transform var(--transition-duration) var(--transition-easing);
}

.option + .option {
  margin-left: var(--space-3);
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.template-option {
  width: 100%;
  min-width: 0;
  padding: var(--space-2);
  border-radius: var(--radius-image-thumb);
  white-space: normal;
}

.template-option + .template-option {
  margin-left: 0;
}

.option-hover {
  transform: scale(.97);
}

.option-on {
  border-color: var(--primary);
  background: var(--card-background);
  box-shadow: 0 0 0 4rpx var(--ai-glow);
}

.option-name {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: 700;
  white-space: normal;
}

/*
 * 宠物艺术写真场景缩略图：每个卡片必须展示真实场景，
 * 让用户比较动作和表情，不用抽象色块代替成品。
 *
 * 比例锁 3:4 与作品网格同档，图片内容由 sceneUrls 提供。
 */
.style-thumb {
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-card);
  margin-bottom: var(--space-2);
  border-radius: var(--radius-image-thumb);
  background: var(--skeleton-base);
  box-shadow: var(--shadow-clay-inset);
}

.style-thumb-blank {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: var(--space-3);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

/*
 * `.chips / .chip / .chip-hover / .chip-on` 已于 2026-08-03 提到 app.wxss ——
 * pages/pets 的四个枚举也改用 chip（CLAUDE.md 的「已知未收口」项），
 * 第二处要用时就该共用而不是复制一份。此处不再重复声明。
 */
