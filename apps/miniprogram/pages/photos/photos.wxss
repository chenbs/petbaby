.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-top: var(--space-3);
}

.picker {
  display: grid;
  min-height: 88rpx;
  align-content: center;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}

.picker-value {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: 700;
}

/* 批量删除条：贴底悬浮，避免在长列表里找不到操作入口 */
.dock {
  position: fixed;
  right: var(--page-padding);
  bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  left: var(--page-padding);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: var(--card-border);
  border-radius: var(--radius-pill);
  background: var(--card-background);
  box-shadow: var(--card-shadow);
}

.record-panel, .record-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.record-panel {
  margin-top: var(--space-4);
  padding: var(--space-4);
  background: var(--card-background);
  border: var(--card-border);
  border-radius: var(--card-radius);
}
.record-actions, .record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.upload-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}
.upload-thumb {
  width: var(--space-7);
  height: var(--space-7);
  flex: none;
  border-radius: var(--radius-sm);
}
.upload-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.detail-photo { width: 100%; border-radius: var(--radius-md); }
.record-tag {
  padding: var(--space-2) var(--space-3);
  border: var(--card-border);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  background: var(--surface);
  font-size: var(--body-size);
}
.record-tag-selected { color: var(--button-primary-text); background: var(--button-primary); }
.end-note { display: block; margin: var(--space-4) 0 var(--space-8); }
