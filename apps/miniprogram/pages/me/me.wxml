<page-meta page-style="{{themeStyle}}"></page-meta>

<!--
  我的（2026-09 改版；2026-10 按 prototype.html after-me 对齐）：
  用户身份 → 宠物头像行 → 统计三格 → 额度信息条（贴纸色）→ 三组入口（小标题 + 白色列表卡 + 图标块）。
-->
<view class="{{skinClass}} page page-tabbar art-pet layout-pet me-page">
  <t-notice wx:if="{{error}}" type="error" message="{{error}}"></t-notice>
  <t-button wx:if="{{error}}" type="secondary" bindtap="loadAccount">重新加载账户资料</t-button>

  <t-skeleton wx:if="{{loading}}" type="card" count="2"></t-skeleton>

  <block wx:else>
    <view class="me-head">
      <image wx:if="{{hero && hero.imageUrl}}" class="me-avatar" src="{{hero.imageUrl}}" mode="aspectFill" data-src="{{hero.imageUrl}}" binderror="onHeroImageError" />
      <view wx:else class="me-avatar me-avatar-empty">{{displayName[0]}}</view>
      <view class="me-identity">
        <view class="me-name">{{displayName}}</view>
        <text class="small">{{status && status.refunds.length ? status.refunds.length + ' 笔退款处理中' : '已登录 · 照片和作品都会一直保存在这里'}}</text>
      </view>
      <view class="me-bell" aria-role="button" aria-label="通知" bindtap="openNotifications">
        <image class="me-bell-icon" src="/assets/icons/{{themeId}}/ic-bell.png" mode="aspectFit" />
        <text wx:if="{{status.notifications.length}}" class="me-bell-dot"></text>
      </view>
    </view>

    <!-- 宠物头像行：点头像看时间线，末尾「添加 / 管理」进档案页 -->
    <scroll-view class="me-pets" scroll-x show-scrollbar="{{false}}"><view class="me-pets-track">
      <view wx:for="{{pets}}" wx:key="id" class="me-pet {{item.isDefault ? 'me-pet-on' : ''}}" data-id="{{item.id}}" aria-role="button" aria-label="查看{{item.name}}的时间线" bindtap="openPet">
        <image wx:if="{{item.avatarUrl}}" class="me-pet-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="me-pet-avatar me-pet-avatar-empty">{{item.name[0]}}</view>
        <text class="me-pet-name">{{item.name}}</text>
      </view>
      <view class="me-pet" aria-role="button" aria-label="{{pets.length ? '管理宠物档案' : '添加宠物'}}" bindtap="openPets">
        <view class="me-pet-avatar me-pet-add">＋</view>
        <text class="me-pet-name">{{pets.length ? '添加' : '添加宠物'}}</text>
      </view>
    </view></scroll-view>

    <view wx:if="{{hero}}" class="me-stats" aria-role="button" bindtap="openTimeline">
      <view class="me-stat"><view class="me-stat-value">{{hero.companionDays || 0}}</view><text class="me-stat-label">{{hero.lifeStage === 'memorial' ? '陪伴了' : '陪伴天数'}}</text></view>
      <view class="me-stat"><view class="me-stat-value">{{hero.counts.photos}}</view><text class="me-stat-label">照片</text></view>
      <view class="me-stat"><view class="me-stat-value">{{hero.counts.works}}</view><text class="me-stat-label">作品</text></view>
    </view>

    <view wx:if="{{status}}" class="me-quota">
      <image class="me-quota-icon" src="/assets/icons/{{themeId}}/ic-magic.png" mode="aspectFit" />
      <view class="me-quota-copy">
        <text class="me-quota-title">今日免费玩法 · 剩 {{status.quota.remaining}} 次</text>
        <text class="me-quota-sub">每天 {{status.quota.daily}} 次免费玩法，0 点刷新</text>
      </view>
    </view>

    <view wx:if="{{status.notifications.length}}" id="me-notices" class="me-group">
      <text class="me-group-title">通知</text>
      <view class="stack-tight">
        <view wx:for="{{status.notifications}}" wx:key="id" class="notice-entry" data-id="{{item.id}}" data-path="{{item.target_path}}" aria-role="button" hover-class="entry-hover" bindtap="openNotification">
          <t-notice type="info" message="{{item.title}}：{{item.body}}"></t-notice>
        </view>
      </view>
    </view>

    <view wx:for="{{groups}}" wx:for-item="group" wx:key="title" class="me-group">
      <text class="me-group-title">{{group.title}}</text>
      <view class="me-list">
        <view wx:for="{{group.items}}" wx:key="key" class="me-row" data-key="{{item.key}}" aria-role="button" hover-class="entry-hover" bindtap="openEntry">
          <view class="me-row-icon me-row-icon-{{item.tone}}"><image class="me-row-glyph" src="/assets/icons/{{themeId}}/{{item.icon}}.png" mode="aspectFit" /></view>
          <view class="me-row-text"><text class="me-row-name">{{item.name}}</text><text wx:if="{{item.sub}}" class="me-row-sub">{{item.sub}}</text></view>
          <text wx:if="{{item.side}}" class="me-row-side">{{item.side}}</text>
          <text class="me-row-arrow">›</text>
        </view>
      </view>
    </view>
  </block>
</view>
