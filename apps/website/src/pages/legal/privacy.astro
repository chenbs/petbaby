---
import LegalLayout from "../../layouts/LegalLayout.astro";
import { LEGAL_PROCESSOR_DETAILS, LEGAL_STORAGE_REGION } from "../../config/site";

const SECTIONS = [
  {
    "heading": "适用范围及最小必要原则",
    "paragraphs": [
      "本政策说明麻麻抱我官网及小程序处理个人信息的方式。我们仅为你选择的功能、安全保障与法定义务处理必要信息。浏览官网无需提交宠物照片；使用可选功能前会说明所需信息及权限，你可以拒绝，拒绝可能使对应功能无法使用。"
    ]
  },
  {
    "heading": "账号、宠物档案与创作信息",
    "paragraphs": [
      "微信登录时，我们获取用于识别账号的微信登录标识及必要会话信息，用于登录、权限和支付安全校验，不要求提供微信密码。你主动填写的宠物名字、品种、生日、陪伴日期、生命阶段及相关记录，用于档案、时间线和作品制作。",
      "创作时处理你选择的照片、文字、模板、生成参数、候选结果、作品与任务状态。照片可能包含人物肖像或拍摄时间等元数据，我们会在支持的流程中读取拍摄时间以整理记录。上传前请检查画面中是否包含家庭地址、证件或无关人物，避免提交无关敏感信息。",
      "人宠合影等包含主人照片的功能单独收集你选择并授权的照片，用于对应创作。照片可能识别个人身份，我们不会将私有主人照片作为公开模板或样例。请勿在未取得相关人同意时上传其照片。"
    ]
  },
  {
    "heading": "订单、地址、健康记录与通知",
    "paragraphs": [
      "购买时记录商品、金额、支付渠道返回的交易标识及订单状态，用于核对支付、交付、退款与纠纷处理；支付密码及银行卡验证信息由支付渠道处理。实体商品另需收件人、联系电话与地址，仅用于履约和售后，并按必要范围提供给履约及物流服务方。",
      "健康功能处理你填写的宠物症状、体重、护理记录、历史问答及生成档案，用于分流提示、趋势和导出。请勿在自由文本中填入与宠物健康无关的本人健康、证件等敏感信息。订阅消息由你通过微信授权，按已授权模板及场景发送，你可通过微信管理授权。",
      "为排查故障与防止滥用，我们处理请求时间、任务状态、错误、必要网络及操作审计信息。客服沟通中仅处理解决问题所必需的信息，不索取密码。"
    ]
  },
  {
    "heading": "设备权限与主动分享",
    "paragraphs": [
      "选择照片时使用微信提供的照片选择能力；保存作品时，在需要时申请相册写入权限。权限由你在系统或微信设置中管理，不同意保存权限仍可使用不依赖该权限的功能。我们不因为一般浏览而读取完整相册或通讯录。",
      "创建分享链接属于你主动发起的公开或可转发行为，接收者可能查看并另行保存内容。你可以撤销分享入口；已被接收者保存的副本不能通过撤销操作自动收回。"
    ]
  },
  {
    "heading": "委托处理与第三方服务",
    "paragraphs": [
      "我们使用腾讯云 COS 保存照片和作品，存储桶采用私有读写，访问通过服务端权限控制；微信提供登录、支付和订阅消息能力。AI 创作会将完成所选任务所必需的照片及提示内容传输给接入的 AI 服务商，目前图像生成通道为 lingsuan。仅在你选择相关功能时发生对应处理。",
      "正式开放服务前，我们会在隐私保护指引及服务商清单中公示签约服务方的主体名称、处理目的、信息类型、联系方式或隐私政策链接，并完成必要合同与授权。新增用途、向独立第三方提供或处理敏感个人信息时，按法律要求另行告知并取得同意；本政策不视为对任意第三方使用的概括授权。",
      "我们不出售个人信息，不将私人照片直接用于公开宣传。模型训练等超出交付所需的用途应另行说明并取得相应授权；服务商的保存、训练及删除约束须在正式上线前核验。"
    ]
  },
  {
    "heading": "存储、安全及保留",
    "paragraphs": [
      "我们采取账号鉴权、访问隔离、HTTPS、私有对象存储、敏感字段加密和操作审计等措施。具体部署地域和服务商清单在正式开放服务时公示；如涉及向境外提供个人信息，将在实施前完成法律要求的告知、同意和其他必要程序。",
      "照片、档案和已购内容按提供服务的必要期限保留；未解锁预览可能按页面显示的期限失效，未被任务或作品引用的临时照片定期清理。删除相关记录或注销后，我们按业务关联与法定保留要求处理；备份数据随轮换清理，不能承诺所有副本瞬间删除。",
      "交易、退款及安全记录可能因履行法律义务或处理争议保留相应期限，并限制用于其他目的。发生个人信息安全事件时，我们将采取补救措施并依法告知或报告。"
    ]
  },
  {
    "heading": "查阅、更正、删除、撤回与注销",
    "paragraphs": [
      "你可以在小程序内查看或修改宠物档案、管理照片及作品、撤销分享，并在账号入口申请注销。未提供自助入口的查阅、复制、更正、删除、解释及其他权利请求，可通过客服或本页联系渠道提出。我们会核验必要身份信息，在法律规定期限内响应，并说明无法立即处理的原因。",
      "你可撤回可选权限或相关授权；撤回不影响此前基于合法授权完成的处理，也不影响不依赖该权限的功能。注销前请保存需要的作品并处理未完成订单；依法必须保留的信息将限制处理范围，并在保留原因消失后删除或匿名化。"
    ]
  },
  {
    "heading": "未成年人及政策更新",
    "paragraphs": [
      "未成年人应由监护人指导使用。涉及不满十四周岁儿童的个人信息，应取得监护人同意并遵循专门保护要求；不建议在宠物创作中上传儿童照片。监护人可通过客服或公布渠道要求处理未经适当同意收集的儿童信息。",
      "政策发生影响处理目的、方式、范围或用户权利的重要变化时，我们会通过页面或小程序提示。依法需要另行同意的，不以继续浏览代替明确同意。正式生效版本会列明运营主体、联系地址及个人信息保护联系渠道。"
    ]
  }
];

if (LEGAL_PROCESSOR_DETAILS) SECTIONS[4].paragraphs.push(LEGAL_PROCESSOR_DETAILS);
if (LEGAL_STORAGE_REGION) SECTIONS[5].paragraphs.push(`本服务的数据存储地域：${LEGAL_STORAGE_REGION}。`);
---

<LegalLayout title="隐私政策" description="麻麻抱我的隐私政策，包含服务规则、数据处理和用户权利说明。" sections={SECTIONS} />
