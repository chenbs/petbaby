<page-meta page-style="{{themeStyle}}"></page-meta>

<!--
  首页（2026-09 改版，2026-10 按 themes.html 补齐四套主题的模块呈现）：
  宠物名片（含今日一格）→ 如果我是人 → 麻麻精选 → 写真馆（宠物写真 / 人宠写真）→ 挑一个玩法。
  四套主题共用这一份 DOM；软卡 / 档案页 / 角色面板 / 电影票根这类差异全部由 .skin-<id> 的样式决定，
  装饰节点（邮戳、编号、扫描线、胶带）写在这里，由各主题决定显示与否。
-->
<view class="{{skinClass}} page page-tabbar art-film layout-pet home-page">
  <t-navbar title="麻麻抱我" brand-icon="/assets/icons/{{themeId}}/paw.png"></t-navbar>

  <!-- 1. 宠物名片 + 今日一格。无宠物时显示示例，下方玩法照常出现，不让新用户看到空首页 -->
  <t-skeleton wx:if="{{petLoading && !pet}}" type="card" count="1"></t-skeleton>
  <view wx:elif="{{recordError}}" class="section">
    <t-notice type="error" message="{{recordError}}"></t-notice>
    <t-button bindtap="loadPet">重新加载</t-button>
  </view>
  <view wx:elif="{{pet}}" class="pet-card">
    <view wx:if="{{pet.daysNumber}}" class="pet-stamp" aria-hidden="true"><text>第 {{pet.daysNumber}} 天</text><text>收好了</text></view>
    <text wx:if="{{pet.daysNumber}}" class="pet-serial" aria-hidden="true">NO.{{pet.serial}} · 在线</text>
    <view class="pet-card-top">
      <view class="pet-avatar-wrap" aria-role="button" aria-label="查看{{pet.name}}的时间线" bindtap="openTimeline">
        <image wx:if="{{petDisplayUrl}}" class="pet-avatar" src="{{petDisplayUrl}}" mode="aspectFill" data-kind="pet" data-src="{{petDisplayUrl}}" binderror="onImageError" />
        <view wx:else class="pet-avatar pet-avatar-empty">{{pet.name[0]}}</view>
      </view>
      <view class="pet-card-main">
        <picker wx:if="{{pets.length > 1}}" range="{{pets}}" range-key="name" bindchange="choosePet">
          <view class="pet-name">{{pet.name}}<text class="pet-switch">切换 ▾</text></view>
        </picker>
        <view wx:else class="pet-name">{{pet.name}}</view>
        <view class="pet-days">
          <block wx:if="{{pet.daysNumber}}">{{pet.daysPrefix}}<text class="pet-days-num">{{pet.daysNumber}}</text>天</block>
          <block wx:else>{{pet.companionText}}</block>
          <text wx:if="{{pet.photoCount}}"> · {{pet.photoCount}} 张照片</text>
        </view>
      </view>
      <view class="pet-camera" aria-role="button" aria-label="记录今天" hover-class="pet-feature-hover" bindtap="record">
        <image class="pet-camera-icon" src="/assets/icons/{{themeId}}/camera.png" mode="aspectFit" />
      </view>
    </view>
    <view wx:if="{{moment}}" class="pet-moment" aria-role="button" hover-class="pet-feature-hover" bindtap="openMoment">
      <view class="pet-moment-copy"><view class="pet-moment-title">{{moment.eyebrow}}</view><text class="pet-moment-sub">{{moment.title}}</text></view>
      <text class="pet-moment-action">{{moment.action}}</text>
    </view>
    <!--
      照顾条（2026-10）：日常记录与健康助手的首页入口。挂在名片里而不是另起一块，
      首页仍是四块；只放一句事实（到期 / 疗程 / 今天记了几条）和两个动作。已离开的宠物不出现。
    -->
    <view wx:if="{{care}}" class="pet-care">
      <view class="pet-care-copy" aria-role="button" aria-label="打开{{pet.name}}的日常记录" hover-class="pet-feature-hover" bindtap="openRecords">
        <image class="pet-care-icon" src="/assets/icons/{{themeId}}/ic-note.png" mode="aspectFit" />
        <text class="pet-care-text">{{care.text}}</text>
      </view>
      <view class="pet-care-action" aria-role="button" hover-class="pet-feature-hover" bindtap="openRecords">记一笔</view>
      <view class="pet-care-action" aria-role="button" hover-class="pet-feature-hover" bindtap="openHealth">健康助手</view>
    </view>
  </view>
  <!--
    无宠物时的建档卡（2026-10 新用户引导方案 A）：替换原名片位，主按钮一跳直达建档抽屉。
    下面的玩法照常可看，点进去会先建档、建完回到那款玩法。见面礼一行只在服务端下发可领时出现。
  -->
  <view wx:else class="pet-card onboard-card">
    <text class="eyebrow onboard-eyebrow">第一步</text>
    <view class="onboard-title">先给它建一份小档案</view>
    <text class="onboard-copy">只要名字和种类，半分钟就好。之后的写真、成长记录和陪伴天数都会挂在它名下。</text>
    <view class="onboard-steps" aria-hidden="true">
      <view class="onboard-step"><text class="onboard-step-key">名字</text><text class="onboard-step-note">必填</text></view>
      <view class="onboard-step"><text class="onboard-step-key">种类</text><text class="onboard-step-note">必选</text></view>
      <view class="onboard-step"><text class="onboard-step-key">头像</text><text class="onboard-step-note">可跳过</text></view>
    </view>
    <t-button type="primary" block anim="{{animType}}" bindtap="startOnboarding">添加我的宠物</t-button>
    <text wx:if="{{onboardGift}}" class="onboard-gift">{{onboardGift}}</text>
  </view>

  <!-- 2. 如果我是人：第一主推。点标题区进 40 款造型页，点某一张直达那一款 -->
  <view wx:if="{{humanCovers.length}}" class="human-card">
    <text wx:if="{{copy[themeId].tag}}" class="human-card-tag">{{copy[themeId].tag}}</text>
    <view class="human-card-head" aria-role="button" aria-label="打开「如果我是人」" hover-class="pet-feature-hover" bindtap="openHuman">
      <view class="human-card-heading"><text class="human-card-eyebrow">{{humanTemplateCount}} {{copy[themeId].eyebrow}}</text><view class="human-card-title">如果我是人</view></view>
      <text class="human-card-go">{{copy[themeId].go}}</text>
    </view>
    <view class="human-card-stack">
      <view class="human-card-scan" aria-hidden="true"></view>
      <view wx:for="{{humanCovers}}" wx:key="templateId" wx:if="{{index < 3}}" class="human-card-cover human-card-cover-{{index}}" data-id="{{item.templateId}}" aria-role="button" aria-label="{{item.title}}" bindtap="openHuman">
        <image wx:if="{{item.sampleUrl}}" class="human-card-image" src="{{item.sampleUrl}}" mode="aspectFill" webp data-kind="human" data-id="{{item.templateId}}" data-src="{{item.sampleUrl}}" binderror="onImageError" />
      </view>
      <view class="human-card-origin" aria-hidden="true">
        <image wx:if="{{petDisplayUrl}}" class="human-card-origin-image" src="{{petDisplayUrl}}" mode="aspectFill" />
        <text>{{pet ? pet.name + '的照片 →' : '用我的照片试试 →'}}</text>
      </view>
    </view>
    <text class="human-card-cap">上传一张我的正脸照，看看我变成人是什么样子</text>
  </view>

  <!-- 3. 麻麻精选：主卡 + 精选横滑 -->
  <view wx:if="{{bossTemplates.length}}" class="section boss-section">
    <view class="row boss-head"><view class="section-title flush">麻麻精选</view><text class="small boss-note">{{bossNote || copy[themeId].note}}</text></view>
    <view class="boss-stamp" aria-hidden="true"><text>麻麻</text><text>精选</text></view>
    <view wx:if="{{bossCoverUrl && bossLead}}" class="boss-lead" data-entry="boss" data-template="{{bossLead.templateId}}" aria-role="button" hover-class="pet-feature-hover" bindtap="startTemplate">
      <image src="{{bossCoverUrl}}" mode="aspectFill" class="boss-cover" lazy-load />
      <view class="boss-lead-copy">
        <view class="boss-lead-text"><view class="boss-lead-title">{{bossLead.title}}</view><text class="small boss-lead-sub">{{bossLead.subtitle}}</text></view>
        <text class="boss-lead-go">做同款 ›</text>
      </view>
    </view>
    <scroll-view class="boss-track" scroll-x enable-flex show-scrollbar="{{false}}">
      <view wx:for="{{bossTemplates}}" wx:key="templateId" class="boss-item" data-entry="{{item.entryId}}" data-template="{{item.templateId}}" aria-role="button" aria-label="{{item.title}}" bindtap="startTemplate">
        <view class="boss-thumb-wrap"><text class="boss-level" aria-hidden="true">{{item.level}}</text><image class="boss-thumb boss-thumb-{{item.sampleShape === 'wide' ? 'wide' : 'portrait'}}" src="{{item.sampleUrl}}" mode="aspectFill" lazy-load /></view>
        <view class="boss-name">{{item.title}}</view>
      </view>
    </scroll-view>
  </view>

  <!--
    4. 写真馆（2026-10，原「写真也值得收藏」）：两种写真并排成两张入口卡，一眼看出既有宠物写真、也有主人 + 宠物同框的人宠写真。
    下面一条横滑把两种样片混排，人宠样片带「人宠」角标；点样片直达制作页，点卡片进写真馆对应的那一栏。
    横滑里两种样片统一按 3:4 展示（人宠母版是 9:16，aspectFill 居中裁掉上下少量背景，人和宠物都在画面中部），否则一高一矮、名字也上下错开。
  -->
  <view wx:if="{{bossScenes.length || duoCovers.length}}" class="section studio-section">
    <view class="row studio-head" aria-role="button" data-mode="pet" bindtap="openArtStudio"><view class="section-title flush">写真馆</view><text class="small">{{duoCovers.length ? '单宠 · 人宠同框' : artPriceText}} ›</text></view>
    <view class="studio-cards">
      <view wx:if="{{bossScenes.length}}" class="studio-card" data-mode="pet" aria-role="button" aria-label="宠物写真，{{artPriceText}}" hover-class="pet-feature-hover" bindtap="openArtStudio">
        <image class="studio-card-image" src="{{bossScenes[0].hdUrl || bossScenes[0].sampleUrl}}" mode="aspectFill" lazy-load />
        <view class="studio-card-copy"><view class="studio-card-title">宠物写真</view><text class="studio-card-sub">{{artPriceText}}</text></view>
      </view>
      <view wx:if="{{duoCovers.length}}" class="studio-card studio-card-duo" data-mode="duo" aria-role="button" aria-label="人宠写真，{{duoGroupCount}} 组" hover-class="pet-feature-hover" bindtap="openArtStudio">
        <text class="feed-tag studio-card-tag">新</text>
        <image class="studio-card-image" src="{{duoCovers[0].hdUrl || duoCovers[0].sampleUrl}}" mode="aspectFill" lazy-load />
        <view class="studio-card-copy"><view class="studio-card-title">人宠写真</view><text class="studio-card-sub">{{duoGroupCount}} 组 · 我和{{pet ? pet.name : '它'}}同框</text></view>
      </view>
    </view>
    <scroll-view class="boss-track" scroll-x enable-flex show-scrollbar="{{false}}">
      <view wx:for="{{studioStrip}}" wx:key="key" class="boss-item" data-kind="{{item.kind}}" data-id="{{item.id}}" aria-role="button" aria-label="{{item.kind === 'duo' ? '人宠写真 ' : ''}}{{item.title}}" bindtap="openStudioItem">
        <view class="boss-thumb-wrap"><text wx:if="{{item.kind === 'duo'}}" class="studio-strip-tag">人宠</text><image class="boss-thumb boss-thumb-scene" src="{{item.sampleUrl}}" mode="aspectFill" lazy-load /></view>
        <view class="boss-name">{{item.title}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 5. 挑一个玩法：分类 chip 在当前页筛选；双列瀑布流按每张图的原始比例排，不裁切 -->
  <view class="section">
    <view class="row"><view class="section-title flush">挑一个玩法</view><text class="small" aria-role="button" bindtap="openAllPlays">全部 ›</text></view>
    <scroll-view class="home-chips chip-scroll" scroll-x show-scrollbar="{{false}}"><view class="chip-track">
      <view wx:for="{{chips}}" wx:key="id" class="chip {{chip === item.id ? 'chip-on' : ''}}" data-id="{{item.id}}" aria-role="tab" aria-selected="{{chip === item.id}}" hover-class="chip-hover" bindtap="chooseChip">{{item.label}}</view>
    </view></scroll-view>

    <t-skeleton wx:if="{{loading}}" type="grid" count="4"></t-skeleton>
    <t-notice wx:elif="{{error}}" type="error" message="{{error}}"></t-notice>
    <t-empty wx:elif="{{!feed.length}}" icon="work" title="玩法正在上架" description="稍后回来看看，新的玩法马上就位。" action-text="重新加载" anim="{{animType}}" decor="{{decor}}" bindaction="load"></t-empty>
    <view wx:else class="feed">
      <view class="feed-col">
        <view wx:for="{{feedLeft}}" wx:key="key" class="feed-item feed-item-{{item.kind}} feed-item-{{item.shape}}" data-id="{{item.key}}" aria-role="button" aria-label="{{item.title}}" hover-class="pet-feature-hover" bindtap="openFeed">
          <view class="feed-photo">
            <text wx:if="{{item.tag}}" class="feed-tag feed-tag-{{item.tagTone}}">{{item.tag}}</text>
            <image wx:if="{{item.cover}}" class="feed-image feed-shape-{{item.shape}}" src="{{item.cover}}" mode="aspectFill" data-kind="feed" data-id="{{item.key}}" binderror="onImageError" lazy-load />
            <view wx:else class="feed-image feed-shape-{{item.shape}} feed-image-empty">样片暂不可用</view>
          </view>
          <view class="feed-title">{{item.title}}</view>
          <text class="feed-note">{{item.note}}</text>
        </view>
      </view>
      <view class="feed-col">
        <view wx:for="{{feedRight}}" wx:key="key" class="feed-item feed-item-{{item.kind}} feed-item-{{item.shape}}" data-id="{{item.key}}" aria-role="button" aria-label="{{item.title}}" hover-class="pet-feature-hover" bindtap="openFeed">
          <view class="feed-photo">
            <text wx:if="{{item.tag}}" class="feed-tag feed-tag-{{item.tagTone}}">{{item.tag}}</text>
            <image wx:if="{{item.cover}}" class="feed-image feed-shape-{{item.shape}}" src="{{item.cover}}" mode="aspectFill" data-kind="feed" data-id="{{item.key}}" binderror="onImageError" lazy-load />
            <view wx:else class="feed-image feed-shape-{{item.shape}} feed-image-empty">样片暂不可用</view>
          </view>
          <view class="feed-title">{{item.title}}</view>
          <text class="feed-note">{{item.note}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
