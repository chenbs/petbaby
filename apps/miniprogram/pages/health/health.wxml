<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="{{skinClass}} page page-flat art-pet layout-workbench">
  <view class="title">健康助手</view>
  <!--
    定位说明必须在最前面。「分诊」不是「问诊」——
    这句话同时是产品定位和合规声明，不能省也不能挪到底部。
  -->
  <text class="small">描述症状，帮你判断要不要去医院、去之前该准备什么。不替代兽医面诊。</text>

  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>

  <t-skeleton wx:if="{{loading}}" type="list" count="2" class="block-gap"></t-skeleton>
  <t-button wx:elif="{{error && !pets.length}}" type="secondary" bindtap="load">重新加载档案</t-button>

  <t-empty
    wx:elif="{{!pets.length}}"
    icon="pet"
    title="还没有可用的档案"
    description="先建一个宠物档案，健康记录会跟着档案走。"
    action-text="去建档案"
    anim="{{animType}}"
    decor="{{decor}}"
    bindaction="goWeights"
  ></t-empty>

  <block wx:else>
    <view class="health-form">
      <view class="section-block">
        <text class="sub-title">哪一只</text>
        <view class="chips">
          <view wx:for="{{pets}}" wx:key="id" class="chip tappable anim-{{animType}} {{petIndex === index ? 'chip-on' : ''}}" hover-class="chip-hover" data-index="{{index}}" bindtap="choosePet">{{item.name}}</view>
        </view>
      </view>

      <view class="section-block">
        <text class="sub-title">发生了什么</text>
        <t-field
          control="textarea"
          value="{{description}}"
          placeholder="例如：从昨天开始不太吃东西，今天吐了两次，精神比平时差"
          maxlength="600"
          bindchange="inputDescription"
        ></t-field>
        <!-- 常见情况快捷填入（2026-09）：只描述看到的现象，不出现病名或药名；点一下追加到描述里 -->
        <view class="chips symptom-chips">
          <view wx:for="{{symptomChips}}" wx:key="*this" class="chip tappable anim-{{animType}}" hover-class="chip-hover" data-text="{{item}}" bindtap="addSymptom">{{item}}</view>
        </view>
      </view>

      <view wx:if="{{recentCount}}" class="records-toggle" aria-role="checkbox" aria-checked="{{includeRecords}}" bindtap="toggleRecords">
        <view class="chip {{includeRecords ? 'chip-on' : ''}}">{{includeRecords ? '✓ ' : ''}}参考近 7 天的日常记录</view>
        <text class="small">记得越全，判断越贴近{{pets[petIndex].name}}的实际情况</text>
      </view>

      <t-button type="primary" block anim="{{animType}}" loading="{{busy}}" bindtap="submit">看看要不要去医院</t-button>
    </view>

    <!-- 免责声明与结论同屏且在结论之前，不折叠。 -->
    <view wx:if="{{result}}" class="health-result">
      <text class="small">{{result.advisory.disclaimer}}</text>

      <view class="row block-gap">
        <t-tag tone="{{result.levelTone}}" size="mini" text="{{result.levelText}}"></t-tag>
        <text class="small">智能分诊建议，非诊断</text>
      </view>
      <view class="sub-title">{{result.advisory.summary}}</view>

      <view wx:if="{{result.advisory.relatedAreas.length}}" class="section-block">
        <text class="sub-title">可能相关</text>
        <view class="chips">
          <view wx:for="{{result.advisory.relatedAreas}}" wx:key="*this" class="chip">{{item}}</view>
        </view>
      </view>

      <view class="section-block">
        <text class="sub-title">出现这些情况请立即就医</text>
        <text wx:for="{{result.advisory.watchFor}}" wx:key="*this" class="small">· {{item}}</text>
      </view>

      <view wx:if="{{result.advisory.visitPreparation.length}}" class="section-block">
        <text class="sub-title">去医院前准备</text>
        <text wx:for="{{result.advisory.visitPreparation}}" wx:key="*this" class="small">· {{item}}</text>
      </view>

      <view wx:if="{{result.contextRecords.length}}" class="section-block">
        <text class="sub-title">这次一起参考了</text>
        <text wx:for="{{result.contextRecords}}" wx:key="*this" class="small">· {{item}}</text>
      </view>

      <view class="row block-gap">
        <t-button type="secondary" size="mini" anim="{{animType}}" bindtap="saveToRecords">记到日常记录</t-button>
        <t-button type="ghost" size="mini" anim="{{animType}}" data-action="summary" bindtap="openRecords">整理给兽医看</t-button>
      </view>
    </view>

    <!--
      日常记录（2026-10）。体重、疫苗驱虫与呕吐 / 便便 / 用药等全部在「日常记录」页录入，这里只读展示，
      录入入口只有一处，避免两个页面各有一套表单、改一处漏一处。

      **只陈述事实，不做评价**：体重给「较上次 +6.2%」，不给「偏胖」「正常」；
      疫苗只标「下次 X 月 X 日」「已过期」，不写「该打了」（红线 2：项目名由用户自己填）。
    -->
    <view class="health-section">
      <view class="row section-head">
        <text class="sub-title">日常记录</text>
        <text class="small link" aria-role="button" data-action="" bindtap="openRecords">去记一笔 ›</text>
      </view>
      <text class="small">吃喝、便便、呕吐、用药、体重和疫苗驱虫都记在这里，分诊和健康档案会一起参考。</text>

      <view wx:if="{{recentFacts.length}}" class="chips">
        <text wx:for="{{recentFacts}}" wx:key="*this" class="chip">{{item}}</text>
      </view>

      <view class="section-block">
        <text class="small strong">体重</text>
        <text wx:if="{{weightTrend}}" class="small">{{weightTrend.statement}}</text>
        <text wx:else class="small">还没有体重记录，记两次之后就能看到变化。</text>
        <!-- 幅度较大时给提示。措辞只说变化了多少并建议就医时提一下，不说「异常」 -->
        <text wx:if="{{weightNote}}" class="hint">{{weightNote}}</text>
        <!-- 只列最近几条，截断在 JS 侧做（wx:for 与 wx:if 同元素的求值顺序容易读错） -->
        <view wx:if="{{recentWeights.length > 1}}" class="stack-tight">
          <view wx:for="{{recentWeights}}" wx:key="id" class="row">
            <text class="small">{{item.measuredOn}}</text>
            <text class="small">{{item.weightText}}</text>
          </view>
        </view>
      </view>

      <view class="section-block">
        <text class="small strong">免疫与驱虫</text>
        <text wx:if="{{!careRecords.length}}" class="small">记下日子，到期前一周会提醒你。打什么、打不打由兽医决定。</text>
        <view wx:for="{{careRecords}}" wx:key="id" wx:if="{{index < 4}}" class="row">
          <view class="care-main">
            <text class="small strong">{{item.kindText}} · {{item.label}}</text>
            <text class="small">{{item.performedOn}}</text>
          </view>
          <t-tag wx:if="{{item.dueText}}" tone="{{item.overdue ? 'warning' : 'neutral'}}" size="mini" text="{{item.dueText}}"></t-tag>
        </view>
      </view>

      <view class="row block-gap">
        <t-button type="secondary" size="mini" anim="{{animType}}" data-action="summary" bindtap="openRecords">给兽医看</t-button>
        <t-button type="ghost" size="mini" anim="{{animType}}" data-action="" bindtap="openRecords">全部记录</t-button>
      </view>
    </view>

    <!--
      健康档案（改造项 L1）。**是就医准备材料不是体检报告**：
      内容全部来自上面这些用户自己录入的记录，不含任何结论性判断。
      免责声明印在 PDF 第一页顶部、与内容同屏（红线 5）。

      不可分享 —— 健康线的产出是私密记录，只能本人下载。
    -->
    <view class="health-section">
      <text class="sub-title">带去医院的材料</text>
      <text class="small">把体重、免疫与分诊记录导成一份 PDF，就医时给兽医看。不是体检报告，也不含诊断结论。</text>

      <view wx:if="{{documents.length}}" class="section-block">
        <view wx:for="{{documents}}" wx:key="id" class="row">
          <view class="care-main">
            <text class="small strong">{{item.kindText}}</text>
            <text class="small">{{item.dateText}}</text>
          </view>
          <t-button type="ghost" size="mini" anim="{{animType}}" data-id="{{item.id}}" bindtap="downloadDocument">下载</t-button>
        </view>
      </view>

      <t-button type="ghost" block anim="{{animType}}" loading="{{documentBusy}}" class="block-gap" bindtap="exportDocument">导出健康档案</t-button>
      <t-button wx:if="{{canBuyDocument}}" type="ai" block anim="{{animType}}" loading="{{documentBusy}}" class="block-gap" bindtap="buyDocument">购买一次导出</t-button>
      <text wx:if="{{documentHint}}" class="hint">{{documentHint}}</text>
    </view>

    <view wx:if="{{sessions.length}}" class="health-section health-history">
      <text class="sub-title">之前的记录</text>
      <view wx:for="{{sessions}}" wx:key="id" class="history-item">
        <view class="row">
          <t-tag tone="{{item.levelTone}}" size="mini" text="{{item.levelText}}"></t-tag>
          <text class="small">{{item.dateText}}</text>
        </view>
        <text class="small">{{item.description}}</text>
      </view>
    </view>
  </block>
</view>
