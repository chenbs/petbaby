---
/*
 * 全站骨架：<head> 元信息 + 顶栏 + 内容 + 页脚 + 小程序码悬浮按钮。
 *
 * 样式与脚本都在这里一次性引入：
 *   · site.css 是 prototype/styles.css 原样搬入（一行不改）。改它就说明视觉出现了
 *     偏差 —— 停下来查原因，不要顺手改（方案第 12 章）。
 *   · site-additions.css 承载**原型没有的新页面类型**所需的样式（solid 顶栏、
 *     小程序码弹框、文章正文）。新增一律进这里，site.css 保持字节不变。
 *   · site.js 是 prototype/main.js 原样搬入。Astro 按 ESM 打包并带 type="module"
 *     （隐含 defer），四块逻辑都在 DOM 就绪后才需要动，defer 反而更安全。
 *     **不拆成多个组件各自带 script** —— 原型的四块逻辑共享 reduced 变量与
 *     一次性事件监听，拆开会重复注册。
 *
 * JSON-LD 的 Organization 全站都给（方案 7.2），页面级的（WebSite / Article /
 * Breadcrumb）由各页通过 jsonLd 传进 Seo.astro。
 */
import "../styles/site.css";
import "../styles/site-additions.css";
import Seo from "../components/Seo.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import QrFab from "../components/QrFab.astro";
import { BRAND_NAME, SITE_URL } from "../config/site";

interface Props {
  title?: string;
  titleOverride?: string;
  description: string;
  ogType?: "website" | "article";
  image?: string;
  jsonLd?: Array<Record<string, unknown>>;
  noindex?: boolean;
  /** 首页传 "hero"，其余页面用默认的 "solid"。 */
  topbar?: "hero" | "solid";
  /** hero 的 poster 预加载只有首页需要。 */
  preloadHeroPoster?: boolean;
  /** 右下角小程序码悬浮按钮的显隐规则（方案 6.4）在首页要观察 hero 与 CTA 区。 */
  fabObservesHero?: boolean;
}

const {
  title,
  titleOverride,
  description,
  ogType,
  image,
  jsonLd = [],
  noindex = false,
  topbar = "solid",
  preloadHeroPoster = false,
  fabObservesHero = false,
} = Astro.props;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND_NAME,
  url: `${SITE_URL}/`,
  description,
  // logo 与 sameAs（社交账号）待提供，缺值时不输出空字段 —— 空字段会被判为无效标记
};
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/*
  favicon 用内联 SVG，不引外部文件：待提供正式 logo 之前，没有这一行浏览器
  会去请求 /favicon.ico 并吃一个 404。渐变取值与顶栏 .brand-mark 一致。
*/}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%23C4335C'/%3E%3Cstop offset='1' stop-color='%23E0885A'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='8' fill='url(%23g)'/%3E%3C/svg%3E" />
{
  /*
    poster 提前取：它是首屏唯一决定观感的图（视频加载完成前一直显示它）。
    不给 preload 的话它与 3.5MB 的 bg.mp4 同时起跑，反而更晚可见。
  */
  preloadHeroPoster && (
    <link rel="preload" as="image" href="/assets/bg-poster.jpg" fetchpriority="high" />
  )
}
<Seo
  title={title}
  titleOverride={titleOverride}
  description={description}
  ogType={ogType}
  image={image}
  jsonLd={[organization, ...jsonLd]}
  noindex={noindex}
/>
</head>
<body>

<Topbar variant={topbar} />

<slot />

<Footer />

<QrFab observeHero={fabObservesHero} />

<script src="../scripts/site.js"></script>
<script src="../scripts/qr.js"></script>
</body>
</html>
