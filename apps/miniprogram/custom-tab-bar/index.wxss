/* 内容流使用贴底导航，选中态只改变图标和标签颜色。 */
.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  box-sizing: border-box;
  align-items: stretch;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 2rpx solid var(--divider);
  background: var(--card-background);
  box-shadow: var(--shadow-none);
  transition: background var(--dur-base) var(--ease-out);
}

.item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-0);
  min-height: 104rpx;
  padding: var(--space-1) 0;
  color: var(--text-secondary);
  transition: color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
}

.item-glyph {
  font-size: var(--font-h3);
  line-height: 1;
  transition: transform var(--dur-base) var(--ease-out);
}

.item-text {
  font-size: var(--eyebrow-size);
}

.item.active {
  color: var(--primary);
  font-weight: var(--fw-bold);
}

.item.active .item-glyph {
  transform: scale(1.12);
}

.item-hover.anim-bounce { transform: scale(.94); }
.item-hover.anim-fade { opacity: .8; }
.item-hover.anim-glow { color: var(--primary); }
.item-hover.anim-neon { color: var(--primary); }

/* 其余主题沿用同一贴底结构，只变换材质与颜色。 */
.tabbar-glass {
  background: var(--surface);
  backdrop-filter: blur(var(--card-blur));
  -webkit-backdrop-filter: blur(var(--card-blur));
}

.tabbar-glass .item.active {
  color: var(--secondary);
}

/* dark：选中图标带霓虹微光，与该皮肤的 neon 动效呼应 */
.tabbar-dark .item.active .item-glyph {
  text-shadow: 0 0 18rpx var(--ai-glow);
}
