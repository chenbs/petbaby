.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

.interactive-fields {
  display: grid;
  gap: var(--space-4);
}

.scenes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.scene {
  min-width: 0;
  transition: transform var(--transition-duration) var(--transition-easing);
}

.scene-hover {
  transform: scale(.97);
}

.scene-on {
  color: var(--primary);
}

.scene-sample {
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-card);
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}

.scene-on .scene-sample {
  box-shadow: 0 0 0 4rpx var(--primary);
}

.scene-name {
  display: flex;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-2) 0 var(--space-3);
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
}

.scene-selected {
  color: var(--primary);
}
.scene-swiper { height: 440rpx; margin-top: var(--space-3); }
.scene-slide { display: flex; height: 100%; flex-direction: column; align-items: center; }
.scene-slide .scene-sample { width: 500rpx; height: 344rpx; }
.scene-slide .scene-name { width: 500rpx; }

.preview {
  padding: var(--space-6) var(--space-5);
  border-radius: var(--card-radius);
  background: var(--scene-sky);
  color: var(--scene-ink);
  text-align: center;
}

.preview-stars {
  color: var(--scene-dust);
  font-size: var(--small-size);
  letter-spacing: var(--eyebrow-tracking);
}

.preview-title {
  margin: var(--space-4) 0 var(--space-2);
  color: var(--scene-ink);
  font-size: var(--font-h2);
  font-weight: 900;
}

.preview-copy {
  color: var(--scene-ink);
  font-size: var(--small-size);
  opacity: .82;
}
