# 测试机（staging）环境变量模板。
# 用法：`./deploy/scripts/gen-env.sh <域名> <证书运维邮箱>` 会基于本文件生成 deploy/.env.staging，
# 并自动填入随机密钥。生成后的 .env.staging 不进入版本库，请勿把真实值写回本文件。

# ---------- 运行模式 ----------
# NODE_ENV=production 才会启用生产安全边界（无 demo 用户兜底、Cookie Secure、后台白名单）。
# APP_ENV=staging 是测试机专用开关：允许本地磁盘存储与模拟支付，正式生产禁止设置。
NODE_ENV=production
APP_ENV=staging

# ---------- 域名（必填，由 gen-env.sh 写入） ----------
PETBABY_DOMAIN=petbaby.example.com
# Certbot/云证书申请时使用的运维邮箱；宿主机 Nginx 不读取此变量。
ACME_EMAIL=ops@example.com
PUBLIC_APP_URL=https://petbaby.example.com
# 独立官网（apps/website）的域名，供 release-website.sh 构建时注入
# canonical / sitemap / robots 的基准。与 PUBLIC_APP_URL **是两个不同的域名**：
# 主域给官网、应用挪到 app. 子域（方案 1 章）。官网发布与应用完全解耦，
# 这个变量只被 release-website.sh 读取，platform 侧不用它。
WEBSITE_URL=https://petbaby.example.com

# ---------- 镜像标签 ----------
PETBABY_IMAGE=petbaby-platform:staging
# Docker Hub 不通时改为国内仓库，例如：
# NODE_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/node:22-alpine
# POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/postgres:17-alpine
NODE_BASE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:17-alpine
PNPM_VERSION=10.13.1
# Docker Hub/NPM 官方源不可达时，改成云厂商或企业 npm 镜像，例如 npmmirror。
NPM_REGISTRY=https://registry.npmmirror.com/

# ---------- 数据库（密码由 gen-env.sh 随机生成） ----------
POSTGRES_DB=petbaby
POSTGRES_USER=petbaby
POSTGRES_PASSWORD=
DATABASE_URL=

# ---------- 密钥（由 gen-env.sh 随机生成） ----------
SESSION_SECRET=
WORKER_SECRET=
ADDRESS_ENCRYPTION_KEY=

# ---------- 登录 ----------
# 测试机开启账号密码注册/登录；正式生产改回 false，只保留微信登录。
PASSWORD_AUTH_ENABLED=true
# 可选：设置后注册必须携带邀请码，避免公网测试机被陌生人注册。
PASSWORD_AUTH_INVITE_CODE=

# ---------- 后台白名单 ----------
# 先留空部署，注册首个账号后执行 `./deploy/scripts/create-admin.sh <账号名>` 自动写入。
ADMIN_USER_IDS=

# ---------- 对象存储：测试机落在服务器本地磁盘 ----------
# local 只在 APP_ENV=staging 或本地开发生效；正式生产必须改为 s3 并补齐 OSS_* 凭据。
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/.data/objects
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
STORAGE_REGION=

# ---------- 支付：测试机使用模拟支付，不做真实联调 ----------
# development 只在 APP_ENV=staging 生效；正式生产必须改为 wechat 并补齐商户凭据。
PAYMENT_PROVIDER=development
PHYSICAL_PAYMENT_PROVIDER=development
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_CERT_SERIAL=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

# ---------- 微信小程序（拿到 AppID/Secret 后再填，填了才能用微信登录） ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SUBSCRIBE_TEMPLATE_ID=

# ---------- AI 图片生成：留空则使用内置本地占位图 ----------
# lingsuan 图像接口（主通道）。配上后原 AI_IMAGE_ENDPOINT 自动顺延为备用。
# 出网白名单要放两个域名：API 在 lingsuan.top，图片下载在 img.junliai.org
LINGSUAN_IMAGE_BASE_URL=https://lingsuan.top
LINGSUAN_IMAGE_API_KEY=
LINGSUAN_IMAGE_MODEL=gpt-image-2
# 共享请求队列并发数；代码硬限制为 1–20
LINGSUAN_IMAGE_CONCURRENCY=20
LINGSUAN_IMAGE_SIZE=1024x1024
LINGSUAN_IMAGE_QUALITY=high
# 留空：接口接受 input_fidelity（不再 400），但效果未验证，开前先人眼比对
LINGSUAN_IMAGE_INPUT_FIDELITY=
# 单张实测 46–62 秒（low），high 更久
LINGSUAN_IMAGE_TIMEOUT_MS=180000
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
AI_IMAGE_SECONDARY_ENDPOINT=
AI_IMAGE_SECONDARY_API_KEY=
AI_IMAGE_SECONDARY_MODEL=
AI_CIRCUIT_FAILURE_THRESHOLD=3

# ---------- 运行参数 ----------
FFMPEG_PATH=/usr/bin/ffmpeg
# 视频字幕字体。缺失时 ffmpeg 不报错，但中文字幕会渲染成方框或整行消失。
FFMPEG_FONT_FILE=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc
WORKER_POLL_INTERVAL_MS=1000
DAILY_GENERATION_LIMIT=200
DAILY_COST_LIMIT=10
LAYOUT_GENERATION_COST=0.01
AI_IMAGE_COST=0.08
# 仅接受 HTTPS 地址；留空则只写健康快照不外发告警。
ALERT_WEBHOOK_URL=
