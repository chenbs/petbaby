.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.list {
  display: grid;
  gap: var(--space-5);
  margin-top: var(--space-4);
}

.pet-entry {
  padding: var(--space-3) 0 var(--space-5);
  border-bottom: 2rpx solid var(--divider);
}

.pet {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.pet-avatar {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}

.pet-avatar-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: var(--small-size);
}

.pet-main {
  display: grid;
  flex: 1;
  gap: var(--space-1);
}

.pet-name {
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: 700;
}

.pet-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-4);
  padding-top: var(--space-4);
}

.pet-counts {
  display: block;
  margin-top: var(--space-3);
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border: var(--card-border);
  border-radius: 50%;
  background: var(--surface);
}

.avatar-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--title-size);
}

.foot {
  display: flex;
  gap: var(--space-3);
}

.companion {
  color: var(--primary);
  font-size: var(--small-size);
  font-weight: var(--fw-bold);
  letter-spacing: var(--ls-tight);
}
