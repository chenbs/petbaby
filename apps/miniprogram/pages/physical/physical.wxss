.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.list {
  display: grid;
  gap: var(--space-3);
}

/* 已解锁作品按可比较的双列呈现。 */
.work-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.work-item {
  display: flex;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  flex-direction: column;
  padding: var(--space-2);
  border: var(--card-border);
  border-radius: var(--card-radius);
  background: var(--card-background);
  gap: var(--space-2);
}

/*
 * 选中态用 --primary 的双层环，而非 --border-highlight ——
 * 后者是 border 简写且在 light/cute 下是 `0 solid transparent`，
 * 拿来当 box-shadow 会让这两套主题彻底失去选中反馈。
 */
.work-item-on {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx var(--primary);
}

/* 横滑小图同样锁 3:4（方案 2.5），固定像素高会让不同产出比例的缩略图参差 */
.work-cover {
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-card);
  border-radius: var(--radius-image-thumb);
  background: var(--skeleton-base);
}

.work-cover-blank {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: var(--space-3);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

.work-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-main {
  display: grid;
  gap: var(--space-1);
}
