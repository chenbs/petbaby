<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="{{skinClass}} page page-flat art-film layout-workbench">
  <view class="brand brand-{{themeId}}">
    <image class="brand-photo" src="/assets/theme-preview.jpg" mode="aspectFill" />
    <view class="brand-name">麻麻抱我</view>
    <text class="brand-quote">把我的照片，做成只属于我的作品。</text>
    <view class="brand-rule"></view>
  </view>

  <t-notice wx:if="{{message}}" type="{{messageType}}" message="{{message}}" class="block-gap"></t-notice>

  <block wx:if="{{authenticated}}">
    <t-card blur="{{blurOk}}" anim="{{animType}}" class="block-gap">
      <view class="sub-title">已登录</view>
      <text class="muted">{{accountLabel}}</text>
    </t-card>
    <t-button type="primary" block anim="{{animType}}" class="block-gap" bindtap="goHome">返回首页</t-button>
    <t-button type="danger" block anim="{{animType}}" class="block-gap" bindtap="logout">退出登录</t-button>
  </block>

  <block wx:else>
    <!-- 2026-10-11：小程序只有微信登录，不提供账号密码注册与登录入口 -->
    <t-card blur="{{blurOk}}" anim="{{animType}}" class="block-gap">
      <view class="sub-title">用微信登录</view>
      <text class="muted">使用当前微信身份进入，无需注册，也不需要账号密码。</text>
    </t-card>
    <t-button type="primary" block anim="{{animType}}" loading="{{busy}}" class="block-gap" bindtap="wechatLogin">微信一键登录</t-button>
    <text class="hint block-gap">登录即表示同意用户协议与隐私政策。</text>
  </block>
</view>
