---
const steps = [
  { number: "01", title: "认识一下我", body: "打开小程序，记下我的名字，建一个属于我们的小档案。" },
  { number: "02", title: "挑一张你喜欢的我", body: "清晰、光线自然的日常照就很好，记得露出我的小脸。" },
  { number: "03", title: "把可爱好好留下", body: "选一个喜欢的玩法，预览作品，再决定保存或分享。" },
];
---
<section class="ed-section ed-how" id="how">
  <div class="ed-container">
    <div class="ed-section-head"><div><p class="ed-kicker">A PHOTO IS ALL IT TAKES</p><h2>从你的相册，<br />到我们的珍藏。</h2></div><a class="ed-text-link" href="#contact">开始我们的第一张 <span aria-hidden="true">↗</span></a></div>
    <ol class="ed-steps">{steps.map((step) => <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
  </div>
</section>
