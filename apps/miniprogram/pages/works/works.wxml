<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="page page-tabbar">
  <text class="eyebrow">MY CABINET</text>
  <view class="title">我的作品柜</view>

  <!-- 三个筛选器横排，节省纵向空间 -->
  <view class="filters">
    <picker range="{{petNames}}" bindchange="choosePet">
      <view class="filter">
        <text class="filter-label">宠物</text>
        <text class="filter-value">{{petText}}</text>
      </view>
    </picker>
    <picker range="{{pluginNames}}" bindchange="choosePlugin">
      <view class="filter">
        <text class="filter-label">玩法</text>
        <text class="filter-value">{{pluginText}}</text>
      </view>
    </picker>
    <picker range="{{statusLabels}}" bindchange="chooseStatus">
      <view class="filter">
        <text class="filter-label">状态</text>
        <text class="filter-value">{{statusText}}</text>
      </view>
    </picker>
  </view>

  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>

  <t-skeleton wx:if="{{loading}}" type="list" count="4" class="block-gap"></t-skeleton>

  <block wx:else>
    <!-- 进行中的任务置顶，失败项给重试入口 -->
    <view wx:if="{{tasks.length}}" class="section">
      <view class="section-title">进行中</view>
      <view class="list">
        <t-card wx:for="{{tasks}}" wx:key="id" blur="{{blurOk}}" anim="{{animType}}">
          <view class="row">
            <view>
              <view class="sub-title">{{item.statusText}}</view>
              <text class="small">{{item.pluginId}}</text>
            </view>
            <t-tag tone="{{item.status === 'failed' ? 'error' : 'accent'}}" text="{{item.statusText}}"></t-tag>
          </view>
          <view wx:if="{{item.status !== 'failed'}}" class="task-progress">
            <t-progress percent="{{item.progress}}" tone="ai" label="生成进度" show-value></t-progress>
          </view>
          <t-button wx:else type="secondary" size="mini" anim="{{animType}}" class="block-gap" data-id="{{item.id}}" bindtap="retry">重新尝试</t-button>
        </t-card>
      </view>
    </view>

    <view class="section">
      <view class="section-title">已完成</view>

      <!--
        clay 只在「真的还没有作品」时开（方案 J 只用于结果页与空状态）。
        筛选无结果是一次操作反馈、不是情感时刻，此时保持方案 3.6 的克制线条，
        否则每次换筛选条件都弹一块黏土底座，反而显得廉价。
      -->
      <t-empty
        wx:if="{{!works.length && !tasks.length}}"
        icon="work"
        title="{{filtered ? '没有符合条件的作品' : '还没有作品'}}"
        description="{{filtered ? '换个筛选条件，或者清空重看。' : '挑一个玩法，几分钟就能做出第一件作品。'}}"
        action-text="{{filtered ? '清空筛选' : '去做一个'}}"
        anim="{{animType}}"
        decor="{{decor}}"
        clay="{{!filtered}}"
        bindaction="handleEmptyAction"
      ></t-empty>

      <!--
        A 方向作品墙：图占满卡片，文字压在渐变遮罩里。
        比例锁 3:4（--ratio-card），避免不同玩法的产出把网格撑得参差。
      -->
      <view wx:else class="grid">
        <t-card
          wx:for="{{works}}"
          wx:key="id"
          variant="grid"
          clickable
          padded="{{false}}"
          blur="{{blurOk}}"
          anim="{{animType}}"
          data-id="{{item.id}}"
          bindtap="open"
        >
          <view class="cover-wrap">
            <image class="cover" src="{{item.outputUrl || item.photo.url}}" mode="aspectFill" lazy-load />
            <view class="veil"></view>
            <t-tag
              wx:if="{{item.statusTone !== 'success'}}"
              class="cover-tag"
              tone="{{item.statusTone}}"
              size="mini"
              text="{{item.statusText}}"
            ></t-tag>
            <view class="cover-meta">
              <view class="work-title">{{item.title}}</view>
              <text class="cover-sub">{{item.plugin.code}} · v{{item.version}}</text>
            </view>
          </view>
        </t-card>
      </view>
    </view>
  </block>
</view>
