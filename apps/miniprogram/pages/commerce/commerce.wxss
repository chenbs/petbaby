.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.list {
  display: grid;
  gap: var(--space-3);
}

/* 手机上按完整行展示方案，权益与价格不被窄列挤断。 */
.plans {
  display: grid;
  gap: var(--space-3);
  grid-template-columns: minmax(0, 1fr);
}

.plan {
  display: block;
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.plan-price {
  margin: var(--space-2) 0;
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--title-weight);
}

.plan-benefits {
  display: grid;
  margin-top: var(--space-3);
  gap: var(--space-1);
}

.benefit {
  display: block;
  color: var(--text-secondary);
  font-size: var(--body-size);
  line-height: var(--lh-sm);
}

.sub-main {
  display: grid;
  gap: var(--space-1);
}

.sub-side {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.entry-row {
  display: flex;
  align-items: center;
  padding: var(--space-4) 0;
  border-top: 2rpx solid var(--divider);
  gap: var(--space-3);
}

.entry-main {
  display: grid;
  flex: 1;
  gap: var(--space-1);
}

.entry-arrow {
  color: var(--text-secondary);
  font-size: var(--font-h2);
}
