/**
 * 全局样式：只做「CSS 变量 → 语义类」的映射。
 *
 * 本文件是唯一允许出现 var() 兜底字面量的地方（需求 3.4）。兜底值取 pet 主题，
 * 用于基础库低于 2.9.0（无 page-meta）或注入失败时的降级。2026-09 起兜底取「橘子汽水」。
 * 其余 .wxss 一律零硬编码，由 scripts/validate.js 扫描把关。
 */
page {
  --primary: #B7401A;
  --secondary: #2A5FE8;
  --background: #FFFAF3;
  --surface: #FFF1E0;
  --card-background: #FFFFFF;
  --text-primary: #1F2540;
  --text-secondary: #5B6178;
  --border: #F3E3D2;
  --divider: #F6ECE0;
  --success: #23794A;
  --warning: #A15A00;
  --error: #C0352B;
  --disabled: #D9CFC4;
  --success-surface: #E3F4EA;
  --error-surface: #FDECE8;
  --ai-gradient-start: #FF9A52;
  --ai-gradient-end: #FFB273;
  --ai-glow: rgba(255,154,82,.25);
  --ai-gradient-angle: 120deg;
  --ai-gradient: linear-gradient(120deg, #C52D53, #14776B);
  --button-primary: #FF9A52;
  --button-secondary: #FFF1E0;
  --button-disabled: #F1E6DA;
  --button-primary-text: #1F2540;
  --button-secondary-text: #1F2540;
  --button-radius: 999rpx;
  --card-radius: 40rpx;
  --card-shadow: 0 4rpx 16rpx -4rpx rgba(60,35,20,.1),0 32rpx 64rpx -36rpx rgba(60,35,20,.28);
  --card-blur: 0;
  --card-border: 0 solid transparent;
  --card-radius-variant: 32rpx;
  --page-padding: 32rpx;
  --section-spacing: 48rpx;
  --page-bottom-safe: 190rpx;
  --nav-bar-background: #FFFAF3;
  --title-size: 44rpx;
  --body-size: 28rpx;
  --small-size: 24rpx;
  --eyebrow-size: 20rpx;
  --title-weight: 800;
  --title-letter-spacing: 0;
  --transition-duration: 240ms;
  --transition-easing: cubic-bezier(.22,.61,.36,1);
  --border-highlight: 0 solid transparent;
/* 以下均为与主题无关的常量，只在此声明一次，不进注入串（真源为 theme/tokens.js 的 CONSTANT_VARS） */
  --radius-pill: 999rpx;
  /* 间距：绝对阶梯（UI 重构方案 2.1），不再由 page-padding 派生 */
  --space-0: 4rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;
  --space-7: 96rpx;
  --space-8: 128rpx;
  --page-x-wide: 48rpx;
  --gap-item: 24rpx;
  --gap-group: 48rpx;
  --gap-section: 96rpx;
  /* 圆角阶梯（方案 2.2）：卡片用 --card-radius 保留主题身份，其余按尺寸取档 */
  --radius-xs: 8rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-image-hero: 16rpx;
  --radius-image-thumb: 16rpx;
  --radius-clay: 56rpx;
  --radius-none: 0;
  /* t-empty 线条插画的有机形状：门禁只豁免单值 50%，非对称圆角须登记为 token */
  --radius-pad: 50% 50% 46% 46%;
  --radius-head: 46% 46% 50% 50%;
  /* 行高与字重字距（方案 2.3，F 排版方法论） */
  --lh-display: 1.06;
  --lh-h1: 1.3;
  --lh-h2: 1.35;
  --lh-h3: 1.4;
  --lh-body: 1.62;
  --lh-sm: 1.6;
  --lh-xs: 1.5;
  --fw-light: 300;
  --fw-normal: 400;
  --fw-medium: 500;
  --fw-bold: 700;
  --fw-black: 800;
  --ls-tight: 0;
  --ls-tighter: 0;
  --ls-kicker: 0;
  --ls-cover: 0;
  /* 图片比例（方案 2.5） */
  --ratio-hero: 16 / 10;
  --ratio-card: 3 / 4;
  --ratio-portrait: 9 / 16;
  --ratio-cover: 4 / 3;
  --ratio-square: 1 / 1;
  --on-image-primary: #FFFFFF;
  --on-image-secondary: #EDECEB;
  /* 动效（方案 2.6） */
  --dur-fast: 120ms;
  --dur-base: 240ms;
  --dur-slow: 400ms;
  --dur-reveal: 900ms;
  --stagger: 40ms;
  --ease-out: cubic-bezier(.22, 1, .36, 1);
  --ease-in-out: cubic-bezier(.4, 0, .2, 1);
  --font-h2: 36rpx;
  --font-h3: 30rpx;
  --font-display: 56rpx;
  --eyebrow-tracking: 0;
  /* 旧面板交互的表面兜底：无 page-meta 时按 pet 的实底取值 */
  --glass-background: rgba(24, 39, 36, .97);
  --glass-background-solid: #182724;
  --glass-border: 2rpx solid rgba(255, 255, 255, .14);
  --glass-blur: 0;
  --glass-radius: 24rpx 24rpx 0 0;
  --glass-shadow: 0 -8rpx 28rpx rgba(24, 39, 36, .22);
  --glass-scrim: #23312D;
  --glass-scrim-max: 0.32;
  --glass-text-primary: #FFFFFF;
  --glass-text-secondary: #DAE5DE;
  --glass-handle: rgba(255, 255, 255, .4);
  --glass-handle-width: 64rpx;
  --glass-blur-degraded: 0;
  --glass-easing: cubic-bezier(.22, .61, .36, 1);
  /* 阴影与遮罩（方案 2.4 / 2.5）。基色为暖褐而非纯黑 —— 方案称这是廉价与高级的分水岭。
     取值必须是成品串：.wxss 不许出现 rgba(，色相拆分只能在 theme/tokens.js 里合成。 */
  --shadow-card: 0 4rpx 16rpx -4rpx rgba(60, 35, 20, .1), 0 32rpx 64rpx -36rpx rgba(60, 35, 20, .28);
  --shadow-image: 0 8rpx 24rpx -8rpx rgba(60, 35, 20, .16), 0 56rpx 96rpx -48rpx rgba(60, 35, 20, .42);
  --shadow-float: 0 16rpx 40rpx -12rpx rgba(60, 35, 20, .18), 0 64rpx 120rpx -40rpx rgba(60, 35, 20, .38);
  --shadow-press: 0 2rpx 8rpx -2rpx rgba(60, 35, 20, .14);
  --shadow-none: none;
  /* 旧黏土组件的兼容样式，兜底取 pet 的浅卡面值。 */
  --shadow-clay-body: inset 0 10rpx 24rpx rgba(190, 140, 120, .13), 0 16rpx 32rpx -12rpx rgba(190, 140, 120, .34), 0 36rpx 68rpx -36rpx rgba(190, 140, 120, .5);
  --clay-highlight: rgba(255,255,255,0.95);
  --shadow-clay-inset: inset 0 6rpx 18rpx rgba(31,37,64,0.28);
  --veil-image: linear-gradient(to top, rgba(20, 10, 4, .82) 0%, rgba(20, 10, 4, .28) 45%, transparent 72%);
  --veil-vignette: radial-gradient(120% 90% at 50% 15%, transparent 35%, rgba(60, 35, 20, .34));
  /* 弹层遮罩兜底。缺了它，基础库低于 2.9.0（无 page-meta）时 t-dialog / t-popup /
     t-action-sheet 的遮罩层会完全透明 —— 弹层浮在可见内容上且点不穿，比样式错更糟。 */
  --mask: rgba(31,37,64,0.45);
  /* 骨架屏与柔性分割线兜底：注入串里按主题明暗派生，此处取 pet 值 */
  --skeleton-base: rgba(31,37,64,0.06);
  --skeleton-shine: rgba(255,255,255,0.55);
  --divider-soft: rgba(31,37,64,0.06);
  --glass-duration: 360ms;

  background: var(--background, #FFFAF3);
  color: var(--text-primary, #1F2540);
  font-family: sans-serif;
  font-size: var(--body-size, 28rpx);
  transition: background var(--transition-duration, 240ms) var(--transition-easing, ease), color var(--transition-duration, 240ms) var(--transition-easing, ease);
}

/* ---------- 页面骨架 ---------- */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--page-padding) var(--page-padding) var(--page-bottom-safe);
  background: var(--background);
}

image {
  border-radius: var(--radius-image-thumb);
}

.page-flat {
  padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
}

.page-tabbar {
  padding-bottom: calc(var(--page-bottom-safe) + env(safe-area-inset-bottom));
}

/* 页面语言只改变阅读节奏和边界，配色始终来自用户主题。 */
.art-film .section-title {
  font-weight: var(--fw-medium);
}

.art-pet .section-title {
  font-weight: var(--fw-bold);
}

.art-brand .section-title {
  padding-bottom: 0;
  border-bottom: 0;
  font-weight: var(--fw-bold);
}

.layout-workbench .section {
  margin-top: var(--gap-group);
}

.layout-workbench .section:first-child {
  margin-top: 0;
}

.layout-bookshelf {
  max-width: 880rpx;
  margin: 0 auto;
}

.layout-bookshelf .section {
  margin-top: var(--gap-section);
}

.layout-matrix .section-title {
  margin-bottom: var(--gap-item);
}

.layout-canvas {
  padding-top: var(--space-3);
}

.section {
  margin-top: var(--section-spacing);
}

.section:first-child {
  margin-top: 0;
}

.stack {
  display: grid;
  gap: var(--space-4);
}

.stack-tight {
  display: grid;
  gap: var(--space-2);
}

/* ---------- 文本层级 ---------- */
.eyebrow {
  display: block;
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--eyebrow-tracking);
  text-transform: uppercase;
}

.title {
  margin: var(--space-3) 0 var(--space-3);
  color: var(--text-primary);
  font-size: var(--title-size);
  font-weight: var(--title-weight);
  letter-spacing: var(--title-letter-spacing);
  line-height: var(--lh-h1);
  word-break: break-all;
}

.section-title {
  margin: 0 0 var(--space-4);
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--title-weight);
  line-height: var(--lh-h2);
}

.sub-title {
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: 700;
  line-height: var(--lh-h3);
}

.muted {
  color: var(--text-secondary);
  font-size: var(--body-size);
  line-height: 1.7;
}

.small {
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 1.6;
}

.strong {
  color: var(--text-primary);
  font-weight: 700;
}

.accent {
  color: var(--primary);
}

.danger-text {
  color: var(--error);
}

.center {
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.divider-line {
  height: 2rpx;
  background: var(--divider);
}

/* ---------- 表面 ---------- */
.surface {
  background: var(--surface);
  border-radius: var(--card-radius);
}

.hit-area {
  min-width: 88rpx;
  min-height: 88rpx;
}

/* ---------- 玻璃面板内的文本层级 ----------
 * slot 内容归页面作用域，因此这组类必须是全局的，不能放在 glass-sheet 组件内。
 * 面板的合成背景与页面底不同，故不复用 --text-primary / --text-secondary。 */
.glass-title {
  margin: 0;
  color: var(--glass-text-primary);
  font-size: var(--title-size);
  font-weight: var(--title-weight);
  letter-spacing: var(--title-letter-spacing);
  line-height: 1.2;
}

.glass-sub-title {
  color: var(--glass-text-primary);
  font-size: var(--font-h3);
  font-weight: 700;
}

.glass-strong {
  color: var(--glass-text-primary);
  font-weight: 700;
}

.glass-muted {
  color: var(--glass-text-secondary);
  font-size: var(--body-size);
  line-height: 1.7;
}

.glass-small {
  color: var(--glass-text-secondary);
  font-size: var(--small-size);
  line-height: 1.6;
}

.glass-eyebrow {
  display: block;
  color: var(--glass-text-secondary);
  font-size: var(--eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--eyebrow-tracking);
  text-transform: uppercase;
}

/* glassBorder 是描边简写而非纯色，故分隔线走 border-top 而不是 background */
.glass-divider {
  border-top: var(--glass-border);
}

/*
 * 玻璃面板内的分段间距。原先只在 ai-run 里定义，create 的 C 表单变体也要用，
 * 与其在两页各写一份，不如与其他 glass-* 一起放在全局。
 */
.section-block {
  margin-top: var(--space-5);
}

/*
 * ---------- 选项 chip（≤4 个选项平铺，不用 picker） ----------
 *
 * 2026-08-03 从 ai-create.wxss 提到全局：pages/pets 的四个枚举
 * （种类 3 / 性别 3 / 日期类型 2 / 生命阶段 3）也改用 chip。
 *
 * picker 要多一次弹层交互才能看全部选项，4 个以内平铺能一眼比较；
 * 超过 4 个仍走 picker。见 CLAUDE.md 的 UI 重构约定。
 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

/*
 * border-box：min-height 是整颗 chip 的高度（≈ 原型 32px），
 * 原先按内容盒算再叠上下内边距，横滑里的 chip 被撑到 60px 高。
 */
.chip {
  display: inline-flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--card-background);
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 1.3;
  white-space: nowrap;
  flex-shrink: 0;
  transition: border-color var(--transition-duration) var(--transition-easing), color var(--transition-duration) var(--transition-easing);
}

/*
 * 横滑 chip：scroll-view 不开 enable-flex（真机与模拟器都会把 flex 子项顶出容器上沿约 10px，
 * chip 上边框被裁掉），改由内层 .chip-track 做 inline-flex 排版。
 */
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-track {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) 0;
  vertical-align: top;
}

.chip-hover {
  opacity: .85;
}

.chip-on {
  border-color: var(--skin-chip-on-border, var(--button-primary));
  background: var(--skin-chip-on-bg, var(--button-primary));
  color: var(--skin-chip-on-text, var(--button-primary-text));
  font-weight: 700;
}

/*
 * 表单项下方的补充说明。原先靠 t-field 的 help 属性承载，
 * 四个枚举改 chip 后不再经过 t-field，需要一个独立的说明样式。
 */
.hint {
  display: block;
  margin-top: var(--space-2);
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 40rpx;
}

/*
 * ---------- 里程碑石碑 ----------
 *
 * 2026-08-06 从 pages/timeline/timeline.wxss 提到全局：岛日记页也要列
 * 「已经走过」（22 号文 4.2 的里程碑 100/365/1000）。
 *
 * 提而不复制，与 `.chip` / `.hint` 同一处理（CLAUDE.md 的 UI 重构约定：
 * 第二处要用时把它提到 app.wxss 再共用，别复制一份）—— 里程碑文案两处必须
 * 逐字一致，样式跟着走散会让同一个「第 365 天」在两页长得不一样。
 */
.stones {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.stone {
  padding: var(--space-3) var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.stone-label {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
  letter-spacing: var(--ls-tight);
}

/* ---------- 点击反馈（由 animationType 决定，见 .anim-* 修饰） ---------- */
.tappable {
  transition: transform var(--transition-duration) var(--transition-easing), opacity var(--transition-duration) var(--transition-easing), box-shadow var(--transition-duration) var(--transition-easing);
}

.tappable.anim-bounce:active {
  transform: scale(.96);
}

.tappable.anim-fade:active {
  opacity: .85;
}

.tappable.anim-glow:active {
  box-shadow: 0 0 32rpx var(--ai-glow);
}

.tappable.anim-neon:active {
  box-shadow: 0 0 0 2rpx var(--primary), 0 0 28rpx var(--ai-glow);
}

/* ---------- 生成内容提示蒙层 ----------
 * 「该内容由AI生成」只叠在界面上，不写进图片文件（2026-09 口径）。
 * 四套主题统一样式、不读主题变量：它是合规提示，不是装饰，换肤后也必须一样可读。
 * 渐变实色段取暖黑 .66，压在纯白图上白字仍 ≥ 5:1。文案由服务端 aiNotice 下发。
 */
.ai-mask-host {
  position: relative;
  overflow: hidden;
}

.ai-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3;
  padding: 44rpx 16rpx 12rpx;
  background: linear-gradient(to bottom, rgba(20, 10, 4, 0), rgba(20, 10, 4, .66) 55%);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
  pointer-events: none;
}

.ai-mask-lg {
  padding: 64rpx 24rpx 20rpx;
  font-size: 24rpx;
}

/* 沉浸式大图（玻璃面板底图）用的胶囊版提示：面板会盖住图片下半部，贴底蒙层会被挡住，
 * 所以放在 overlay 插槽里、贴在图片顶部可见区域。 */
.ai-mask-inline {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(20, 10, 4, .66);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ---------- skin:start（由 scripts/build-skin-css.js 生成，勿手改） ---------- */
.skin-pet {
  --skin-texture: none;
  --skin-texture-size: auto;
  --skin-title-font: inherit;
  --skin-num-font: inherit;
  --skin-mark: #FF9A52;
  --skin-mark-w: 16rpx;
  --skin-mark-h: 16rpx;
  --skin-mark-radius: 999rpx;
  --skin-photo-frame: 0;
  --skin-tilt: 0deg;
  --skin-sticker-tilt: -4deg;
  --skin-press: scale(.96);
  --skin-chip-on-bg: #1F2540;
  --skin-chip-on-text: #FFFFFF;
  --skin-chip-on-border: #1F2540;
  --skin-sticker-bg: #FFD45C;
  --skin-sticker-text: #1F2540;
