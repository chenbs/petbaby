<view wx:if="{{visible}}" class="mask" catchtouchmove="noop" bindtap="handleClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <view class="sheet-title">{{title}}</view>
      <view class="sheet-close hit-area" aria-role="button" aria-label="关闭" catchtap="handleClose">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <slot></slot>
    </scroll-view>
    <view class="sheet-foot"><slot name="footer"></slot></view>
  </view>
</view>
