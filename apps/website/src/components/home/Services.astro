---
const ways = [
  { number: "01", name: "一张作品", detail: "把日常照片，做成想珍藏的海报与画册。", href: "#plays" },
  { number: "02", name: "一个新模样", detail: "走进画布、影棚与幻想，发现我的另一面。", href: "#portrait" },
  { number: "03", name: "一段小时光", detail: "让照片与音乐一起，把陪伴重新放映。", href: "#contact" },
];
---
<section class="ed-ways" id="services">
  <div class="ed-container">
    <div><p class="ed-kicker">MORE WAYS TO KEEP ME</p><h2>喜欢我，<br />有好多种方式。</h2></div>
    <div class="ed-way-list">{ways.map((way) => <a href={way.href}><span class="ed-way-number">{way.number}</span><div><h3>{way.name}</h3><p>{way.detail}</p></div><span class="ed-way-arrow" aria-hidden="true">↗</span></a>)}</div>
  </div>
</section>
