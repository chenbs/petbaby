/*
 * 图片加载态（2026-10-26）：图片下载完成前显示骨架底色的呼吸动画，load 后去掉底色并淡入。
 * 用 WXS 直接改 class，不经逻辑层 setData —— 一屏几十张图各回调一次 setData 会拖慢滚动。
 * 用法：<wxs module="img" src="../../wxs/img.wxs" />，<image class="img-load" bindload="{{img.ready}}" />
 */
function ready(event) {
  if (event.instance) event.instance.addClass("img-on");
}

module.exports = { ready: ready };
