---
/* 首页文章入口：取最新两篇，复用文章列表的卡片。没有文章时整段不渲染。 */
import PostCard from "../PostCard.astro";
import { listPosts } from "../../lib/posts";

const posts = (await listPosts()).slice(0, 2);
---

{posts.length > 0 && (
  <section class="section latest-posts" id="posts">
    <div class="container">
      <div class="section-head split reveal">
        <div>
          <p class="eyebrow">创作指南</p>
          <h2 class="h2 h2-sm">拍之前，<br />先看看这些</h2>
        </div>
        <p class="section-note"><a class="latest-posts-more" href="/blog/">全部文章 →</a></p>
      </div>
      <div class="post-grid latest-post-grid reveal">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
)}
