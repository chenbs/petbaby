---
import ResponsiveImage from "../ResponsiveImage.astro";
const styles = [
  { image: "style-warm-film", name: "日光胶片", alt: "日光与蓝天里的橘白猫胶片摄影" },
  { image: "style-paper-cut", name: "纸上奇遇", alt: "彩色纸艺花园中的橘白猫" },
  { image: "style-studio", name: "影棚肖像", alt: "粉蓝影棚里橘白猫的艺术肖像" },
  { image: "style-fantasy", name: "云端来信", alt: "梦幻云朵和月亮中的橘白猫" },
  { image: "play-portrait", name: "画中缪斯", alt: "橘白猫的当代绘画肖像" },
  { image: "play-storybook", name: "绘本主角", alt: "橘白猫在绘本花园里探险" },
  { image: "play-magazine", name: "封面明星", alt: "橘白猫的 MUSE 时尚杂志封面" },
];
const works = [
  { image: "work-ragdoll", w: 900, h: 1200, name: "布偶猫", mood: "蓝色的温柔", category: "cat" },
  { image: "work-golden", w: 900, h: 1200, name: "金毛犬", mood: "阳光是我的偏爱", category: "dog" },
  { image: "work-devon", w: 1600, h: 1200, name: "德文卷毛猫", mood: "小小的时髦精", category: "cat" },
  { image: "work-maine", w: 1200, h: 1200, name: "缅因猫", mood: "温柔的巨人", category: "cat" },
  { image: "work-poodle", w: 1200, h: 1200, name: "泰迪", mood: "像一颗棉花糖", category: "dog" },
  { image: "work-border", w: 900, h: 1200, name: "边境牧羊犬", mood: "眼里有星星", category: "dog" },
  { image: "work-abyssinian", w: 900, h: 1200, name: "阿比西尼亚猫", mood: "风里的小精灵", category: "cat" },
  { image: "work-dragonli", w: 900, h: 1200, name: "田园狸花猫", mood: "身边的宝藏", category: "cat" },
  { image: "work-shepherd", w: 1600, h: 1200, name: "德国牧羊犬", mood: "可靠又可爱", category: "dog" },
  { image: "work-shiba", w: 900, h: 1200, name: "柴犬", mood: "把笑容交给你", category: "dog" },
  { image: "work-mixed", w: 900, h: 1200, name: "中华田园犬", mood: "独一无二的我", category: "dog" },
];
---
<section class="ed-section ed-works" id="works">
  <div class="ed-container">
    <div class="ed-section-head">
      <div><p class="ed-kicker">03 / THE LITTLE MUSE COLLECTION</p><h2>我的可爱，<br />不止一种打开方式。</h2></div>
      <p class="ed-section-note">同一只橘白猫，七场小小的梦。<br />今天，想把我留在哪个世界？</p>
    </div>
    <div class="ed-style-strip" role="region" aria-label="七种创意风格，可横向滚动" tabindex="0">
      {styles.map((style, index) => <figure><div><ResponsiveImage src={`/assets/${style.image}.jpg`} alt={style.alt} width={900} height={1200} sizes="(max-width: 767px) 56vw, 240px" /></div><figcaption><span>{style.name}</span><span>0{index + 1}</span></figcaption></figure>)}
    </div>
    <div class="ed-gallery-head">
      <div><p class="ed-kicker">EVERY LITTLE FACE, A LITTLE MASTERPIECE</p><h3>每一张小脸，都值得被偏爱。</h3></div>
      <div class="ed-filters" role="group" aria-label="按宠物类型筛选作品" hidden data-gallery-filters>
        <button type="button" aria-pressed="true" data-filter="all" aria-controls="pet-gallery">全部</button>
        <button type="button" aria-pressed="false" data-filter="cat" aria-controls="pet-gallery">猫咪</button>
        <button type="button" aria-pressed="false" data-filter="dog" aria-controls="pet-gallery">狗狗</button>
      </div>
    </div>
    <p class="ed-gallery-status" aria-live="polite" data-gallery-status>11 位可爱主角 · AI 创意示例</p>
    <div class="ed-gallery" id="pet-gallery">
      {works.map((work) => <figure class="ed-work" data-category={work.category}>
        <div class="ed-work-image"><ResponsiveImage src={`/assets/${work.image}.jpg`} alt={work.name + "艺术摄影示例：" + work.mood} width={work.w} height={work.h} sizes="(max-width: 767px) 44vw, 30vw" /></div>
        <figcaption><span>{work.name}</span><span>{work.mood}</span></figcaption>
      </figure>)}
    </div>
    <p class="ed-fineprint ed-gallery-note">这些画面是关于可爱的创意想象，由 AI 生成；实际可选模板与成品效果以小程序内展示为准。</p>
  </div>
</section>
<script>
  const filters = document.querySelector<HTMLElement>("[data-gallery-filters]");
  const cards = document.querySelectorAll<HTMLElement>("[data-category]");
  const status = document.querySelector<HTMLElement>("[data-gallery-status]");
  if (filters && status) {
    filters.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        filters.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((filter) => {
          filter.setAttribute("aria-pressed", String(filter === button));
        });
        let visible = 0;
        cards.forEach((card) => {
          card.hidden = button.dataset.filter !== "all" && card.dataset.category !== button.dataset.filter;
          if (!card.hidden) visible += 1;
        });
        status.textContent = `${visible} 位可爱主角 · AI 创意示例`;
      });
    });
  }
</script>
