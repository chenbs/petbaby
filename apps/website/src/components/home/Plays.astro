---
import ResponsiveImage from "../ResponsiveImage.astro";
const plays = [
  { image: "play-id-card", title: "给我的可爱，一个名字。", name: "宠物身份证", body: "名字、生日和小小个性，装进一张属于我的专属名片。", alt: "粉蓝背景上的橘白猫宠物身份证艺术示例" },
  { image: "play-poster", title: "这一次，我是主角。", name: "宠物电影海报", body: "一张随手拍，也能变成值得贴在墙上的主角海报。", alt: "珊瑚色场景中的宠物电影海报艺术示例" },
  { image: "play-album", title: "把我们的日子，慢慢翻。", name: "宠物时光画册", body: "把散落的照片排成一册，让普通的小事也有自己的页码。", alt: "明亮自然光下摊开的宠物时光画册艺术示例" },
];
---
<section class="ed-section" id="plays">
  <div class="ed-container">
    <div class="ed-section-head">
      <div><p class="ed-kicker">01 / EVERYDAY, EXTRAORDINARY</p><h2>平常的我，<br />也可以很不平常。</h2></div>
      <p class="ed-section-note">不必等一个特别的日子。<br />打哈欠、发呆、望向你的瞬间，<br />都值得拥有一张好看的作品。</p>
    </div>
    <div class="ed-play-grid">
      {plays.map((play, index) => <article class="ed-play">
        <a class="ed-image-link" href="#contact" aria-label={play.name + "，前往创作入口"}>
          <ResponsiveImage src={`/assets/${play.image}.jpg`} alt={play.alt} width={1600} height={1200} sizes="(max-width: 767px) 90vw, 36vw" />
          <span class="ed-image-arrow" aria-hidden="true">↗</span>
        </a>
        <div class="ed-card-label"><span>{play.name}</span><span>0{index + 1}</span></div>
        <h3>{play.title}</h3><p>{play.body}</p>
      </article>)}
    </div>
  </div>
</section>
