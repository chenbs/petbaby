/**
 * 全局样式：只做「CSS 变量 → 语义类」的映射。
 *
 * 本文件是唯一允许出现 var() 兜底字面量的地方（需求 3.4）。兜底值取 cute 主题，
 * 用于基础库低于 2.9.0（无 page-meta）或注入失败时的降级，此时整体以 cute 外观运行。
 * 其余 .wxss 一律零硬编码，由 scripts/validate.js 扫描把关。
 */
page {
  --primary: #C4335C;
  --secondary: #FFD166;
  --background: #FFF8F2;
  --surface: #FFFDFA;
  --card-background: #FFFFFF;
  --text-primary: #3A2C2C;
  --text-secondary: #7A625E;
  --border: #F3DCD5;
  --divider: #F7E7E1;
  --success: #26794E;
  --warning: #A85708;
  --error: #B8382A;
  --disabled: #D8CCC8;
  --success-surface: #E8F7EE;
  --error-surface: #FDEBE7;
  --ai-gradient-start: #C4335C;
  --ai-gradient-end: #A85708;
  --ai-glow: rgba(196, 51, 92, .32);
  --ai-gradient-angle: 120deg;
  --ai-gradient: linear-gradient(120deg, #C4335C, #A85708);
  --button-primary: #C4335C;
  --button-secondary: #FFF1E6;
  --button-disabled: #EFE4E0;
  --button-primary-text: #FFF5F7;
  --button-secondary-text: #3A2C2C;
  --button-radius: 999rpx;
  --card-radius: 24rpx;
  --card-shadow: 0 4rpx 16rpx -4rpx rgba(60, 35, 20, .1), 0 28rpx 56rpx -32rpx rgba(60, 35, 20, .26);
  --card-blur: 0;
  --card-border: 2rpx solid rgba(243, 220, 213, .9);
  --card-radius-variant: 24rpx 24rpx 48rpx 24rpx;
  --page-padding: 32rpx;
  --section-spacing: 48rpx;
  --page-bottom-safe: 180rpx;
  --nav-bar-background: #FFF8F2;
  --title-size: 48rpx;
  --body-size: 28rpx;
  --small-size: 24rpx;
  --eyebrow-size: 20rpx;
  --title-weight: 800;
  --title-letter-spacing: -0.01em;
  --transition-duration: 240ms;
  --transition-easing: cubic-bezier(.34, 1.56, .64, 1);
  --border-highlight: 0 solid transparent;
  /* 以下均为与主题无关的常量，只在此声明一次，不进注入串（真源为 theme/tokens.js 的 CONSTANT_VARS） */
  --radius-pill: 999rpx;
  /* 间距：绝对阶梯（UI 重构方案 2.1），不再由 page-padding 派生 */
  --space-0: 4rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;
  --space-7: 96rpx;
  --space-8: 128rpx;
  --page-x-wide: 48rpx;
  --gap-item: 24rpx;
  --gap-group: 48rpx;
  --gap-section: 96rpx;
  /* 圆角阶梯（方案 2.2）：卡片用 --card-radius 保留主题身份，其余按尺寸取档 */
  --radius-xs: 8rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-clay: 56rpx;
  --radius-none: 0;
  /* t-empty 线条插画的有机形状：门禁只豁免单值 50%，非对称圆角须登记为 token */
  --radius-pad: 50% 50% 46% 46%;
  --radius-head: 46% 46% 50% 50%;
  /* 行高与字重字距（方案 2.3，F 排版方法论） */
  --lh-display: 1.06;
  --lh-h1: 1.3;
  --lh-h2: 1.35;
  --lh-h3: 1.4;
  --lh-body: 1.62;
  --lh-sm: 1.6;
  --lh-xs: 1.5;
  --fw-light: 300;
  --fw-normal: 400;
  --fw-medium: 500;
  --fw-bold: 700;
  --fw-black: 800;
  --ls-tight: -0.02em;
  --ls-tighter: -0.04em;
  --ls-kicker: 0.24em;
  --ls-cover: 0.3em;
  /* 图片比例（方案 2.5） */
  --ratio-hero: 16 / 10;
  --ratio-card: 3 / 4;
  --ratio-cover: 4 / 3;
  --ratio-square: 1 / 1;
  /* 动效（方案 2.6） */
  --dur-fast: 120ms;
  --dur-base: 240ms;
  --dur-slow: 400ms;
  --dur-reveal: 900ms;
  --stagger: 40ms;
  --ease-out: cubic-bezier(.22, 1, .36, 1);
  --ease-in-out: cubic-bezier(.4, 0, .2, 1);
  --font-h2: 39rpx;
  --font-h3: 33rpx;
  --font-display: 61rpx;
  --eyebrow-tracking: 4rpx;
  /* 沉浸式玻璃面板兜底：无 page-meta 时按 cute 的降级取值（不透明抽屉） */
  --glass-background: rgba(255, 248, 242, .94);
  --glass-background-solid: #FFF8F2;
  --glass-border: 2rpx solid rgba(255, 255, 255, .55);
  --glass-blur: 0;
  --glass-radius: 48rpx 48rpx 0 0;
  --glass-shadow: 0 -12rpx 48rpx rgba(214, 150, 150, .28);
  --glass-scrim: #2A1F1F;
  --glass-scrim-max: 0.32;
  --glass-text-primary: #3A2C2C;
  --glass-text-secondary: #7A625E;
  --glass-handle: rgba(58, 44, 44, .28);
  --glass-handle-width: 64rpx;
  --glass-blur-degraded: 0;
  --glass-easing: cubic-bezier(.22, .61, .36, 1);
  /* 阴影与遮罩（方案 2.4 / 2.5）。基色为暖褐而非纯黑 —— 方案称这是廉价与高级的分水岭。
     取值必须是成品串：.wxss 不许出现 rgba(，色相拆分只能在 theme/tokens.js 里合成。 */
  --shadow-card: 0 4rpx 16rpx -4rpx rgba(60, 35, 20, .1), 0 32rpx 64rpx -36rpx rgba(60, 35, 20, .28);
  --shadow-image: 0 8rpx 24rpx -8rpx rgba(60, 35, 20, .16), 0 56rpx 96rpx -48rpx rgba(60, 35, 20, .42);
  --shadow-float: 0 16rpx 40rpx -12rpx rgba(60, 35, 20, .18), 0 64rpx 120rpx -40rpx rgba(60, 35, 20, .38);
  --shadow-press: 0 2rpx 8rpx -2rpx rgba(60, 35, 20, .14);
  --shadow-none: none;
  /* 黏土（方案 J）：后三层是常量，内高光按主题明暗单独下发。兜底取 cute 的浅卡面值。 */
  --shadow-clay-body: inset 0 10rpx 24rpx rgba(190, 140, 120, .13), 0 16rpx 32rpx -12rpx rgba(190, 140, 120, .34), 0 36rpx 68rpx -36rpx rgba(190, 140, 120, .5);
  --clay-highlight: rgba(255, 255, 255, .95);
  --shadow-clay-inset: inset 0 6rpx 18rpx rgba(58, 44, 44, .28);
  --veil-image: linear-gradient(to top, rgba(20, 10, 4, .82) 0%, rgba(20, 10, 4, .28) 45%, transparent 72%);
  --veil-vignette: radial-gradient(120% 90% at 50% 15%, transparent 35%, rgba(60, 35, 20, .34));
  /* 弹层遮罩兜底。缺了它，基础库低于 2.9.0（无 page-meta）时 t-dialog / t-popup /
     t-action-sheet 的遮罩层会完全透明 —— 弹层浮在可见内容上且点不穿，比样式错更糟。 */
  --mask: rgba(58, 44, 44, .45);
  /* 骨架屏与柔性分割线兜底：注入串里按主题明暗派生，此处取 cute 值 */
  --skeleton-base: rgba(58, 44, 44, .06);
  --skeleton-shine: rgba(255, 255, 255, .55);
  --divider-soft: rgba(58, 44, 44, .06);
  --glass-duration: 360ms;

  background: var(--background, #FFF8F2);
  color: var(--text-primary, #3A2C2C);
  font-family: sans-serif;
  font-size: var(--body-size, 28rpx);
  transition: background var(--transition-duration, 240ms) var(--transition-easing, ease), color var(--transition-duration, 240ms) var(--transition-easing, ease);
}

/* ---------- 页面骨架 ---------- */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--page-padding) var(--page-padding) var(--page-bottom-safe);
  background: var(--background);
}

.page-flat {
  padding-bottom: var(--space-6);
}

.page-tabbar {
  padding-bottom: calc(var(--page-bottom-safe) + env(safe-area-inset-bottom));
}

.section {
  margin-top: var(--section-spacing);
}

.section:first-child {
  margin-top: 0;
}

.stack {
  display: grid;
  gap: var(--space-4);
}

.stack-tight {
  display: grid;
  gap: var(--space-2);
}

/* ---------- 文本层级 ---------- */
.eyebrow {
  display: block;
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--eyebrow-tracking);
  text-transform: uppercase;
}

.title {
  margin: var(--space-3) 0 var(--space-3);
  color: var(--text-primary);
  font-size: var(--title-size);
  font-weight: var(--title-weight);
  letter-spacing: var(--title-letter-spacing);
  line-height: 1.2;
}

.section-title {
  margin: 0 0 var(--space-4);
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--title-weight);
}

.sub-title {
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: 700;
}

.muted {
  color: var(--text-secondary);
  font-size: var(--body-size);
  line-height: 1.7;
}

.small {
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 1.6;
}

.strong {
  color: var(--text-primary);
  font-weight: 700;
}

.accent {
  color: var(--primary);
}

.danger-text {
  color: var(--error);
}

.center {
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.divider-line {
  height: 2rpx;
  background: var(--divider);
}

/* ---------- 表面 ---------- */
.surface {
  background: var(--surface);
  border-radius: var(--card-radius);
}

.hit-area {
  min-width: 88rpx;
  min-height: 88rpx;
}

/* ---------- 玻璃面板内的文本层级 ----------
 * slot 内容归页面作用域，因此这组类必须是全局的，不能放在 glass-sheet 组件内。
 * 面板的合成背景与页面底不同，故不复用 --text-primary / --text-secondary。 */
.glass-title {
  margin: 0;
  color: var(--glass-text-primary);
  font-size: var(--title-size);
  font-weight: var(--title-weight);
  letter-spacing: var(--title-letter-spacing);
  line-height: 1.2;
}

.glass-sub-title {
  color: var(--glass-text-primary);
  font-size: var(--font-h3);
  font-weight: 700;
}

.glass-strong {
  color: var(--glass-text-primary);
  font-weight: 700;
}

.glass-muted {
  color: var(--glass-text-secondary);
  font-size: var(--body-size);
  line-height: 1.7;
}

.glass-small {
  color: var(--glass-text-secondary);
  font-size: var(--small-size);
  line-height: 1.6;
}

.glass-eyebrow {
  display: block;
  color: var(--glass-text-secondary);
  font-size: var(--eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--eyebrow-tracking);
  text-transform: uppercase;
}

/* glassBorder 是描边简写而非纯色，故分隔线走 border-top 而不是 background */
.glass-divider {
  border-top: var(--glass-border);
}

/*
 * 玻璃面板内的分段间距。原先只在 ai-run 里定义，create 的 C 表单变体也要用，
 * 与其在两页各写一份，不如与其他 glass-* 一起放在全局。
 */
.section-block {
  margin-top: var(--space-5);
}

/*
 * ---------- 选项 chip（≤4 个选项平铺，不用 picker） ----------
 *
 * 2026-08-03 从 ai-create.wxss 提到全局：pages/pets 的四个枚举
 * （种类 3 / 性别 3 / 日期类型 2 / 生命阶段 3）也改用 chip。
 *
 * picker 要多一次弹层交互才能看全部选项，4 个以内平铺能一眼比较；
 * 超过 4 个仍走 picker。见 CLAUDE.md 的 UI 重构约定。
 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chip {
  min-height: 72rpx;
  padding: var(--space-2) var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 44rpx;
  transition: border-color var(--transition-duration) var(--transition-easing), color var(--transition-duration) var(--transition-easing);
}

.chip-hover {
  opacity: .85;
}

.chip-on {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--button-primary-text);
  font-weight: 700;
}

/*
 * 表单项下方的补充说明。原先靠 t-field 的 help 属性承载，
 * 四个枚举改 chip 后不再经过 t-field，需要一个独立的说明样式。
 */
.hint {
  display: block;
  margin-top: var(--space-2);
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: 40rpx;
}

/*
 * ---------- 里程碑石碑 ----------
 *
 * 2026-08-06 从 pages/timeline/timeline.wxss 提到全局：岛日记页也要列
 * 「已经走过」（22 号文 4.2 的里程碑 100/365/1000）。
 *
 * 提而不复制，与 `.chip` / `.hint` 同一处理（CLAUDE.md 的 UI 重构约定：
 * 第二处要用时把它提到 app.wxss 再共用，别复制一份）—— 里程碑文案两处必须
 * 逐字一致，样式跟着走散会让同一个「第 365 天」在两页长得不一样。
 */
.stones {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.stone {
  padding: var(--space-3) var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.stone-label {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
  letter-spacing: var(--ls-tight);
}

/* ---------- 点击反馈（由 animationType 决定，见 .anim-* 修饰） ---------- */
.tappable {
  transition: transform var(--transition-duration) var(--transition-easing), opacity var(--transition-duration) var(--transition-easing), box-shadow var(--transition-duration) var(--transition-easing);
}

.tappable.anim-bounce:active {
  transform: scale(.96);
}

.tappable.anim-fade:active {
  opacity: .85;
}

.tappable.anim-glow:active {
  box-shadow: 0 0 32rpx var(--ai-glow);
}

.tappable.anim-neon:active {
  box-shadow: 0 0 0 2rpx var(--primary), 0 0 28rpx var(--ai-glow);
}
