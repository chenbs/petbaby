<page-meta page-style="{{themeStyle}}"></page-meta>

<t-navbar
  title="AI 任务与候选"
></t-navbar>

<!-- 已选中候选：结果确认区改为沉浸式，选中图占满全屏 -->
<t-glass-sheet
  wx:if="{{immersive}}"
  class="art-brand layout-canvas"
  background-image="{{selectedUrl}}"
  framed
  title="确认这一张"
  state="half"
  blur="{{blurOk}}"
  anim="{{animType}}"
  bindbackgrounderror="onBackgroundError"
>
  <view slot="header">
    <text class="glass-eyebrow">已选中</text>
    <view class="glass-title run-title">确认这一张</view>
    <text class="glass-muted">{{humanMode ? '解锁只对这一张生效。' : '解锁只对这一张生效，重抽会作废当前选择。'}}</text>
  </view>

  <t-notice wx:if="{{message}}" type="{{messageType}}" message="{{message}}" class="block-gap"></t-notice>

  <view wx:if="{{run.selectedUnlocked}}" class="section-block">
    <view class="glass-sub-title">已解锁</view>
    <view class="share-actions">
      <t-button type="primary" block anim="{{animType}}" loading="{{busy}}" bindtap="save">保存高清图到相册</t-button>
      <t-button type="secondary" block anim="{{animType}}" bindtap="share">创建 7 天分享链接</t-button>
      <t-button type="ghost" block anim="{{animType}}" bindtap="openWork">查看作品档案</t-button>
    </view>
  </view>

  <view slot="actions">
    <t-button type="ai" block anim="{{animType}}" disabled="{{run.selectedUnlocked}}" loading="{{busy}}" bindtap="unlock">
      {{run.order && run.order.status === 'pending' ? '继续支付解锁' : '解锁选中的这张'}}
    </t-button>
    <t-button wx:if="{{!humanMode}}" type="secondary" block anim="{{animType}}" class="block-gap" disabled="{{!run.rerollRemaining || run.workId}}" bindtap="reroll">重抽一组（剩 {{run.rerollRemaining}} 次）</t-button>
  </view>
</t-glass-sheet>

<view wx:else class="page page-flat art-brand layout-workbench">
  <t-skeleton wx:if="{{loading}}" type="card" count="2"></t-skeleton>

  <block wx:elif="{{run}}">
    <view wx:if="{{run.status !== 'queued' && run.status !== 'processing'}}" class="row">
      <text class="eyebrow">从 {{run.candidates.length || 2}} 张中选 1 张</text>
      <t-tag tone="{{run.status === 'failed' ? 'error' : run.status === 'succeeded' ? 'success' : 'accent'}}" size="mini" text="{{statusText}}"></t-tag>
    </view>
    <view wx:if="{{run.status !== 'queued' && run.status !== 'processing'}}" class="title">{{run.status === 'succeeded' ? '挑一张最像它的' : 'AI 任务状态'}}</view>

    <t-notice wx:if="{{message}}" type="{{messageType}}" message="{{message}}" class="block-gap"></t-notice>

    <!-- 排队/生成中 -->
    <view wx:if="{{run.status === 'queued' || run.status === 'processing'}}" class="run-pending">
      <view class="pending-image" aria-role="img" aria-label="作品正在生成">
        <view class="pending-image-inner">2 张<text>候选正在准备</text></view>
      </view>
      <view class="pending-status">{{run.status === 'queued' ? '正在排队，第 ' + (run.queuePosition || 1) + ' 位' : '正在为它生成作品'}}</view>
      <text class="muted center block">{{run.status === 'queued' ? '预计 ' + (run.estimatedSeconds || 20) + ' 秒' : '可以先退出，完成后在作品柜查看'}}</text>
      <t-loading anim="{{animType}}" label="{{statusText}}"></t-loading>
      <t-button type="ghost" block anim="{{animType}}" class="block-gap" bindtap="askCancel">取消任务</t-button>
    </view>

    <!-- 失败 -->
    <t-card wx:elif="{{run.status === 'failed'}}" blur="{{blurOk}}" anim="{{animType}}">
      <view class="state-title">生成没有完成</view>
      <text class="muted">额度已经返还。可以直接重试，用同样的照片和描述再跑一次。</text>
      <text wx:if="{{run.errorCode}}" class="small">错误码 {{run.errorCode}}</text>
      <t-button type="primary" block anim="{{animType}}" loading="{{busy}}" class="block-gap" bindtap="retry">重试一次</t-button>
    </t-card>

    <!-- 已取消 -->
    <t-card wx:elif="{{run.status === 'cancelled'}}" blur="{{blurOk}}" anim="{{animType}}">
      <view class="state-title">任务已取消</view>
      <text class="muted">没有产生订单，也没有扣减额度。</text>
    </t-card>

    <!-- 候选比较：所有新任务二选一，历史四候选任务仍可显示。 -->
    <block wx:else>
      <view class="section">
        <view class="candidates {{humanMode ? 'candidates-human' : ''}}">
          <view
            wx:for="{{candidates}}"
            wx:key="id"
            class="candidate {{run.selectedId === item.id ? 'candidate-on' : ''}}"
            data-id="{{item.id}}"
            aria-role="radio"
            aria-checked="{{run.selectedId === item.id}}"
            hover-class="candidate-hover"
            bindtap="select"
          >
            <image wx:if="{{!item.imageFailed}}" class="candidate-image" src="{{item.url}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{item.url}}" binderror="onCandidateImageError" lazy-load />
            <view wx:else class="candidate-image candidate-image-blank">候选图片暂不可用</view>
            <view class="candidate-foot">
              <text class="small strong">0{{item.number}}</text>
              <t-tag wx:if="{{run.selectedId === item.id}}" tone="success" size="mini" text="已选中"></t-tag>
            </view>
          </view>
        </view>
        <text wx:if="{{!humanMode}}" class="small">还能重抽 {{run.rerollRemaining}} 次</text>
      </view>

      <view class="actions">
        <t-button type="ai" block anim="{{animType}}" disabled="{{!run.selectedId || run.selectedUnlocked}}" loading="{{busy}}" bindtap="unlock">
          {{run.order && run.order.status === 'pending' ? '继续支付解锁' : '解锁选中的这张'}}
        </t-button>
        <view wx:if="{{!humanMode}}" class="chips">
          <view wx:for="{{rerollReasons}}" wx:key="id" class="chip {{rerollReason === item.id ? 'chip-on' : ''}}" data-id="{{item.id}}" hover-class="chip-hover" bindtap="chooseRerollReason">{{item.label}}</view>
        </view>
        <t-button wx:if="{{!humanMode}}" type="secondary" block anim="{{animType}}" disabled="{{!run.rerollRemaining || run.workId}}" bindtap="reroll">重抽一组（剩 {{run.rerollRemaining}} 次）</t-button>
      </view>
    </block>
  </block>

  <t-notice wx:else type="error" message="{{message || '任务不存在'}}"></t-notice>
</view>

<t-dialog
  visible="{{confirmCancel}}"
  title="取消这次生成？"
  content="已经排进队列的任务会立刻停止，免费额度原样返还。"
  confirm-text="取消任务"
  danger
  anim="{{animType}}"
  bindconfirm="cancel"
  bindcancel="dismissCancel"
></t-dialog>
