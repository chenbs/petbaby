.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

.block {
  display: block;
}

.warn {
  color: var(--warning);
  font-weight: 700;
}

.divider-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-4);
  padding: var(--space-4) 0;
  border-bottom: 2rpx solid var(--divider);
}

.stage-progress {
  color: var(--text-primary);
  font-size: var(--title-size);
  font-weight: var(--title-weight);
  text-align: center;
}

.upload-line {
  margin-top: var(--space-4);
  padding-top: var(--space-4);
  border-top: 2rpx solid var(--divider);
}

/*
 * 成品图容器：--shadow-clay-inset 让写实照片「嵌进」黏土表面（方案 J 落地要点）。
 * 少了这层内阴影，卡通质感的容器与真实照片会明显割裂，像贴上去的。
 * 内边距留出一圈黏土边，否则图片盖满容器就看不到底座材质了。
 */
.result-frame {
  overflow: hidden;
  padding: var(--space-3);
  border-radius: var(--radius-clay);
}

.result-image {
  display: block;
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-clay-inset);
}

.result-copy {
  padding: var(--space-4) 0 0;
}
