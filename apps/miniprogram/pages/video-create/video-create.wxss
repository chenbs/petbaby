.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

.video-sample {
  position: relative;
  overflow: hidden;
  aspect-ratio: var(--ratio-hero);
  margin-top: var(--space-3);
  border-radius: var(--radius-image-hero);
  background: var(--surface);
}

.video-sample-image {
  display: block;
  width: 100%;
  height: 100%;
}

.video-sample-label {
  position: absolute;
  right: var(--space-2);
  bottom: var(--space-2);
  padding: var(--space-2);
  border-radius: var(--radius-image-thumb);
  background: var(--background);
  color: var(--text-primary);
  font-size: var(--small-size);
}

.video-pet {
  margin-top: var(--space-4);
}

.photos-section {
  margin-top: var(--space-5);
}

.video-fields {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.video-price {
  display: block;
  margin-top: var(--space-5);
}

.bgm {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.bgm-option {
  padding: var(--space-4) var(--space-3);
  border: 2rpx solid var(--border);
  border-radius: var(--card-radius);
  background: var(--surface);
  text-align: center;
  transition: border-color var(--transition-duration) var(--transition-easing), transform var(--transition-duration) var(--transition-easing);
}

.bgm-hover {
  transform: scale(.97);
}

.bgm-on {
  border-color: var(--primary);
  background: var(--card-background);
  box-shadow: 0 0 0 4rpx var(--ai-glow);
}

.bgm-name {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: 700;
}
