<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="page page-tabbar art-film layout-pet">
  <t-skeleton wx:if="{{petLoading}}" type="card" count="1"></t-skeleton>
  <view wx:if="{{recordError}}" class="section">
    <t-notice type="error" message="{{recordError}}"></t-notice>
    <t-button bindtap="loadPet">重新加载记录</t-button>
  </view>
  <picker wx:if="{{pets.length > 1}}" range="{{pets}}" range-key="name" bindchange="choosePet">
    <view class="small hit-area">当前宠物：{{pet.name || '请选择'}} · 切换</view>
  </picker>
  <!--
    第一屏是**宠物**而不是货架（改造项 E1）。
    20 号文 2.2：情绪价值不是内容问题而是分发问题 —— 服务端 8 项能力全建成，
    而原首页全文 0 处出现宠物或陪伴字样。玩法列表下移到第二屏。

    没有宠物时整块不出现，退回原来的标语 Hero —— 空占位比不占位更差。
  -->
  <!--
    主题切换入口在有宠物时移到这一行。原先它挂在标语 Hero 的右上角，
    而那块 Hero 现在只在「没有宠物」时出现 —— 不挪的话老用户就再也找不到换肤入口。
  -->
  <view wx:if="{{pet}}" class="hero-top">
    <text class="eyebrow">{{pet.name}}的日常</text>
    <view class="hero-theme hit-area" aria-role="button" aria-label="切换外观主题" bindtap="openTheme">◑</view>
  </view>

  <view wx:if="{{pet}}" class="pet-feature" aria-role="button" aria-label="查看{{pet.name}}的时间线" hover-class="pet-feature-hover" bindtap="openTimeline">
    <view class="pet-media {{petDisplayUrl ? '' : 'pet-media-empty'}}">
      <image wx:if="{{petDisplayUrl}}" class="pet-image" src="{{petDisplayUrl}}" mode="aspectFit" data-kind="pet" data-src="{{petDisplayUrl}}" binderror="onImageError" />
      <view wx:else class="pet-image example-image">
        <image class="pet-image" src="{{introSampleUrl}}" mode="aspectFit" />
        <text class="example-label">示例作品 · 上传后换成{{pet.name}}的照片</text>
      </view>
    </view>
    <view class="pet-caption">
      <view class="pet-identity"><view class="pet-name">{{pet.name}}</view><text class="pet-hint">看时间线 →</text></view>
      <text class="pet-days">{{pet.companionText}}</text>
    </view>
  </view>

  <view wx:if="{{!pet && !petLoading && !recordError}}" class="empty-intro">
    <view class="hero-top">
      <text class="eyebrow">从第一张照片开始</text>
      <view class="hero-theme hit-area" aria-role="button" aria-label="切换外观主题" bindtap="openTheme">◑</view>
    </view>
    <view class="intro-preview">
      <image class="intro-image" src="{{introSampleUrl}}" mode="aspectFit" />
      <text class="example-label">示例作品 · 上传后换成你的宠物</text>
    </view>
    <view class="title hero-title">从它的第一张照片开始</view>
    <text class="muted">上传照片后，这里会出现它的封面和陪伴日常。</text>
  </view>

  <view wx:if="{{!petLoading && !recordError}}" class="section">
    <t-button block bindtap="record">{{recordAction}}</t-button>
  </view>
  <view wx:if="{{featuredTemplates.length}}" class="section">
    <view class="section-title">更多好玩的出片方式</view>
    <view class="cards featured-cards">
      <view wx:for="{{featuredTemplates}}" wx:key="templateId" class="featured-item {{item.sampleShape === 'wide' ? 'featured-wide' : ''}}" data-entry="{{item.entryId}}" data-template="{{item.templateId}}" aria-role="button" aria-label="查看{{item.title}}" bindtap="startTemplate">
        <image class="featured-image {{item.sampleShape === 'wide' ? 'featured-image-wide' : ''}}" src="{{item.sampleUrl}}" mode="aspectFit" lazy-load />
        <view class="featured-name">{{item.title}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{recent.length}}" class="section">
    <view class="section-title">最近收好</view>
    <view wx:for="{{recent}}" wx:key="id" class="memory block-gap" data-id="{{item.id}}" bindtap="recentDetail">
      <image wx:if="{{item.url}}" class="memory-photo" src="{{item.url}}" mode="aspectFill" data-kind="recent" data-id="{{item.id}}" data-src="{{item.url}}" binderror="onImageError" />
      <view wx:else class="memory-photo memory-photo-blank">照片暂不可用</view>
      <view class="memory-copy"><text class="small">{{item.savedOn}} 收好</text><view>{{item.recordedDate}}</view><text class="small">{{item.sourceText}}</text><text wx:if="{{item.imageError}}" class="small">{{item.imageError}}</text></view>
    </view>
  </view>
  <!--
    今天刚达成的里程碑（E3）。**只在当天出现一次**：
    里程碑是一个瞬间而不是一种状态，常驻会让它变成又一个货架标签。
    已达成的历史里程碑在时间线页列出，那里才是回看的地方。
  -->
  <view wx:if="{{milestone}}" class="section">
    <view class="milestone-row" aria-role="button" bindtap="openTimeline">
      <view class="stone-main">
        <text class="eyebrow">今天</text>
        <view class="sub-title">{{milestone}}</view>
      </view>
      <text class="small">回看 →</text>
    </view>
  </view>

  <!--
    去年今日（E4）。Web 首页早有这一块，小程序没有 —— 而小程序是主端。
    命中才渲染，没命中整块静默隐藏，不写「今天没有回忆」。
  -->
  <view wx:if="{{onThisDay}}" class="section">
    <view class="memory" aria-role="button" bindtap="openOnThisDay">
      <image wx:if="{{onThisDay.photo.url}}" class="memory-photo" src="{{onThisDay.photo.url}}" mode="aspectFill" data-kind="on-this-day" data-src="{{onThisDay.photo.url}}" binderror="onImageError" lazy-load />
      <view wx:else class="memory-photo memory-photo-blank">照片暂不可用</view>
      <view class="memory-copy">
        <text class="eyebrow">{{onThisDay.eyebrow}}</text>
        <view class="sub-title">{{onThisDay.petName}}的第 {{onThisDay.day}} 天</view>
        <text class="small">{{onThisDay.date}} 拍下的<block wx:if="{{onThisDayMore}}">，还有另外 {{onThisDayMore}} 张</block>。</text>
      </view>
    </view>
  </view>

  <view class="section fun-teaser" bindtap="openFunTests" aria-role="button" aria-label="打开宠物趣味测试">
    <image src="/assets/fun-tests/personality.jpg" mode="aspectFill" lazy-load />
    <view><text class="eyebrow">NEW · 免费趣测</text><view class="sub-title">它的小秘密，你最懂</view><text class="small">4 份轻松测试 · 结果可分享</text></view>
    <text class="fun-teaser-arrow">→</text>
  </view>

  <view class="section">
    <view class="section-title">{{pet && recent.length ? '把这些日子做成作品' : '看看作品玩法'}}</view>

    <t-skeleton wx:if="{{loading}}" type="card" count="3"></t-skeleton>

    <t-notice wx:elif="{{error}}" type="error" message="{{error}}"></t-notice>

    <t-empty
      wx:elif="{{!plugins.length}}"
      icon="work"
      title="玩法正在上架"
      description="稍后回来看看，新的玩法马上就位。"
      action-text="重新加载"
      anim="{{animType}}"
      decor="{{decor}}"
      bindaction="load"
    ></t-empty>

    <block wx:else>
      <t-card
        wx:if="{{heroPlugin}}"
        variant="flat"
        clickable
        padded="{{false}}"
        blur="{{false}}"
        anim="{{animType}}"
        data-id="{{heroPlugin.id}}"
        data-category="{{heroPlugin.category}}"
        bindtap="start"
      >
        <view class="hero-media">
          <image class="hero-image" src="{{heroPlugin.samples.heroUrl}}" mode="aspectFill" data-kind="hero" data-id="{{heroPlugin.id}}" data-src="{{heroPlugin.samples.heroUrl}}" binderror="onImageError" lazy-load />
        </view>
        <view class="play-head"><view class="hero-name">{{heroPlugin.name}}</view><text class="play-price">{{heroPlugin.pricing.unlockPrice ? '解锁 ¥' + heroPlugin.pricing.unlockPrice : '免费体验'}}</text></view>
        <text class="hero-tagline">{{heroPlugin.tagline}}</text>
      </t-card>

      <view class="cards">
        <t-card
          wx:for="{{gridPlugins}}"
          wx:key="id"
          variant="{{item.samples.heroUrl ? 'flat' : 'plain'}}"
          clickable
          padded="{{!item.samples.heroUrl}}"
          blur="{{blurOk}}"
          anim="{{animType}}"
          data-id="{{item.id}}"
          data-category="{{item.category}}"
          bindtap="start"
        >
          <!-- 有样例图走图卡；没有的仍用文字卡 -->
          <view wx:if="{{item.samples.heroUrl}}" class="grid-media">
            <image class="grid-image" src="{{item.samples.heroUrl}}" mode="aspectFill" data-kind="grid" data-id="{{item.id}}" data-src="{{item.samples.heroUrl}}" binderror="onImageError" lazy-load />
          </view>
          <view wx:if="{{item.samples.heroUrl}}" class="grid-copy"><view class="grid-name">{{item.name}}</view><text class="grid-price">{{item.pricing.unlockPrice ? '¥' + item.pricing.unlockPrice : '免费'}}</text></view>
          <block wx:else>
            <view class="card-top">
              <text class="small strong">{{item.code}}</text>
              <t-tag tone="{{item.pricing.unlockPrice ? 'accent' : 'success'}}" size="mini" text="{{item.pricing.unlockPrice ? '¥' + item.pricing.unlockPrice : '免费'}}"></t-tag>
            </view>
            <view class="card-title">{{item.name}}</view>
            <text class="muted">{{item.tagline}}</text>
            <view class="card-foot">开始制作 →</view>
          </block>
        </t-card>
      </view>
    </block>
  </view>
</view>
