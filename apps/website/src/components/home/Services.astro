---
/* 4. 服务导航：3 张入口卡。nav-grid 768 直接三列，无两列态（三项一组两列会留孤项）。 */
const CARDS = [
  {
    href: "/#plays",
    icon: "M4 5h16v14H4zM4 10h16M9 10v9",
    title: "图文创作",
    body: "身份证、电影海报、时光画册、成长对比图。排版与配色成套给到，不用自己拼。",
    cta: "看图文玩法",
  },
  {
    href: "/#portrait",
    icon: "M12 3l2.2 5.6L20 10l-5.8 1.4L12 17l-2.2-5.6L4 10l5.8-1.4z",
    title: "AI 肖像",
    body: "四种气质预设一次出四张候选，挑中意的那张继续放大。风格是选的，不是描述的。",
    cta: "看 AI 肖像",
  },
  {
    href: "/#memorial",
    icon: "M4 6h11l5 4-5 4H4zM4 18h9",
    title: "视频短片",
    body: "照片、字幕与音乐剪成 10 / 20 / 30 秒竖屏短片，先预览再决定要不要高清。",
    cta: "看视频玩法",
  },
];
---

<section class="band section" id="services">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">三类玩法</p>
      <h2 class="h2">从一张照片<br />到一整套作品</h2>
      <p class="section-note wide">
        图文类靠排版，AI 类靠模型，视频类靠时间线。三条路径的输入都只是手机里的日常照片。
      </p>
    </div>

    <div class="grid-3 nav-grid">
      {
        CARDS.map((card, index) => (
          <a class="nav-card reveal" data-delay={index > 0 ? String(index) : null} href={card.href}>
            <span class="nav-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={card.icon} /></svg>
            </span>
            <h3 class="h3">{card.title}</h3>
            <p class="body-text">{card.body}</p>
            <span class="link-arrow">{card.cta}
              <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
