.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

.block {
  display: block;
}

.creation-page {
  padding-bottom: calc(var(--page-bottom-safe) + var(--space-8) + env(safe-area-inset-bottom));
}

.creation-header {
  display: grid;
  gap: var(--space-2);
}

.creation-header .title {
  margin: 0;
}

.creation-sample {
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-hero);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-image-hero);
  background: var(--surface);
}
.sample-summary { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 2rpx solid var(--divider-soft); }
.sample-summary .sub-title { flex: 1; margin: 0; }
.sample-change { color: var(--primary); font-size: var(--small-size); font-weight: var(--fw-bold); }

.creation-fields {
  display: grid;
  gap: var(--space-4);
  margin-top: var(--space-3);
}

.sample-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
  margin-top: var(--space-3);
}

.sample-option {
  min-width: 0;
}

.sample-option-featured { grid-column: span 2; }

.sample-option-image {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}

.sample-option-featured .sample-option-image { height: 430rpx; }

.sample-image-wrap { position: relative; overflow: hidden; border: 4rpx solid transparent; border-radius: var(--radius-image-thumb); background: var(--surface); }
.sample-option-on .sample-image-wrap { border-color: var(--primary); }

.sample-option-name {
  padding-top: var(--space-2);
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
}

.sample-option-note { display: block; padding: var(--space-1) 0 var(--space-3); color: var(--text-secondary); font-size: var(--small-size); }

.sample-check { position: absolute; right: var(--space-1); bottom: var(--space-1); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--button-primary); color: var(--button-primary-text); font-size: var(--eyebrow-size); }

.creation-price {
  display: grid;
  gap: var(--space-1);
  margin-top: var(--space-3);
  padding: var(--space-4) 0;
  border-top: 2rpx solid var(--divider-soft);
}

.creation-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: var(--space-3) var(--page-padding) calc(var(--space-3) + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--divider-soft);
  background: var(--background);
}

.warn {
  color: var(--warning);
  font-weight: 700;
}

.divider-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-4);
  padding: var(--space-4) 0;
  border-bottom: 2rpx solid var(--divider);
}

.creation-pending {
  display: grid;
  min-height: 70vh;
  align-content: center;
  justify-items: center;
  gap: var(--space-3);
}

.creation-pending-preview {
  display: flex;
  width: 56%;
  aspect-ratio: var(--ratio-card);
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-4);
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
  color: var(--secondary);
  font-size: var(--font-h2);
  font-weight: var(--fw-bold);
}

.upload-line {
  margin-top: var(--space-4);
  padding-top: var(--space-4);
  border-top: 2rpx solid var(--divider);
}

.result-frame {
  overflow: hidden;
  border-radius: var(--radius-image-hero);
  background: var(--surface);
}

.result-image {
  display: block;
  width: 100%;
  border-radius: var(--radius-image-hero);
}

.result-image-blank {
  display: flex;
  box-sizing: border-box;
  aspect-ratio: var(--ratio-card);
  align-items: center;
  justify-content: center;
  padding: var(--space-5);
  background: var(--surface);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

.result-copy {
  padding: var(--space-4) 0 0;
}
