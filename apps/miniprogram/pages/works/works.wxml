<page-meta page-style="{{themeStyle}}"></page-meta>

<!--
  作品柜（2026-09 改版；2026-10 按 prototype.html after-works 对齐）：
  chip 带计数 → 进行中横滑（缩略图 + 进度条）→ 按月分组的双列瀑布流。
  写真套餐成片是 2×2 拼图卡，趣测结果是贴纸色卡，和作品混排在同一个瀑布流里。
  作品图用 widthFix 按原图比例显示，不裁切。
-->
<view class="{{skinClass}} page page-tabbar art-brand layout-matrix works-page">
  <scroll-view class="works-tabs chip-scroll" scroll-x show-scrollbar="{{false}}"><view class="chip-track">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="chip {{tab === item.id ? 'chip-on' : ''}}"
      data-id="{{item.id}}"
      aria-role="tab"
      aria-selected="{{tab === item.id}}"
      hover-class="chip-hover"
      bindtap="chooseTab"
    >{{item.label}}<text wx:if="{{counts[item.id]}}" class="chip-count"> {{counts[item.id]}}</text></view>
  </view></scroll-view>

  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>

  <t-skeleton wx:if="{{loading}}" type="list" count="4" class="block-gap"></t-skeleton>
  <t-button wx:elif="{{error}}" type="secondary" bindtap="load">重新加载作品</t-button>

  <block wx:else>
    <!-- 进行中：普通生成、独立制作、写真套餐、短片草稿都在这里，点击回到对应页面 -->
    <view wx:if="{{progress.length}}" class="works-section">
      <view class="row works-head"><text class="works-head-title">进行中</text><text class="small">好了会通知你</text></view>
      <scroll-view class="progress-track" scroll-x enable-flex show-scrollbar="{{false}}">
        <view wx:for="{{progress}}" wx:key="id" class="progress-card" data-id="{{item.id}}" aria-role="button" hover-class="chip-hover" bindtap="openProgress">
          <image wx:if="{{item.thumb}}" class="progress-thumb" src="{{item.thumb}}" mode="aspectFill" lazy-load />
          <view wx:else class="progress-thumb"></view>
          <view class="progress-copy">
            <text class="progress-title">{{item.title}}</text>
            <text class="small progress-hint {{item.status === 'failed' ? 'progress-hint-error' : ''}}">{{item.hint}}</text>
            <view wx:if="{{item.status !== 'failed' && item.status !== 'draft'}}" class="progress-bar"><view class="progress-bar-fill" style="width:{{item.percent}}%"></view></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <t-empty
      wx:if="{{!groups.length && !progress.length}}"
      icon="work"
      title="{{filtered ? '这里还没有作品' : '还没有作品'}}"
      description="{{filtered ? '换个分类看看，或者回到全部。' : '挑一个玩法，几分钟就能做出第一件作品。'}}"
      action-text="{{filtered ? '看全部' : '去做一个'}}"
      anim="{{animType}}"
      decor="{{decor}}"
      clay="{{!filtered}}"
      bindaction="handleEmptyAction"
    ></t-empty>

    <!-- 按月分组；标题用「宠物名 + 玩法名」，不显示版本号 -->
    <view wx:for="{{groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="month" class="works-section">
      <view class="row works-head">
        <text class="works-head-title">{{group.month}}</text>
        <picker wx:if="{{groupIndex === 0 && pets.length > 1}}" range="{{petNames}}" bindchange="choosePet"><text class="small strong">{{petText}} ▾</text></picker>
        <text wx:elif="{{groupIndex === 0}}" class="small">{{petText}}</text>
      </view>
      <view class="works-fall">
        <view wx:for="{{[group.left, group.right]}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="columnIndex" class="works-col">
          <view wx:for="{{column}}" wx:key="key" class="work work-{{item.kind}}" data-key="{{item.key}}" aria-role="button" aria-label="{{item.title}}" hover-class="chip-hover" bindtap="openItem">
            <view class="work-photo ai-mask-host">
              <!-- 写真套餐：前四张成片拼成 2×2 -->
              <view wx:if="{{item.kind === 'bundle'}}" class="work-stack">
                <image wx:for="{{item.stack}}" wx:for-item="url" wx:key="*this" class="work-stack-image" src="{{url}}" mode="aspectFill" lazy-load />
              </view>
              <image wx:elif="{{item.cover && !item.imageFailed}}" class="work-image" src="{{item.cover}}" mode="widthFix" data-key="{{item.key}}" binderror="onCoverError" lazy-load />
              <view wx:else class="work-image work-image-blank">{{item.kind === 'fun' ? '趣测结果' : '作品预览暂不可用'}}</view>
              <text wx:if="{{item.badge}}" class="work-badge work-badge-{{item.badgeTone}}">{{item.badge}}</text>
              <text wx:if="{{item.aiNotice && !item.imageFailed}}" class="ai-mask">{{item.aiNotice}}</text>
            </view>
            <view class="work-title">{{item.title}}</view>
            <text class="work-meta">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
