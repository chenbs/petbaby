<page-meta page-style="{{themeStyle}}"></page-meta>
<view class="{{skinClass}} page page-flat art-brand layout-matrix bundle-page">
  <text class="eyebrow">一组写真 · 第 2 步</text>
  <view class="title">选一张我的照片</view>
  <text class="muted">{{sceneIds.length}} 套布景都用这一张认出我，正脸、光线清楚的最好。确认后一张张开拍，哪张没拍成就退回那一张的冻干。</text>
  <view class="bundle-summary"><view><view class="sub-title">{{packageMode === 'twenty' ? '20 张一组' : '10 张一组'}}</view><text class="small">每套布景拍 1 张，拍好的都进作品柜</text></view><text class="bundle-price">{{priceText}}</text></view>
  <scroll-view class="bundle-scenes" scroll-x enable-flex show-scrollbar="false"><image wx:for="{{scenes}}" wx:key="id" class="bundle-scene" src="{{item.url}}" mode="aspectFit" /></scroll-view>
  <t-notice wx:if="{{error}}" type="error" message="{{error}}"></t-notice>
  <t-skeleton wx:if="{{loading}}" type="grid" count="4"></t-skeleton>
  <block wx:else>
    <view class="bundle-section"><view class="section-title">这次谁出镜</view><text wx:if="{{!pets.length}}" class="small strong" aria-role="button" bindtap="openPets">先建一个档案 ›</text><scroll-view wx:else class="pet-chips" scroll-x enable-flex show-scrollbar="false"><view wx:for="{{pets}}" wx:key="id" class="pet-chip {{petId === item.id ? 'pet-chip-on' : ''}}" data-index="{{index}}" aria-role="radio" aria-checked="{{petId === item.id}}" bindtap="choosePetChip"><image wx:if="{{item.avatarUrl}}" class="pet-chip-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="pet-chip-avatar pet-chip-avatar-empty">{{item.name}}</view><text>{{item.name}}</text></view></scroll-view></view>
    <view class="bundle-section"><view class="bundle-section-head"><view class="section-title">宠物身份照</view><text class="small">选 1 张清晰正脸照</text></view><t-skeleton wx:if="{{photosLoading}}" type="grid" count="6"></t-skeleton><t-empty wx:elif="{{!pets.length}}" icon="pet" title="还没有宠物档案" description="建一份档案，就能用它的照片拍了。" action-text="添加我的宠物" bindaction="openPets"></t-empty><t-photo-grid wx:elif="{{petId}}" photos="{{photos}}" selected-ids="{{photoIds}}" max="1" addable previewable="{{false}}" bindadd="uploadPetPhoto" bindtoggle="togglePhoto"></t-photo-grid></view>
  </block>
</view>
<view class="{{skinClass}} bundle-dock"><t-button type="primary" block loading="{{busy}}" disabled="{{loading || photosLoading}}" bindtap="submit">{{priceText ? priceText + " · " : ""}}开始制作 {{sceneIds.length}} 张</t-button></view>
<t-wallet-sheet id="wallet-sheet" visible="{{walletSheet.visible}}" required="{{walletSheet.required}}" balance="{{walletSheet.balance}}" shortfall="{{walletSheet.shortfall}}" bind:close="onWalletSheetClose" bind:paid="onWalletPaid"></t-wallet-sheet>
