.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.filters {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.filter {
  display: grid;
  min-height: 88rpx;
  align-content: center;
  gap: var(--space-1);
  padding: var(--space-2) 0;
  border-bottom: 2rpx solid var(--divider-soft);
}

.filter-label {
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
}

.filter-value {
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--small-size);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-entry {
  padding: var(--space-4) 0;
  border-bottom: 2rpx solid var(--divider-soft);
}

.pending-works {
  padding-top: var(--space-4);
}

.task-progress {
  margin-top: var(--space-4);
}

/* 作品用双列图片网格，让画面本身成为主视觉 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap-item);
}

/*
 * 比例由 aspect-ratio 锁定，不再写死 height。
 * 固定像素高在不同机型宽度下会得到不同比例，网格随之参差 —— 这正是方案 2.5
 * 要求「比例严格固定」的原因。
 */
.cover-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: var(--ratio-card);
  border-radius: var(--radius-image-thumb);
}

.cover {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--skeleton-base);
  border-radius: inherit;
}

.cover-fallback {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: var(--space-4);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

/* 压图文字必读性靠遮罩保证；基色是暖褐而非纯黑，见方案 A 落地要点 */
.cover-tag {
  position: absolute;
  top: var(--space-2);
  left: var(--space-2);
}

.work-meta {
  display: grid;
  gap: var(--space-0);
  padding: var(--space-2) 0 var(--space-4);
}

/*
 * 压在图上的文字固定用玻璃态亮色，不跟随 --text-primary：
 * 遮罩之下永远是暗底，浅色主题若沿用深色正文会彻底看不见。
 */
.work-title {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
  line-height: var(--lh-h3);
  word-break: break-all;
}

.cover-sub {
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
}
