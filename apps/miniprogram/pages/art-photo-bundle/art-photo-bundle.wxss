.bundle-page { padding-bottom: calc(var(--page-bottom-safe) + var(--space-8) + env(safe-area-inset-bottom)); }
.bundle-page .title { margin: var(--space-2) 0; }
.bundle-summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin: var(--space-5) 0 var(--space-3); padding: var(--space-4); border: var(--card-border); border-radius: var(--card-radius); background: var(--card-background); }
.bundle-summary .sub-title { margin: 0 0 var(--space-1); }
.bundle-price { color: var(--primary); font-size: var(--font-h2); font-weight: var(--fw-bold); }
.bundle-scenes { width: 100%; white-space: nowrap; }
.bundle-scene { display: inline-block; width: 132rpx; height: 176rpx; margin-right: var(--space-2); border-radius: var(--radius-image-thumb); background: var(--surface); }
.bundle-section { margin-top: var(--space-5); }
.bundle-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); }
.bundle-section-head .section-title { margin: 0; }
.bundle-dock { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; padding: var(--space-3) var(--page-padding) calc(var(--space-3) + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--divider-soft); background: var(--background); }
