---
/*
 * 隐私政策（草案骨架，方案 11.1）。
 *
 * 章节按「收集什么 → 怎么用 → 存多久 → 给谁 → 用户能做什么」的顺序排，
 * 这是隐私政策的常规结构，交给法务时能直接对着填。
 */
import LegalLayout from "../../layouts/LegalLayout.astro";

const SECTIONS = [
  {
    heading: "我们收集哪些信息",
    note: "本节要点：微信登录标识、宠物档案（名字/生日/品种）、上传的照片。照片是最敏感的一项，须单列说明。",
  },
  { heading: "信息的使用目的" },
  {
    heading: "照片的处理与保留期限",
    note: "本节要点：仅用于生成、可随时删除。与用户协议第 5 节及官网信任条三处表述必须一致。",
  },
  { heading: "第三方共享与委托处理" },
  { heading: "信息存储与安全措施" },
  { heading: "用户权利：查阅、更正、删除、注销" },
  { heading: "未成年人保护" },
  { heading: "政策更新与联系方式" },
];
---

<LegalLayout
  title="隐私政策"
  description="隐私政策的章节骨架。正文尚未定稿，不构成任何承诺或法律文件；本页列出待法务补充的条款范围，以及照片处理口径须与用户协议一致的要点。"
  placeholder="legal-privacy"
  sections={SECTIONS}
/>
