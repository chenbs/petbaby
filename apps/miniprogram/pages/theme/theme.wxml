<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="page page-flat art-pet layout-matrix">
  <view class="title">挑一套喜欢的外观</view>

  <view class="theme-list section">
    <view
      wx:for="{{previews}}"
      wx:key="id"
      class="preview {{item.active ? 'preview-on' : ''}}"
      style="{{item.style}}"
      data-id="{{item.id}}"
      aria-role="radio"
      aria-checked="{{item.active}}"
      hover-class="preview-hover"
      bindtap="choose"
    >
      <!-- 卡内所有元素都吃自身 style 上的变量，因此呈现的是该主题的真实观感 -->
      <view class="preview-inner">
        <view class="preview-head">
          <view class="preview-name">{{item.name}}</view>
          <view wx:if="{{item.active}}" class="preview-check">使用中</view>
        </view>
        <text class="preview-desc">{{item.description}}</text>
        <view class="preview-demo">
          <image wx:if="{{!previewImageFailed}}" class="demo-image" src="/assets/theme-preview.jpg" mode="aspectFill" binderror="onPreviewImageError" />
          <view wx:else class="demo-image demo-image-blank">预览图暂不可用</view>
          <view class="demo-card">
            <view class="demo-line demo-line-title"></view>
            <view class="demo-line"></view>
            <view class="demo-line demo-line-short"></view>
            <view class="demo-btn">查看作品</view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>
