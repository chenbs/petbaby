<page-meta page-style="{{themeStyle}}"></page-meta>

<!--
  制作与挑选（2026-10 按 prototype.html 第 4 节重做）：
  - 等待：模糊的场景样片 + 我的头像、三段进度、等的时候再挑几套写真；
  - 结果：每次只出 1 张，大图展示、点一下放大；历史多候选任务仍并排挑选；重拍降级成一行文字链接；
  - 底部抽屉：场景名 + 带价格的保存按钮 +「发给朋友看」。
-->
<view class="{{skinClass}} page page-flat art-brand layout-workbench run-page {{showSheet ? 'run-page-sheet' : ''}}">
  <t-skeleton wx:if="{{loading}}" type="card" count="2"></t-skeleton>

  <block wx:elif="{{run}}">
    <t-notice wx:if="{{message}}" type="{{messageType}}" message="{{message}}" class="block-gap"></t-notice>

    <!-- 排队 / 制作中 -->
    <view wx:if="{{run.status === 'queued' || run.status === 'processing'}}" class="wait">
      <view class="wait-frame" aria-role="img" aria-label="正在制作">
        <image wx:if="{{waitCoverUrl}}" class="wait-cover" src="{{waitCoverUrl}}" mode="aspectFill" />
        <view class="wait-shine"></view>
        <image wx:if="{{petAvatarUrl}}" class="wait-me" src="{{petAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="wait-me wait-me-empty"><image class="wait-me-paw" src="/assets/icons/{{themeId}}/paw.png" mode="aspectFit" /></view>
      </view>
      <!-- 加载气质随主题（主题方案 3.2）：软糖弹跳 / 翻页 / 方块步进闪烁 / 胶片走带 -->
      <view class="wait-loader" aria-hidden="true"><view class="wait-dot"></view><view class="wait-dot"></view><view class="wait-dot"></view></view>
      <view class="wait-stages">
        <view wx:for="{{waitStages}}" wx:key="id" class="wait-stage wait-stage-{{item.state}}">
          <text class="wait-stage-dot">{{item.state === 'done' ? '✓' : index + 1}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="wait-bar"><view class="wait-bar-fill" style="width:{{waitProgress}}%"></view></view>
      <text class="muted wait-time">{{run.status === 'queued' && run.queuePosition > 1 ? '前面还有 ' + (run.queuePosition - 1) + ' 位，' : ''}}大约还要 {{run.estimatedSeconds || 55}} 秒</text>
      <text class="small wait-cap">离开也会继续做，在「作品 › 进行中」能找到</text>

      <view wx:if="{{suggestScenes.length}}" class="wait-more">
        <view class="row wait-more-head" aria-role="button" bindtap="openArtStudio"><text class="wait-more-title">等的时候，再挑几套写真</text><text class="small">›</text></view>
        <scroll-view class="wait-strip" scroll-x enable-flex show-scrollbar="{{false}}">
          <view wx:for="{{suggestScenes}}" wx:key="id" class="wait-thumb" data-id="{{item.id}}" aria-role="button" aria-label="{{item.title}}" bindtap="openSuggestScene">
            <image class="wait-thumb-image" src="{{item.url}}" mode="aspectFill" lazy-load />
            <text class="wait-thumb-name">{{item.title}}</text>
          </view>
        </scroll-view>
      </view>
      <text class="small wait-cancel" aria-role="button" bindtap="askCancel">不想等了，取消这次制作</text>
    </view>

    <!-- 失败 -->
    <t-card wx:elif="{{run.status === 'failed'}}" blur="{{blurOk}}" anim="{{animType}}">
      <view class="state-title">这次没有拍成</view>
      <text class="muted">系统已经自动重试过，{{costText}}已全额退回。</text>
      <t-button wx:if="{{canReroll}}" type="primary" block anim="{{animType}}" loading="{{busy}}" class="block-gap" bindtap="chooseReroll">{{costText}} · 再拍一张</t-button>
    </t-card>

    <!-- 已取消 -->
    <t-card wx:elif="{{run.status === 'cancelled'}}" blur="{{blurOk}}" anim="{{animType}}">
      <view class="state-title">任务已取消</view>
      <text class="muted">{{costText}}已退回。</text>
    </t-card>

    <!-- 结果：新任务只有 1 张（服务端已自动选中）；历史 2 / 4 候选任务仍可挑选 -->
    <block wx:else>
      <view class="title run-title">{{single ? (pet ? pet.name : '我') + '的这一张' : '哪张最像' + (pet ? pet.name : '我') + '？'}}</view>
      <text class="muted">{{single ? '点图片放大查看' : '点图片选中，再点一下放大查看'}}</text>
      <view class="cands {{single ? 'cands-single' : ''}}">
        <view
          wx:for="{{candidates}}"
          wx:key="id"
          class="cand {{run.selectedId === item.id ? 'cand-on' : run.selectedId ? 'cand-off' : ''}}"
          data-id="{{item.id}}"
          aria-role="radio"
          aria-checked="{{run.selectedId === item.id}}"
          aria-label="第 {{item.number}} 张"
          bindtap="select"
        >
          <view class="ai-mask-host cand-photo">
            <image wx:if="{{!item.imageFailed}}" class="cand-image" src="{{item.url}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{item.url}}" binderror="onCandidateImageError" lazy-load />
            <view wx:else class="cand-image cand-image-blank">图片暂不可用</view>
            <text wx:if="{{run.aiNotice && !item.imageFailed}}" class="ai-mask">{{run.aiNotice}}</text>
            <text wx:if="{{!single}}" class="cand-check">✓</text>
          </view>
        </view>
      </view>
      <view wx:if="{{canReroll}}" class="run-reroll">
        <text class="muted">想换个方向？</text><text class="run-reroll-link" aria-role="button" bindtap="chooseReroll">再拍一张（{{costText}}，这张会保留）</text>
      </view>
      <text wx:elif="{{humanMode}}" class="small run-reroll">想看看另一种样子？回上一页换一款造型再拍</text>
    </block>
  </block>

  <t-notice wx:else type="error" message="{{message || '任务不存在'}}"></t-notice>
</view>

<!-- 底部抽屉：价格写在按钮上；预览可看可分享，保存到相册 = 高清原图 -->
<view wx:if="{{showSheet}}" class="{{skinClass}} run-sheet">
  <view class="run-sheet-head">
    <text class="run-sheet-title">{{selectedLabel}}</text>
    <text class="small">{{run.selectedUnlocked ? '高清原图已就绪' : '冻干上线前的作品，需要先解锁'}}</text>
  </view>
  <t-button wx:if="{{run.selectedUnlocked}}" type="primary" block anim="{{animType}}" loading="{{busy}}" bindtap="save">保存高清原图到相册</t-button>
  <t-button wx:else type="primary" block anim="{{animType}}" disabled="{{!run.selectedId}}" loading="{{busy}}" bindtap="unlock">
    <image class="run-lock" src="/assets/icons/{{themeId}}/fd-coin-mono.png" mode="aspectFit" />{{unlockText}}
  </t-button>
  <view class="run-sheet-row">
    <button class="run-share" open-type="share" disabled="{{!run.workId}}" hover-class="pet-feature-hover">
      <image class="run-share-icon" src="/assets/icons/{{themeId}}/ic-share.png" mode="aspectFit" />发给朋友看
    </button>
    <view wx:if="{{run.workId}}" class="run-work" aria-role="button" bindtap="openWork">作品档案 ›</view>
  </view>
  <text class="small run-sheet-cap">作品会一直留在作品柜，可以分享，也可以保存高清原图到相册</text>
</view>

<t-dialog
  visible="{{confirmCancel}}"
  title="取消这次制作？"
  content="已经排进队列的任务会立刻停止，这次扣的冻干全额退回。"
  confirm-text="取消任务"
  danger
  anim="{{animType}}"
  bindconfirm="cancel"
  bindcancel="dismissCancel"
></t-dialog>

<t-wallet-sheet id="wallet-sheet" visible="{{walletSheet.visible}}" required="{{walletSheet.required}}" balance="{{walletSheet.balance}}" shortfall="{{walletSheet.shortfall}}" bind:close="onWalletSheetClose" bind:paid="onWalletPaid"></t-wallet-sheet>
