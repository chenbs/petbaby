<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="page page-flat art-film layout-matrix photo-library">
  <view class="library-heading">
    <view class="title">把可爱收好</view>
    <text class="small">照片、故事和我的成长，都放在这里</text>
  </view>

  <view class="library-topbar">
    <picker range="{{pets}}" range-key="name" disabled="{{saving || preparing}}" bindchange="choosePet">
      <view class="picker">
        <text class="small">正在看</text>
        <text class="picker-value">{{petText || '暂无档案'}}</text>
        <text class="picker-arrow" aria-hidden="true">⌄</text>
      </view>
    </picker>
    <t-button wx:if="{{photos.length}}" type="ghost" size="mini" anim="{{animType}}" bindtap="toggleManage">{{manage ? '完成' : '管理'}}</t-button>
  </view>

  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>
  <t-button wx:if="{{error && !detail && !batchEditing}}" type="ghost" size="mini" bindtap="load">重新加载</t-button>
  <t-notice wx:if="{{message}}" type="success" message="{{message}}" class="block-gap"></t-notice>

  <view wx:if="{{petId && !loading && !recordMode}}" class="library-entry">
    <view class="entry-copy"><view class="sub-title">留住今天的可爱</view><text class="small">先收照片，故事可以以后再补</text></view>
    <t-button type="primary" anim="{{animType}}" bindtap="goCreate">添加照片</t-button>
  </view>

  <view wx:if="{{recordMode && petId && !loading}}" class="record-panel">
    <view wx:if="{{!savedCount || pendingCount}}" class="record-head">
      <view><view class="sub-title">本次记录</view><text class="small">最多 9 张 · 保存后可补文字和标签</text></view>
      <text wx:if="{{uploadItems.length}}" class="record-count">{{uploadItems.length}} / 9</text>
    </view>
    <t-button wx:if="{{!uploadItems.length}}" type="primary" block anim="{{animType}}" disabled="{{preparing}}" bindtap="choosePhotos">{{preparing ? '正在整理照片' : '选择照片'}}</t-button>
    <t-button wx:elif="{{pendingCount && uploadItems.length < 9}}" type="secondary" block anim="{{animType}}" disabled="{{uploading || preparing}}" bindtap="choosePhotos">再选几张</t-button>
    <view wx:if="{{activeUploadItems.length}}" class="upload-grid">
      <view wx:for="{{activeUploadItems}}" wx:key="requestId" class="upload-card">
        <view class="upload-frame">
          <image wx:if="{{item.path && !item.thumbFailed}}" src="{{item.path}}" mode="aspectFill" class="upload-thumb" data-id="{{item.requestId}}" data-src="{{item.path}}" binderror="onUploadThumbError" />
          <view wx:else class="upload-thumb upload-thumb-blank">预览失败</view>
          <text wx:if="{{!item.attempted}}" class="upload-remove" aria-role="button" aria-label="移除这张照片" data-id="{{item.requestId}}" catchtap="cancelSelected">×</text>
          <text wx:if="{{item.needsReselect || item.state === 'failed'}}" class="upload-reselect" aria-role="button" data-id="{{item.requestId}}" catchtap="choosePhotos">重选</text>
        </view>
        <view wx:if="{{item.state !== 'ready'}}" class="upload-card-meta"><text>{{item.stateText}}</text><text wx:if="{{item.state === 'uploading'}}">{{item.progress}}%</text></view>
        <text wx:if="{{item.error}}" class="upload-error">{{item.error}}</text>
        <text wx:if="{{item.duplicatePhotoId}}" class="upload-error">图库中可能已有相同照片</text>
      </view>
    </view>
    <t-button wx:if="{{pendingCount}}" type="primary" block anim="{{animType}}" disabled="{{uploading || preparing}}" bindtap="savePhotos">{{uploading ? '正在保存' : (savedCount ? '重试剩余照片' : '保存这批照片')}}</t-button>
    <view wx:if="{{savedCount}}" class="saved-summary">
      <view class="saved-copy"><view class="sub-title">已收好 {{savedCount}} 张</view><text class="small">想起什么，再补一句就好</text></view>
      <view class="saved-actions">
        <t-button type="secondary" size="mini" disabled="{{uploading}}" bindtap="editBatch">补一句话</t-button>
        <t-button type="ghost" size="mini" disabled="{{pendingCount || uploading}}" bindtap="continueBatch">继续添加</t-button>
      </view>
    </view>
  </view>

  <t-skeleton wx:if="{{loading}}" type="grid" count="9" class="block-gap"></t-skeleton>
  <view wx:else class="library-content">
    <view class="gallery-heading"><view><view class="sub-title">{{batchView ? '本次记录' : '全部照片'}}</view><text class="small">{{batchView ? photos.length : totalCount}} 张</text></view><t-button wx:if="{{batchView}}" type="ghost" size="mini" bindtap="load">查看全部</t-button><t-button wx:elif="{{recordMode && savedCount && !manage}}" type="ghost" size="mini" bindtap="viewSaved">仅看本次</t-button></view>
    <view wx:if="{{!photos.length && !error}}" class="gallery-empty"><text>{{petId ? '收好的照片会出现在这里' : '先为我建一份档案'}}</text><t-button wx:if="{{!petId}}" type="primary" size="mini" bindtap="newPet">新建宠物档案</t-button></view>
    <view wx:else class="gallery-grid {{photos.length === 1 ? 'gallery-grid-single' : ''}}">
      <t-photo-grid
        photos="{{photos}}"
        columns="{{photos.length === 1 ? 1 : 2}}"
        image-mode="aspectFit"
        featured="{{photos.length === 1}}"
        selected-ids="{{picked}}"
        manageable="{{manage}}"
        previewable="{{!manage}}"
        anim="{{animType}}"
        bindtoggle="togglePick"
      ></t-photo-grid>
    </view>
    <t-button wx:if="{{nextCursor}}" class="block-gap" type="secondary" block disabled="{{loadingMore}}" bindtap="more">{{loadingMore ? '正在加载' : '加载更多'}}</t-button>

    <view wx:if="{{manage}}" class="dock">
      <text class="small">已选 {{picked.length}} 张</text>
      <t-button type="danger" size="mini" anim="{{animType}}" disabled="{{!picked.length}}" bindtap="askRemove">删除所选</t-button>
    </view>
  </view>

  <view wx:if="{{petId && !loading && totalCount}}" class="library-links">
    <view class="sub-title">用照片做点什么</view>
    <view class="library-tool-grid">
      <view class="library-tool" aria-role="button" bindtap="timeline">时间线<text>›</text></view>
      <view class="library-tool" aria-role="button" bindtap="compare">成长对比<text>›</text></view>
      <view class="library-tool" aria-role="button" data-kind="album" bindtap="makeWork">做成画册<text>›</text></view>
      <view class="library-tool" aria-role="button" data-kind="video" bindtap="makeWork">做成短片<text>›</text></view>
    </view>
    <text class="small">成长对比为带水印的免费作品</text>
  </view>
</view>

<t-dialog
  visible="{{removeCount > 0}}"
  title="删除 {{removeCount}} 张照片？"
  content="从照片库移除后不能恢复。已导出的成品和他人保存的副本不会远程删除；需要关闭的作品分享请另行关闭。有制作任务使用的照片，需任务完成或取消后再删除。"
  confirm-text="删除"
  danger
  anim="{{animType}}"
  bindconfirm="confirmRemove"
  bindcancel="cancelRemove"
></t-dialog>

<t-popup visible="{{!!detail || batchEditing}}" tall="{{!!detail}}" title="{{batchEditing ? '补一句话与标签' : '这张照片的记录'}}" anim="{{animType}}" bindclose="closeDetail">
  <view class="record-stack">
    <t-notice wx:if="{{error}}" type="error" message="{{error}}"></t-notice>
    <block wx:if="{{detail}}">
      <image wx:if="{{detail.localUrl}}" src="{{detail.localUrl}}" mode="widthFix" class="detail-photo" data-src="{{detail.localUrl}}" binderror="onDetailImageError" bindtap="previewDetail" />
      <view wx:else class="detail-photo detail-photo-blank">照片暂时无法显示</view>
      <text>{{petText}} · {{detail.recordedDate}}</text>
      <text class="small">{{detail.sourceText}}</text>
      <picker mode="date" value="{{editDate}}" bindchange="chooseDate"><t-field control="select" label="记录日期（选填）" value="{{editDate}}" placeholder="不确定时可以不填"></t-field></picker>
      <t-button type="ghost" size="mini" bindtap="clearDate">清除手工日期，恢复照片或上传日期</t-button>
    </block>
    <t-field control="textarea" label="想留的一句话（选填）" value="{{editCaption}}" maxlength="120" show-count placeholder="照片已收好，不必现在写" bindchange="inputCaption"></t-field>
    <text class="small">最多选择三个标签</text>
    <view class="record-tags"><view wx:for="{{tagOptions}}" wx:key="code" class="record-tag {{item.selected ? 'record-tag-selected' : ''}}" data-code="{{item.code}}" bindtap="toggleTag">{{item.label}}</view></view>
    <block wx:if="{{detail}}">
      <t-button type="secondary" disabled="{{saving}}" bindtap="download">下载保存的照片</t-button>
      <text class="small">文件可能经过上传压缩。</text>
      <t-button wx:if="{{albumDenied}}" type="ghost" bindtap="albumSettings">打开相册权限设置</t-button>
    </block>
  </view>
  <view slot="footer" class="record-actions">
    <t-button type="ghost" disabled="{{saving}}" bindtap="closeDetail">稍后再补</t-button>
    <t-button type="primary" disabled="{{saving}}" bindtap="saveMetadata">{{saving ? '正在保存' : (batchEditing ? '应用到本次成功的 ' + savedCount + ' 张' : '保存记录')}}</t-button>
  </view>
</t-popup>
