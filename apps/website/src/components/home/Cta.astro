---
/*
 * 9. CTA：大圆角面板 + 小程序码。
 *
 * 也被文章详情页复用（方案 7.6 第 2 条：从「看完教程」直接接到「扫码去做」），
 * 那里传 id={undefined} 避免与首页的 #contact 撞 id —— 同一页只会出现一个。
 */
import QrImage from "../QrImage.astro";
import { MINIPROGRAM_QR } from "../../config/site";

interface Props {
  id?: string;
}

const { id = "contact" } = Astro.props;
---

<section class="band section" id={id}>
  <div class="container">
    <div class="cta-panel reveal">
      <div class="cta-sheen" aria-hidden="true"></div>
      <div class="cta-grid">
        <div>
          <p class="eyebrow">开始使用</p>
          <h2 class="h2 h2-mid">现在就给我拍一张</h2>
          <p class="body-text lead">{MINIPROGRAM_QR.available ? "微信扫码打开小程序，从一张照片开始留下我的可爱。" : "小程序正在准备上线，先看看这里的作品和创作指南。"}</p>
          <p class="cta-note">图文创作、AI 肖像与陪伴短片，具体开放服务及费用以小程序内展示为准。</p>
        </div>
        <div class="qr-box">
          {/* 待提供：真实小程序码。缺图时是虚线占位框，不是色块（规格 7.4）*/}
          <QrImage size={MINIPROGRAM_QR.size} loading="lazy" />
          <p class="qr-note">
            {MINIPROGRAM_QR.available ? "微信扫码开始创作" : "上线后开放扫码入口"}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
