# Local mode needs no credentials. Production adapters must require all values below.
# APP_ENV 只有 staging 有特殊含义（配合 NODE_ENV=production 放行本地存储与模拟支付）。
APP_ENV=local
PAYMENT_PROVIDER=development
OBJECT_STORAGE_PROVIDER=local
# 账号密码登录：非生产默认开启，生产默认关闭。
PASSWORD_AUTH_ENABLED=
PASSWORD_AUTH_INVITE_CODE=
# Leave blank for the local persistent PGlite database; production uses PostgreSQL.
DATABASE_URL=
SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:3000
LOCAL_STORAGE_DIR=.data/objects
WORKER_SECRET=
WORKER_POLL_INTERVAL_MS=1000
ADMIN_USER_IDS=
DAILY_GENERATION_LIMIT=500
DAILY_COST_LIMIT=50
LAYOUT_GENERATION_COST=0.01
AI_IMAGE_COST=0.08
# lingsuan 图像接口（当前主通道，OpenAI images 兼容）。配上这两项即接管主位，
# 下面的 AI_IMAGE_ENDPOINT 会自动顺延为备用通道。
LINGSUAN_IMAGE_BASE_URL=https://lingsuan.top
LINGSUAN_IMAGE_API_KEY=
LINGSUAN_IMAGE_MODEL=gpt-image-2
# 进程内共享请求队列并发数；默认 20，代码硬限制为 1–20，误填更大也不会超过 20
LINGSUAN_IMAGE_CONCURRENCY=20
# size 实测只对方形生效（1024x1024 得 1024x1024，1600x1000 得 2048x1376）
LINGSUAN_IMAGE_SIZE=1024x1024
LINGSUAN_IMAGE_QUALITY=high
# 图生图时要求保住主体特征。**留空**：接口接受该参数（不再 400），但产物是否
# 真更贴主体未验证过，开之前要人眼比对一批。
LINGSUAN_IMAGE_INPUT_FIDELITY=
# 单张请求超时。实测 quality=low 就要 46–62 秒，high 更久，勿调至 120000 以下
LINGSUAN_IMAGE_TIMEOUT_MS=180000
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=provider-v1
AI_IMAGE_SECONDARY_ENDPOINT=
AI_IMAGE_SECONDARY_API_KEY=
AI_IMAGE_SECONDARY_MODEL=provider-v1
AI_CIRCUIT_FAILURE_THRESHOLD=3
FFMPEG_PATH=ffmpeg
# 视频字幕字体（留空则用 fontconfig 默认字体；生产镜像必须显式指定，否则中文丢失）
FFMPEG_FONT_FILE=
ADDRESS_ENCRYPTION_KEY=
PHYSICAL_PAYMENT_PROVIDER=
ALERT_WEBHOOK_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_CERT_SERIAL=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
STORAGE_REGION=
