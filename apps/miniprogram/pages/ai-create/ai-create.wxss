.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.flush {
  margin: 0;
}

/* 横向滑动选择器：选项多时不挤压文字，也不占纵向空间 */
.chooser {
  display: flex;
  width: 100%;
  height: 88rpx;
  border-bottom: 2rpx solid var(--divider-soft);
  white-space: nowrap;
}

.chooser .option {
  width: auto;
  min-height: 88rpx;
  box-sizing: border-box;
  flex-direction: row;
  align-items: center;
  padding: 0 var(--space-4);
  border: 0;
  border-bottom: 4rpx solid transparent;
  border-radius: 0;
  background: transparent;
}

.chooser .option + .option {
  margin-left: 0;
}

.chooser .option .small {
  display: none;
}

.chooser .option-on {
  border-bottom-color: var(--primary);
}

.chooser .option-on .option-name {
  color: var(--primary);
}

.option {
  display: inline-flex;
  width: 260rpx;
  box-sizing: border-box;
  flex-direction: column;
  flex-shrink: 0;
  gap: var(--space-1);
  padding: var(--space-4);
  border: 2rpx solid transparent;
  border-radius: var(--card-radius);
  background: var(--surface);
  transition: border-color var(--transition-duration) var(--transition-easing), transform var(--transition-duration) var(--transition-easing);
}

.option + .option {
  margin-left: var(--space-3);
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.solo-template-image {
  display: block;
  width: 100%;
  height: 1160rpx;
  aspect-ratio: var(--ratio-portrait);
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
}

.scene-grid .scene-option {
  width: 100%;
}

.template-option {
  width: 100%;
  min-width: 0;
  padding: 0;
  border-color: transparent;
  border-radius: var(--radius-image-thumb);
  background: transparent;
  white-space: normal;
}

.template-option + .template-option {
  margin-left: 0;
}

.option-hover {
  transform: scale(.97);
}

.option-on {
  border-color: var(--primary);
  background: var(--card-background);
}

.template-option.option-on {
  border-color: transparent;
  background: transparent;
}

.template-option.option-on .style-thumb {
  box-shadow: 0 0 0 4rpx var(--primary);
}

.option-name {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: 700;
  white-space: normal;
}

/*
 * 宠物艺术写真场景缩略图：每个卡片必须展示真实场景，
 * 让用户比较动作和表情，不用抽象色块代替成品。
 *
 * 比例锁 3:4 与作品网格同档，图片内容由 sceneUrls 提供。
 */
.style-thumb {
  display: block;
  width: 100%;
  height: 588rpx;
  aspect-ratio: var(--ratio-portrait);
  margin-bottom: var(--space-2);
  border-radius: var(--radius-image-thumb);
  background: var(--skeleton-base);
}
.scene-thumb { height: 440rpx; aspect-ratio: var(--ratio-card); }
.template-wide { grid-column: span 2; }
.style-wide { height: 420rpx; aspect-ratio: var(--ratio-hero); }
.solo-wide { height: 420rpx; aspect-ratio: var(--ratio-hero); }
.ai-flow { padding-bottom: calc(var(--page-bottom-safe) + var(--space-8) + env(safe-area-inset-bottom)); }
.selected-effect { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-5); padding: var(--space-3); border-radius: var(--radius-image-thumb); background: var(--surface); }
.selected-effect-image { flex: none; width: 100rpx; height: 132rpx; border-radius: var(--radius-image-thumb); background: var(--skeleton-base); }
.selected-effect-copy { display: grid; gap: var(--space-1); min-width: 0; flex: 1; }
.selected-effect-copy .sub-title { margin: 0; }
.change-effect { flex: none; color: var(--primary); font-size: var(--small-size); font-weight: var(--fw-bold); }
.effect-chooser-section { margin-top: var(--space-4); }
.effect-chooser-section .section-title { display: flex; align-items: baseline; gap: var(--space-2); }
.effect-track { width: 100%; margin-top: var(--space-3); white-space: nowrap; }
.effect-card { display: inline-block; width: 274rpx; margin-right: var(--space-3); vertical-align: top; white-space: normal; }
.effect-image-wrap { position: relative; overflow: hidden; border: 4rpx solid transparent; border-radius: var(--radius-image-thumb); background: var(--surface); }
.effect-card-on .effect-image-wrap { border-color: var(--primary); }
.effect-card-image { display: block; box-sizing: border-box; width: 100%; height: 358rpx; }
.effect-selected { position: absolute; right: var(--space-1); bottom: var(--space-1); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--button-primary); color: var(--button-primary-text); font-size: var(--eyebrow-size); font-weight: var(--fw-bold); }
.effect-card-title { overflow: hidden; padding-top: var(--space-2); color: var(--text-primary); font-size: var(--small-size); font-weight: var(--fw-bold); text-overflow: ellipsis; white-space: nowrap; }
.ai-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; padding: var(--space-3) var(--page-padding) calc(var(--space-3) + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--divider-soft); background: var(--background); }

.style-thumb-blank {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: var(--space-3);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

/*
 * `.chips / .chip / .chip-hover / .chip-on` 已于 2026-08-03 提到 app.wxss ——
 * pages/pets 的四个枚举也改用 chip（CLAUDE.md 的「已知未收口」项），
 * 第二处要用时就该共用而不是复制一份。此处不再重复声明。
 */

/* 宠物头像 chip（2026-09，替代下拉框） */
.pet-chips { margin-top: var(--space-2); }
.pet-chip { display: inline-flex; flex: none; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1); border: 2rpx solid var(--border); border-radius: var(--radius-pill); background: var(--card-background); color: var(--text-primary); font-size: var(--small-size); font-weight: var(--fw-bold); }
.pet-chip-on { border-color: var(--primary); color: var(--primary); }
.pet-chip-avatar { width: 56rpx; height: 56rpx; border-radius: var(--radius-pill); background: var(--surface); }
.pet-chip-avatar-empty { display: flex; align-items: center; justify-content: center; overflow: hidden; color: var(--text-secondary); font-size: var(--eyebrow-size); }

/* ---------- 选照片（2026-10 按 prototype.html after-effect）---------- */
.ai-flow-photos { padding-top: var(--space-2); padding-bottom: calc(var(--space-8) + var(--space-7) + var(--space-6) + env(safe-area-inset-bottom)); }

/* 预览框比例跟素材走：card 3:4 铺满；portrait 在 3:4 框里完整显示 9:16 样片，两侧垫同图模糊底；wide 16:9 */
.effect-preview { position: relative; width: 84%; margin: 0 auto; overflow: hidden; border-radius: var(--radius-image-hero); background: var(--surface); box-shadow: var(--shadow-image); }
.effect-preview-card { aspect-ratio: var(--ratio-card); }
/* 9:16 模板：框按素材比例收窄，样片完整显示且不留边 */
.effect-preview-portrait { width: 60%; aspect-ratio: var(--ratio-portrait); }
.effect-preview-wide { aspect-ratio: 16 / 9; }
.effect-preview-image { position: relative; display: block; width: 100%; height: 100%; border-radius: 0; }
.effect-preview-label { position: absolute; bottom: var(--space-3); left: var(--space-3); z-index: 2; }

.effect-strip { width: 100%; margin-top: var(--space-3); white-space: nowrap; }
.effect-thumb { display: inline-block; width: 134rpx; margin-right: var(--space-2); vertical-align: top; }
.effect-thumb-image { display: block; box-sizing: border-box; width: 134rpx; height: auto; border: 4rpx solid transparent; border-radius: var(--radius-sm); background: var(--surface); }
.effect-thumb-card { aspect-ratio: var(--ratio-card); }
.effect-thumb-portrait { aspect-ratio: var(--ratio-portrait); }
.effect-thumb-wide { aspect-ratio: var(--ratio-portrait); }
.effect-thumb-on .effect-thumb-image { border-color: var(--primary); }
.effect-thumb-name { display: block; overflow: hidden; padding-top: var(--space-1); color: var(--text-secondary); font-size: var(--eyebrow-size); text-align: center; text-overflow: ellipsis; white-space: nowrap; }
/* 写真套餐入口卡 */
.art-pack { margin-top: var(--space-3); padding: var(--space-3); border: var(--card-border); border-radius: var(--card-radius); background: var(--surface); }
.art-pack-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); }
.art-pack-title { flex: none; color: var(--text-primary); font-size: var(--body-size); font-weight: var(--fw-black); }
.art-pack-head .small { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.art-pack-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-top: var(--space-2); }
.art-pack-item { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding: var(--space-2) var(--space-3); border: 2rpx solid var(--border); border-radius: var(--radius-md); background: var(--card-background); }
.art-pack-name { color: var(--text-primary); font-size: var(--small-size); font-weight: var(--fw-bold); }
.art-pack-price { color: var(--primary); font-family: var(--skin-num-font, inherit); font-size: var(--small-size); font-weight: var(--fw-black); }
.effect-thumb-on .effect-thumb-name { color: var(--text-primary); font-weight: var(--fw-bold); }

.photo-head { margin-top: var(--space-5); }
.pet-chip-on { border-color: var(--primary); color: var(--primary); }
.pet-chip-avatar-empty { font-size: var(--small-size); font-weight: var(--fw-bold); }
.photo-row { margin-top: var(--space-3); }

/* 提示条：成功色浅底 + 勾，与原型的薄荷提示一致 */
.photo-tip { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); background: var(--success-surface); color: var(--success); font-size: var(--small-size); }
.photo-tip-mark { flex: none; font-weight: var(--fw-black); }

/* 固定底栏：标题与余额一行，费用说明与主操作一行，避免说明被挤碎。 */
.ai-dock { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-3) var(--page-padding) calc(var(--space-3) + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--divider); background: var(--card-background); box-shadow: var(--shadow-float); }
.ai-dock-head, .ai-dock-action { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: var(--space-3); }
.ai-dock-head t-dongan-balance, .ai-dock-action t-button { flex: none; }
.ai-dock-meta { display: flex; flex-direction: column; flex: 1; gap: var(--space-1); min-width: 0; }
.ai-dock-title { flex: 1; min-width: 0; overflow: hidden; color: var(--text-primary); font-size: var(--font-h3); font-weight: var(--fw-black); text-overflow: ellipsis; white-space: nowrap; }
.ai-dock-cost { color: var(--text-primary); font-size: var(--small-size); line-height: 1.5; }
.ai-dock-amount { color: var(--primary); font-weight: var(--fw-bold); white-space: nowrap; }
.ai-dock-hint { color: var(--text-secondary); font-size: var(--eyebrow-size); line-height: 1.5; }
