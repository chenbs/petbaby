<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="{{skinClass}} page page-flat art-brand layout-matrix ai-flow ai-flow-{{stage}}">
  <view wx:if="{{stage !== 'photos'}}" class="title">{{templateId === 'pet-art-photo' ? '宠物艺术写真' : entryId === 'art' && activeTemplate ? activeTemplate.title : entryTitle}}</view>
  <t-steps steps="{{flowSteps}}" wx:if="{{stage !== 'photos'}}" current="{{stage === 'photos' ? 1 : 0}}" class="block-gap"></t-steps>
  <t-notice wx:if="{{error}}" type="error" message="{{error}}" class="block-gap"></t-notice>
  <t-skeleton wx:if="{{catalogLoading}}" type="grid" count="4"></t-skeleton>
  <t-empty wx:elif="{{!entries.length}}" icon="work" title="暂无可用模板" description="模板目录暂时无法使用。" action-text="重新加载" anim="{{animType}}" decor="{{decor}}" bindaction="loadCatalog"></t-empty>

  <block wx:else>
    <block wx:if="{{stage === 'samples'}}">
      <view wx:if="{{entryId !== 'art'}}" class="section">
        <view class="section-title">选一个喜欢的效果</view>
        <view class="template-grid">
          <view wx:for="{{templates}}" wx:key="templateId" class="option template-option {{item.sampleShape === 'wide' ? 'template-wide' : ''}}" data-id="{{item.templateId}}" hover-class="option-hover" bindtap="chooseTemplate">
            <image wx:if="{{item.sampleUrl}}" class="style-thumb {{item.sampleShape === 'wide' ? 'style-wide' : ''}}" src="{{item.sampleUrl}}" mode="aspectFit" data-id="{{item.templateId}}" data-src="{{item.sampleUrl}}" binderror="onTemplateImageError" lazy-load />
            <view wx:else class="style-thumb style-thumb-blank">样片暂不可用</view>
            <view class="option-name">{{item.title}}</view>
            <text class="small">{{item.subjectMode === 'owner-pet' ? '主人 + 宠物' : item.subjectMode === 'pet-human' ? '宠物人化' : '宠物主体'}}</text>
          </view>
        </view>
      </view>
      <view wx:elif="{{activeTemplate && templateId !== 'pet-art-photo'}}" class="section">
        <view class="section-title">看看成品风格</view>
        <image class="solo-template-image {{activeTemplate.sampleShape === 'wide' ? 'solo-wide' : ''}}" src="{{activeTemplate.sampleUrl}}" mode="aspectFit" />
      </view>
      <view wx:if="{{templateId === 'pet-art-photo' && sceneOptions.length}}" class="section">
        <view class="section-title">写真场景 · {{sceneOptions.length}} 套</view>
        <view class="scene-grid">
          <view wx:for="{{sceneOptions}}" wx:key="id" class="option template-option scene-option" data-id="{{item.id}}" hover-class="option-hover" bindtap="chooseScene">
            <image wx:if="{{item.url}}" class="style-thumb scene-thumb" src="{{item.url}}" mode="aspectFit" data-id="{{item.id}}" binderror="onSceneImageError" lazy-load />
            <view wx:else class="style-thumb style-thumb-blank">样片暂不可用</view>
            <view class="option-name">{{item.title}}</view>
            <text class="small">{{item.description}}</text>
          </view>
        </view>
      </view>
      <view class="ai-actions"><t-button type="ai" block anim="{{animType}}" disabled="{{!activeTemplate}}" bindtap="continueToPhotos">用当前效果制作</t-button></view>
    </block>

    <!--
      选照片（2026-10 按 prototype.html after-effect）：大图预览 + 效果缩略图条 + 宠物头像 chip + 就地上传的照片行 + 提示 + 固定底栏。
      预览框比例跟素材走：写真场景 3:4、9:16 模板用收窄的 9:16 框，都铺满不留边；横版模板用 16:9 框。
    -->
    <block wx:else>
      <view class="effect-preview effect-preview-{{previewShape}}">
        <image wx:if="{{previewUrl}}" class="effect-preview-image" src="{{previewUrl}}" mode="aspectFill" />
        <view wx:else class="effect-preview-image style-thumb-blank">样片暂不可用</view>
        <text class="ai-mask-inline effect-preview-label">示例效果 · 换成{{petText || '我'}}</text>
      </view>
      <scroll-view wx:if="{{templateId === 'pet-art-photo' && sceneOptions.length > 1}}" class="effect-strip" scroll-x show-scrollbar="{{false}}" scroll-left="{{effectScrollLeft}}" scroll-with-animation>
        <view wx:for="{{sceneOptions}}" wx:key="id" id="effect-{{item.id}}" class="effect-thumb {{sceneId === item.id ? 'effect-thumb-on' : ''}}" data-id="{{item.id}}" aria-role="radio" aria-checked="{{sceneId === item.id}}" aria-label="{{item.title}}" bindtap="chooseScene">
          <image wx:if="{{item.url}}" class="effect-thumb-image effect-thumb-card" src="{{item.url}}" mode="aspectFill" data-id="{{item.id}}" binderror="onSceneImageError" lazy-load />
          <view wx:else class="effect-thumb-image effect-thumb-card style-thumb-blank"></view>
          <text class="effect-thumb-name">{{item.title}}</text>
        </view>
      </scroll-view>
      <scroll-view wx:elif="{{carouselTemplates.length > 1}}" class="effect-strip" scroll-x show-scrollbar="{{false}}" scroll-left="{{effectScrollLeft}}" scroll-with-animation>
        <view wx:for="{{carouselTemplates}}" wx:key="templateId" id="effect-{{item.templateId}}" class="effect-thumb {{templateId === item.templateId ? 'effect-thumb-on' : ''}}" data-id="{{item.templateId}}" aria-role="radio" aria-checked="{{templateId === item.templateId}}" aria-label="{{item.title}}" bindtap="chooseTemplate">
          <image wx:if="{{item.sampleUrl}}" class="effect-thumb-image effect-thumb-{{item.sampleShape === 'wide' ? 'wide' : 'portrait'}}" src="{{item.sampleUrl}}" mode="aspectFill" data-id="{{item.templateId}}" data-src="{{item.sampleUrl}}" binderror="onTemplateImageError" lazy-load />
          <view wx:else class="effect-thumb-image effect-thumb-portrait style-thumb-blank"></view>
          <text class="effect-thumb-name">{{item.title}}</text>
        </view>
      </scroll-view>
      <!-- 写真套餐入口：单张之外，多拍几套更划算 -->
      <view wx:if="{{templateId === 'pet-art-photo' && artPackages.length}}" class="art-pack">
        <view class="art-pack-head"><text class="art-pack-title">多拍几套更划算</text><text class="small">同一张照片，一次出多套写真</text></view>
        <view class="art-pack-row">
          <view wx:for="{{artPackages}}" wx:key="id" class="art-pack-item" data-id="{{item.id}}" aria-role="button" aria-label="{{item.label}} {{item.price}}" hover-class="chip-hover" bindtap="chooseArtPackage">
            <text class="art-pack-name">{{item.label}}</text><text class="art-pack-price">{{item.price}}</text>
          </view>
        </view>
      </view>

      <!-- 宠物用头像 chip 选择；没有宠物时去建档 -->
      <view class="row photo-head"><view class="section-title flush">用谁的照片</view><text wx:if="{{pets.length}}" class="small">选 1 张</text><text wx:else class="small strong" aria-role="button" bindtap="openPets">先建一个档案 ›</text></view>
      <scroll-view wx:if="{{pets.length > 0}}" class="pet-chips chip-scroll" scroll-x show-scrollbar="{{false}}"><view class="chip-track">
        <view wx:for="{{pets}}" wx:key="id" class="pet-chip {{petId === item.id ? 'pet-chip-on' : ''}}" data-index="{{index}}" aria-role="radio" aria-checked="{{petId === item.id}}" bindtap="choosePetChip">
          <image wx:if="{{item.avatarUrl}}" class="pet-chip-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="pet-chip-avatar pet-chip-avatar-empty">{{item.name[0]}}</view>
          <text>{{item.name}}</text>
        </view>
      </view></scroll-view>
      <view class="photo-row">
        <t-skeleton wx:if="{{loading}}" type="grid" count="4"></t-skeleton>
        <!-- 首格「拍照 / 相册」就地上传，传完自动选中，不离开当前流程 -->
        <t-photo-grid wx:elif="{{petId}}" photos="{{photos}}" selected-ids="{{photoIds}}" max="1" addable add-text="拍照 / 相册" add-icon="/assets/icons/{{themeId}}/camera.png" columns="4" previewable="{{false}}" anim="{{animType}}" bindadd="uploadPetPhoto" bindtoggle="togglePhoto"></t-photo-grid>
      </view>
      <view wx:if="{{petId && !loading}}" class="photo-tip"><text class="photo-tip-mark">✓</text><text>正脸、光线清楚、只有{{petText || '我'}}一只，效果最好</text></view>

      <block wx:if="{{activeTemplate && activeTemplate.subjectMode === 'owner-pet'}}">
        <view class="section">
          <view class="section-title">主人照片授权</view>
          <checkbox-group bindchange="toggleAuthorization"><label class="small"><checkbox value="confirmed" checked="{{authorizationConfirmed}}" />照片中的本人已同意用于本次 AI 生图</label></checkbox-group>
        </view>
        <view class="section">
          <view class="row"><view class="section-title flush">主人身份照</view><text class="small">选择 1 张</text></view>
          <t-button type="secondary" block anim="{{animType}}" disabled="{{!authorizationConfirmed || busy}}" class="block-gap" bindtap="uploadOwnerPhoto">上传主人照片</t-button>
          <t-photo-grid wx:if="{{ownerPhotos.length}}" class="block-gap" photos="{{ownerPhotos}}" selected-ids="{{ownerPhotoIds}}" max="1" columns="4" previewable="{{false}}" removable anim="{{animType}}" bindtoggle="toggleOwnerPhoto" bindremove="removeOwnerPhoto"></t-photo-grid>
        </view>
      </block>

      <view class="ai-dock">
        <view class="ai-dock-meta">
          <text class="ai-dock-title">{{activeTemplate && activeTemplate.subjectMode === 'owner-pet' ? '为我和' + (petText || '它') + '拍一张' : '为' + (petText || '我') + '拍一张'}}</text>
          <text class="small">{{activeTemplate && activeTemplate.subjectMode === 'pet-human' ? '不支持重拍 · ' : '免费预览 · '}}满意再保存{{unlockPrice ? ' ¥' + unlockPrice : ''}}</text>
        </view>
        <t-button type="primary" anim="{{animType}}" loading="{{busy}}" disabled="{{!activeTemplate || !photoIds.length || (activeTemplate.subjectMode === 'owner-pet' && (!ownerPhotoIds.length || !authorizationConfirmed))}}" bindtap="create">开始</t-button>
      </view>
    </block>
  </block>
</view>
