/* 访客阅读保留章节节奏，并让原比例照片完整呈现。 */
.page-read {
  padding-right: var(--page-x-wide);
  padding-left: var(--page-x-wide);
}

/* 期数式标识：大字距小字号 */
.share-kicker {
  display: block;
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
  font-weight: var(--fw-bold);
  letter-spacing: var(--ls-cover);
}

.share-title {
  margin: var(--space-4) 0 var(--space-3);
  color: var(--text-primary);
  font-size: var(--font-display);
  font-weight: var(--fw-black);
  letter-spacing: var(--ls-tight);
  line-height: var(--lh-display);
}

/* 副题与标题拉开字重差；300 若在安卓回退到 400，仍有次级色兜底 */
.share-pet {
  display: block;
  color: var(--text-secondary);
  font-size: var(--font-h3);
  font-weight: var(--fw-light);
  letter-spacing: var(--ls-tight);
}

.share-rule {
  height: 2rpx;
  margin-top: var(--space-5);
  background: var(--divider);
}

.photo-flow {
  display: grid;
  margin: var(--gap-section) 0;
  gap: var(--gap-group);
}

.photo-frame {
  overflow: hidden;
  border-radius: var(--radius-image-hero);
  background: var(--skeleton-base);
}

.photo {
  display: block;
  width: 100%;
  border-radius: var(--radius-image-hero);
}

.photo-error {
  padding: var(--space-6) var(--space-4);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

/* 正文行高比常规更松，长文阅读优先 */
.story {
  display: block;
  margin: var(--gap-section) 0;
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: var(--fw-normal);
  line-height: var(--lh-body);
  white-space: pre-wrap;
}

.story-section {
  margin-top: var(--gap-group);
  border-top: 2rpx solid var(--divider);
}

.story-heading {
  margin-top: var(--space-5);
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--fw-bold);
}
