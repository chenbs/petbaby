/**
 * 纪念页情绪降级（需求 5.17-1 / 9.5）：
 * 动效由 themedPage({ mood: "memorial" }) 统一降为 fade、装饰位关闭；
 * 本文件再把光晕与阴影调弱，使四套主题在此页都保持克制。
 * 页面禁止出现促销类视觉（价格红标、倒计时、闪动）。
 */
.page-memorial {
  --ai-glow: var(--divider);
  --card-shadow: 0 6rpx 18rpx var(--divider);
}

.block-gap {
  display: block;
  margin-top: var(--space-4);
}

.bookshelf {
  display: grid;
  margin-top: var(--space-5);
  gap: var(--gap-group);
}

.chapter {
  overflow: hidden;
  border-bottom: 2rpx solid var(--divider);
  padding-bottom: var(--gap-group);
}

.chapter-cover {
  height: 300rpx;
  overflow: hidden;
  border-radius: var(--radius-image-hero);
  background: var(--surface);
}

.chapter-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-image-hero);
}

.chapter-placeholder {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: var(--font-h2);
}

.chapter-body {
  padding-top: var(--space-4);
}

.chapter-meta {
  display: flex;
  justify-content: space-between;
  gap: var(--space-2);
  color: var(--text-secondary);
  font-size: var(--small-size);
}

.chapter-title {
  margin: var(--space-3) 0 var(--space-2);
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--fw-bold);
}

.chapter-excerpt {
  display: block;
  margin-top: var(--space-3);
  color: var(--text-primary);
  font-size: var(--body-size);
  line-height: var(--lh-body);
}

.chapter-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-3);
}

.memorial-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--text-secondary);
  font-size: var(--font-h3);
}

.memorial-tags {
  display: flex;
  margin-top: var(--space-3);
  gap: var(--space-2);
}

.foot {
  display: flex;
  gap: var(--space-3);
}
