.fun-teaser { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 2rpx solid var(--border); border-radius: var(--radius-sm); background: var(--card-background); }
.fun-teaser image { width: 124rpx; height: 124rpx; flex: none; border-radius: var(--radius-xs); }
.fun-teaser > view { min-width: 0; flex: 1; }
.fun-teaser .sub-title { color: var(--text-primary); }
.fun-teaser .small { color: var(--text-secondary); }
.fun-teaser-arrow { color: var(--primary); font-size: var(--font-h2); }

.hero-top,
.pet-identity,
.play-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.hero-theme {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--text-secondary);
  font-size: var(--font-h3);
}

.pet-feature {
  margin-top: var(--space-2);
  transition: opacity var(--dur-fast) var(--ease-out);
}

.pet-feature-hover {
  opacity: .88;
}

.pet-media,
.hero-media,
.grid-media {
  overflow: hidden;
  background: var(--surface);
}

.pet-media {
  aspect-ratio: var(--ratio-cover);
  border-radius: var(--radius-image-hero);
}

.pet-media-empty {
  aspect-ratio: var(--ratio-hero);
}

.example-image,
.intro-preview {
  position: relative;
  overflow: hidden;
  background: var(--surface);
}

.intro-preview {
  aspect-ratio: var(--ratio-hero);
  margin-top: var(--space-3);
  border-radius: var(--radius-image-hero);
}

.intro-image {
  display: block;
  width: 100%;
  height: 100%;
}

.example-label {
  position: absolute;
  right: var(--space-2);
  bottom: var(--space-2);
  left: var(--space-2);
  padding: var(--space-2);
  border-radius: var(--radius-image-thumb);
  background: var(--background);
  color: var(--text-primary);
  font-size: var(--small-size);
  text-align: center;
}

.pet-image,
.hero-image,
.grid-image {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--surface);
}

.pet-image-blank,
.memory-photo-blank {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: var(--space-3);
  color: var(--text-secondary);
  font-size: var(--small-size);
  text-align: center;
}

.pet-caption {
  display: grid;
  gap: var(--space-0);
  padding: var(--space-3) 0;
}

.pet-name {
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--title-size);
  font-weight: var(--fw-bold);
  line-height: var(--lh-h1);
  word-break: break-all;
}

.pet-days,
.pet-hint {
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: var(--lh-sm);
}

.pet-hint {
  flex: none;
}

.empty-intro {
  padding: var(--space-5) 0 var(--space-2);
}

.hero-title {
  max-width: 14em;
  margin-top: var(--space-3);
}

.milestone-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 2rpx solid var(--divider-soft);
}

.stone-main,
.memory-copy {
  display: grid;
  gap: var(--space-0);
  min-width: 0;
}

.memory {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-2) 0;
}

.memory-photo {
  flex: none;
  width: calc(var(--space-8) + var(--space-6));
  height: calc(var(--space-8) + var(--space-6));
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}

.memory-copy {
  flex: 1;
}

.hero-media {
  aspect-ratio: var(--ratio-hero);
  border-radius: var(--radius-image-hero);
}

.play-head {
  align-items: baseline;
  margin-top: var(--space-3);
}

.hero-name {
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--fw-bold);
  line-height: var(--lh-h2);
  word-break: break-all;
}

.play-price {
  flex: none;
  color: var(--primary);
  font-size: var(--small-size);
  font-weight: var(--fw-bold);
}

.hero-tagline {
  display: block;
  margin-top: var(--space-0);
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: var(--lh-sm);
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gap-item);
  margin-top: var(--space-5);
}

.grid-media {
  aspect-ratio: var(--ratio-hero);
  border-radius: var(--radius-image-thumb);
}

.grid-copy {
  display: grid;
  gap: var(--space-0);
  padding: var(--space-2) 0 var(--space-4);
}

.grid-name {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
  line-height: var(--lh-h3);
  word-break: break-all;
}

.grid-price {
  color: var(--text-secondary);
  font-size: var(--small-size);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.card-title {
  margin: var(--space-5) 0 var(--space-2);
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: var(--fw-bold);
}

.card-foot {
  margin-top: var(--space-4);
  color: var(--primary);
  font-size: var(--small-size);
  font-weight: var(--fw-bold);
}

.featured-cards {
  margin-top: var(--space-3);
}

.featured-item {
  min-width: 0;
}

.featured-image {
  display: block;
  width: 100%;
  height: 588rpx;
  aspect-ratio: var(--ratio-portrait);
  border-radius: var(--radius-image-thumb);
  background: var(--surface);
}
.featured-wide { grid-column: span 2; }
.featured-image-wide { height: 420rpx; aspect-ratio: var(--ratio-hero); }

.featured-name {
  padding: var(--space-2) 0 var(--space-3);
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: var(--fw-bold);
}
