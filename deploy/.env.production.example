NODE_ENV=production
APP_PORT=3000
PETBABY_IMAGE=petbaby-platform:2026.07.18-1
# 生产建议使用企业镜像仓库的固定地址；网络受限时不要依赖 Docker Hub。
NODE_BASE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:17-alpine
PNPM_VERSION=10.13.1
NPM_REGISTRY=https://registry.npmjs.org/
POSTGRES_DB=petbaby
POSTGRES_USER=petbaby
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://petbaby:replace-with-a-long-random-password@db:5432/petbaby
SESSION_SECRET=replace-with-at-least-32-random-characters
WORKER_SECRET=replace-with-a-separate-long-random-secret
PUBLIC_APP_URL=https://petbaby.example.com
# 独立官网（apps/website）的域名，供 release-website.sh 构建时注入
# canonical / sitemap / robots 的基准。与 PUBLIC_APP_URL **是两个不同的域名**：
# 主域给官网、应用挪到 app. 子域（方案 1 章）。官网发布与应用完全解耦，
# 这个变量只被 release-website.sh 读取，platform 侧不用它。
WEBSITE_URL=https://petbaby.example.com
ADMIN_USER_IDS=

PAYMENT_PROVIDER=wechat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_CERT_SERIAL=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=https://petbaby.example.com/api/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=https://petbaby.example.com/api/payments/wechat/notify
WECHAT_SUBSCRIBE_TEMPLATE_ID=

OBJECT_STORAGE_PROVIDER=s3
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
STORAGE_REGION=

# lingsuan 图像接口（主通道）。配上后原 AI_IMAGE_ENDPOINT 自动顺延为备用。
# 出网白名单要放两个域名：API 在 lingsuan.top，图片下载在 img.junliai.org
LINGSUAN_IMAGE_BASE_URL=https://lingsuan.top
LINGSUAN_IMAGE_API_KEY=
LINGSUAN_IMAGE_MODEL=gpt-image-2
# 共享请求队列并发数；代码硬限制为 1–20
LINGSUAN_IMAGE_CONCURRENCY=20
LINGSUAN_IMAGE_SIZE=1024x1024
LINGSUAN_IMAGE_QUALITY=high
# 留空：接口接受 input_fidelity（不再 400），但效果未验证，开前先人眼比对
LINGSUAN_IMAGE_INPUT_FIDELITY=
# 单张实测 46–62 秒（low），high 更久
LINGSUAN_IMAGE_TIMEOUT_MS=180000
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
AI_IMAGE_SECONDARY_ENDPOINT=
AI_IMAGE_SECONDARY_API_KEY=
AI_IMAGE_SECONDARY_MODEL=
AI_CIRCUIT_FAILURE_THRESHOLD=3
ADDRESS_ENCRYPTION_KEY=
PHYSICAL_PAYMENT_PROVIDER=
FFMPEG_PATH=/usr/bin/ffmpeg
# 视频字幕字体。缺失时 ffmpeg 不报错，但中文字幕会渲染成方框或整行消失。
FFMPEG_FONT_FILE=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc
WORKER_POLL_INTERVAL_MS=1000
DAILY_GENERATION_LIMIT=500
DAILY_COST_LIMIT=50
LAYOUT_GENERATION_COST=0.01
AI_IMAGE_COST=0.08
ALERT_WEBHOOK_URL=
