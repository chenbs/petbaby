<page-meta page-style="{{themeStyle}}"></page-meta>

<!--
  外观（2026-10 按 themes.html 第 3 节）：每张预览卡渲染该主题下的首页缩略图，
  卡片根节点挂该主题自己的 token 串和 skin 类，所以底色、圆角、切角、标记、按钮形状都是那套主题的真实观感。
-->
<view class="{{skinClass}} page page-flat art-pet layout-matrix">
  <view class="title">选一个宠物空间</view>
  <text class="muted">换了之后所有页面马上生效，随时可以换回来。</text>

  <view class="theme-list">
    <view
      wx:for="{{previews}}"
      wx:key="id"
      class="preview {{item.active ? 'preview-on' : ''}}"
      data-id="{{item.id}}"
      aria-role="radio"
      aria-checked="{{item.active}}"
      aria-label="{{item.name}}"
      hover-class="preview-hover"
      bindtap="choose"
    >
      <!-- 缩略图：同一份迷你首页 DOM，只换主题 -->
      <view class="mini {{item.skin}}" style="{{item.style}}">
        <view class="mini-nav"><image class="mini-paw" src="/assets/icons/{{item.id}}/paw.png" mode="aspectFit" /><text>麻麻抱我</text></view>
        <view class="mini-card">
          <image class="mini-avatar" src="/assets/theme-preview.jpg" mode="aspectFill" />
          <view class="mini-card-main"><text class="mini-name">年糕</text><text class="mini-days"><text class="mini-days-num">128</text> 天</text></view>
          <view class="mini-cam"><image class="mini-cam-icon" src="/assets/icons/{{item.id}}/camera.png" mode="aspectFit" /></view>
        </view>
        <view class="mini-human">
          <view class="mini-human-head"><text class="mini-human-title">麻麻精选</text><text class="mini-go">做同款</text></view>
          <view class="mini-human-row">
            <image wx:for="{{sampleCovers}}" wx:for-item="cover" wx:key="*this" class="mini-human-cover" src="{{cover}}" mode="aspectFill" />
          </view>
        </view>
        <view class="mini-mark"><text class="section-title mini-section">挑一个玩法</text></view>
        <view class="mini-feed">
          <image class="mini-feed-image" src="{{feedCovers[0]}}" mode="aspectFill" />
          <image class="mini-feed-image" src="{{feedCovers[1]}}" mode="aspectFill" />
        </view>
      </view>
      <view class="preview-meta">
        <view class="preview-head"><text class="preview-name">{{item.name}}</text><text wx:if="{{item.active}}" class="preview-use">使用中</text></view>
        <text class="preview-desc">{{item.description}}</text>
      </view>
    </view>
  </view>
</view>
