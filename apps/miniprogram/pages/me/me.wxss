.quota-section {
  margin-top: var(--space-5);
  padding: var(--space-4) 0;
  border-bottom: 2rpx solid var(--divider-soft);
}

.quota {
  display: flex;
  align-items: center;
  gap: var(--space-5);
}

.quota-copy {
  display: grid;
  flex: 1;
  gap: var(--space-1);
}

.quota-foot {
  margin-top: var(--space-4);
}

.entry-list {
  border-top: 2rpx solid var(--divider-soft);
}

.entry {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 2rpx solid var(--divider-soft);
}

.entry-hover {
  opacity: .72;
}

.entry-text {
  display: grid;
  gap: var(--space-1);
  min-width: 0;
}

.entry-name {
  color: var(--text-primary);
  font-size: var(--body-size);
  font-weight: 700;
}

.entry-side {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.entry-arrow {
  color: var(--text-secondary);
  font-size: var(--font-h3);
  line-height: 1;
}

/* ---------- 方案 E 区块：默认宠物置顶 ---------- */

.hero-media {
  overflow: hidden;
  aspect-ratio: var(--ratio-cover);
  border-radius: var(--radius-image-hero);
  background: var(--surface);
}

.hero-media-empty {
  height: var(--space-8);
  aspect-ratio: auto;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--surface);
}

.hero-image-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  color: var(--text-secondary);
  font-size: var(--small-size);
}

.hero-caption {
  display: grid;
  gap: var(--space-0);
  padding: var(--space-3) 0;
}

.hero-days {
  color: var(--text-secondary);
  font-size: var(--small-size);
  line-height: var(--lh-sm);
}

.hero-name {
  color: var(--text-primary);
  font-size: var(--font-h2);
  font-weight: var(--fw-bold);
  line-height: var(--lh-h2);
  word-break: break-all;
}

.hero-stats {
  display: grid;
  padding: var(--space-3) 0;
  grid-template-columns: repeat(3, 1fr);
}

.hero-stat {
  display: grid;
  justify-items: start;
  gap: var(--space-0);
}

.hero-stat-value {
  color: var(--text-primary);
  font-size: var(--font-h3);
  font-weight: var(--fw-bold);
  font-variant-numeric: tabular-nums;
  line-height: var(--lh-h3);
}

.hero-stat-label {
  color: var(--text-secondary);
  font-size: var(--eyebrow-size);
  letter-spacing: var(--eyebrow-tracking);
}
