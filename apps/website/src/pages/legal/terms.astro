---
import LegalLayout from "../../layouts/LegalLayout.astro";

const SECTIONS = [
  {
    "heading": "服务范围与协议适用",
    "paragraphs": [
      "麻麻抱我提供宠物档案、照片记录、图文作品、AI 创意生成、视频与纪念内容等服务。官网用于介绍服务；具体开放的玩法、素材、价格、次数、保存期限及交付规格，以小程序内提交创作或订单前展示的信息为准。示例图不构成对每次生成效果的保证。",
      "请在使用前阅读本协议及隐私政策。涉及付费、人物照片、公开分享等操作时，我们会在相应环节说明规则；不同意某项可选服务，不影响使用不依赖该项信息的功能。未成年人应在监护人知情指导下使用及消费。"
    ]
  },
  {
    "heading": "账号与使用规范",
    "paragraphs": [
      "请使用本人有权使用的微信账号登录，妥善保管设备与账号。发现异常登录或账号被盗时，请通过小程序客服或本页公布的渠道联系处理。不得冒用他人身份、绕过权限或支付校验、恶意刷取额度、攻击服务或侵害他人权益。",
      "对违反法律或使用规则的行为，我们可根据事实限制相关操作、暂停账号或移除内容，并提供申诉途径。停止账号服务不免除依法应履行的退款、数据权利处理等义务。"
    ]
  },
  {
    "heading": "照片授权与内容权利",
    "paragraphs": [
      "你保留上传照片、文字等原始内容依法享有的权利。请确认你有权上传、编辑和使用这些内容；包含他人肖像、尤其是儿童照片时，应事先取得本人或其监护人的适当授权。不得上传违法内容或利用生成内容冒充真实人物、捏造事实、骚扰他人。",
      "你授权我们在提供你选择的存储、排版、生成、导出及分享服务所必需的范围内处理内容，并按隐私政策委托相应服务商处理。此授权不等于将私人照片授权用于公开广告或模型训练；新增用途需要另行说明并取得相应授权。",
      "生成内容的可保护性及权利归属由适用法律和具体创作贡献决定，我们不保证其必然享有独占著作权或不与他人作品相似。商业使用前请核对肖像、商标及其他第三方权利。请保留依法及平台规则要求的 AI 生成标识。"
    ]
  },
  {
    "heading": "创作、交付与健康信息",
    "paragraphs": [
      "生成时间受队列、网络、素材质量和服务商处理情况影响。AI 结果可能出现特征偏差、文字错误或不符合预期的细节；请先查看预览及候选。可重试次数、额度扣减和高清导出权益以所选服务页面为准，失败任务按照页面显示的规则处理。",
      "健康记录、体重趋势、问题分流及健康档案仅辅助记录和就医沟通，不提供兽医诊断、处方或急救服务。动物出现紧急症状时应及时联系正规宠物医疗机构；不得仅依赖自动生成的信息决定治疗或停药。",
      "下载文件后请自行备份。照片、未解锁预览与生成内容的保留安排不同，删除账号或到期清理可能影响再次下载；有效期以相关服务页面说明为准。"
    ]
  },
  {
    "heading": "价格、支付、会员与退款",
    "paragraphs": [
      "下单前会展示商品内容、应付金额、权益或有效期。虚拟权益通过微信小程序支持的虚拟支付能力购买，实体商品通过普通支付购买；支持的系统与版本以实际入口提示为准。支付成功以渠道确认且订单状态更新为准，客户端返回成功不单独构成到账凭证。",
      "会员不是对所有服务无限使用的承诺；额度、次数与有效期以购买页为准。不得通过转卖账号或技术手段转移专属权益。未有明确续费授权和提示时，不以本协议推定你同意自动续费。",
      "出现重复扣款、已扣款未到账、交付失败或其他消费争议时，可在订单中或通过客服申请核查与退款。是否适用无理由退款、已使用部分的处理等，依法律规定、订单规则及支付渠道政策判断，不以统一的“不退不换”排除法定权利。退款申请受理不等于资金已到账；渠道确认退款后，关联的未消费权益、作品解锁或会员资格可能相应收回。",
      "实体定制商品的材质、规格、运费、制作周期与售后规则在下单时说明。因质量问题或未按约定履行产生的责任依法承担；退换及定制例外须在购买前明确告知。"
    ]
  },
  {
    "heading": "分享、删除与隐私",
    "paragraphs": [
      "照片和作品默认在需要登录授权的范围内使用。由你主动创建的分享链接可能被接收者转发或保存；请在分享前检查照片、姓名及其他个人信息。你可以撤销分享，但无法据此删除他人已经保存的副本。",
      "个人信息处理的类型、目的、保留、服务商及权利行使方式见隐私政策。你可以管理支持删除的照片与档案、撤销分享及申请注销；订单、争议与安全记录中依法必须保留的内容不随一般删除操作立即消失。"
    ]
  },
  {
    "heading": "服务变更、责任与争议处理",
    "paragraphs": [
      "我们会合理维护服务。计划性维护或影响已购服务的重要变更将通过适当方式说明；对于尚未履行的付费订单，依法提供继续履行、替代安排或退款。因不可抗力、网络或第三方故障导致中断时，我们会采取合理补救措施，不因此免除依法不得免除的责任。",
      "发生争议时，可提供订单编号、发生时间和必要说明，通过客服或本页渠道协商。不要发送支付密码或无关敏感信息。协商不成的，依法向有管辖权的人民法院或有关主管机构寻求救济；本协议不限制消费者法定权利。",
      "协议发生实质变化时，我们会公布新版本并提示重大变化；依法需要重新取得同意的，会另行征得同意。旧订单的履行及已产生权利不因静默更新被不合理减损。"
    ]
  }
];
---

<LegalLayout title="用户协议" description="麻麻抱我的用户协议，包含服务规则、数据处理和用户权利说明。" sections={SECTIONS} />
