---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { breadcrumbLd } from "../lib/jsonld";
import { LEGAL_ADDRESS, LEGAL_APPROVED, LEGAL_CONTACT, LEGAL_OPERATOR } from "../config/site";

interface Props {
  title: string;
  description: string;
  sections: ReadonlyArray<{ heading: string; paragraphs: ReadonlyArray<string> }>;
}
const { title, description, sections } = Astro.props;
const crumbs = [{ label: "首页", href: "/" }, { label: title }];
const finalized = LEGAL_APPROVED && LEGAL_OPERATOR && LEGAL_CONTACT && LEGAL_ADDRESS;
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbLd(crumbs)]} noindex={!finalized}>
  <section class="section">
    <div class="container">
      <div class="page-head">
        <Breadcrumb items={crumbs} />
        <h1 class="h2 h2-sm">{title}{!finalized && "（待运营主体确认）"}</h1>
      </div>
      <div class="legal-content">
        {!finalized && <div class="notice-draft" role="note"><p><strong>本页尚未正式生效。</strong>正文根据当前服务拟定，运营主体、联系方式和法律审核确认后发布生效版本；目前网站仅供预览。</p></div>}
        <p>版本日期：2026 年 9 月 21 日</p>
        {LEGAL_OPERATOR && <p>运营主体：{LEGAL_OPERATOR}</p>}
        {LEGAL_ADDRESS && <p>联系地址：{LEGAL_ADDRESS}</p>}
        {LEGAL_CONTACT && <p>联系及个人信息保护渠道：{LEGAL_CONTACT}</p>}
        <div class="legal-outline">
          {sections.map((section, index) => (
            <section class="legal-section">
              <h2>{index + 1}. {section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
