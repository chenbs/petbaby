@import "../shared.wxss";

.field {
  display: grid;
  gap: var(--space-2);
}

.field-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
}

.field-label {
  color: var(--text-primary);
  font-size: var(--small-size);
  font-weight: var(--fw-bold);
}

.field-star {
  color: var(--error);
}

.control {
  box-sizing: border-box;
  min-height: 96rpx;
  padding: var(--space-3) var(--space-4);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text-primary);
  font-size: var(--body-size);
  transition: border-color var(--transition-duration) var(--transition-easing), box-shadow var(--transition-duration) var(--transition-easing);
}

.control-input {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.control-inner {
  flex: 1;
  min-height: 56rpx;
  color: var(--text-primary);
  font-size: var(--body-size);
}

.control-reveal {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: var(--small-size);
}

.control-area {
  width: 100%;
  min-height: 200rpx;
  line-height: 1.6;
}

.control-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.control-text {
  color: var(--text-primary);
}

.control-hint {
  color: var(--text-secondary);
}

.control-arrow {
  color: var(--text-secondary);
  font-size: var(--font-h3);
  line-height: 1;
}

.control-slot {
  padding: var(--space-2);
}

/* 聚焦高亮：与 --primary 一致（需求 5.16.4） */
.field-focus .control {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx var(--ai-glow);
}

.field-invalid .control {
  border-color: var(--error);
}

.field-error {
  color: var(--error);
  font-size: var(--small-size);
  line-height: 1.6;
}
